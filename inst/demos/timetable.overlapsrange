%!demo
%! ## `overlapsrange` asks whether a timetable and a range of times share any
%! ## instant at all.  Meeting at a single one is enough, so a range that
%! ## starts exactly at the last row time still overlaps.
%!
%! t0 = datetime (2024, 1, 1);
%! Flow = [3.1; 3.4; 4.0; 3.8; 3.2; 2.9];
%! TT = timetable (Flow, 'RowTimes', t0 + hours (0:5)')
%! overlapsrange (TT, timerange (t0 + hours (5), t0 + hours (9)))
%!
%! ## Move the range one hour later and nothing is shared.
%! overlapsrange (TT, timerange (t0 + hours (6), t0 + hours (9)))

%!demo
%! ## Overlap is of the ranges, not of the rows, so a timetable can overlap a
%! ## range without a single row falling in it.  The two outputs disagree here
%! ## and both are right.
%!
%! t0 = datetime (2024, 1, 1);
%! TT = timetable ([3.1; 4.0; 2.9], 'RowTimes', t0 + hours ([0 3 6])', ...
%!                 'VariableNames', {'Flow'});
%! [tf, whichRows] = overlapsrange (TT, timerange (t0 + hours (1), ...
%!                                                 t0 + hours (2)))
