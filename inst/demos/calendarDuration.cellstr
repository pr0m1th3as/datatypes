%!demo
%! ## `cellstr` converts the array into a cell array of its display strings.
%!
%! d = calmonths ([1, 13, 25])
%! cellstr (d)

%!demo
%! ## A second argument renders the array in another format for this call only,
%! ## leaving the array's own `'Format'` untouched.  Unlike the constructor, it
%! ## is given on its own and not as a `'Format'` name-value pair.
%!
%! d = calmonths ([1, 13, 25])
%! cellstr (d, 'mdt')
%! cellstr (d, 'yqmwdt')
