%!demo
%! ## `datevec` returns the span as a numeric row `[Y MO D H MI S]` per element,
%! ## handy for feeding the raw components into other calculations.
%!
%! d = calendarDuration (1, 2, 3, 4, 5, 6)
%! datevec (d)

%!demo
%! ## An element that is not finite has no components to divide between, so all
%! ## six take that same infinity — the same answer `split` gives for it.
%!
%! d = calendarDuration ([1, Inf, NaN], 2, 3)
%! datevec (d)
