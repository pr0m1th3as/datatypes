%!demo
%! ## `resample` evaluates a series at new times.  Outside the series the
%! ## data is `NaN`, and each new time takes the quality code of the nearest
%! ## sample.
%!
%! ts = timeseries ([0; 10; 20], [0; 1; 2], [1; 2; 3]);
%! s = resample (ts, [0.5, 1.5, 3]);
%! [s.Time, s.Data, s.Quality]

%!demo
%! ## A method given here overrides the series' own for this call, and a
%! ## code, listed in `QualityInfo.Code`, marks the times the series did
%! ## not hold.
%!
%! ts = timeseries ([0; 10; 20], [0; 1; 2], [1; 1; 1]);
%! ts.QualityInfo.Code = [1, 9];
%! ts.QualityInfo.Description = {'measured', 'filled'};
%! s = resample (ts, 0:0.5:2, 'zoh', 9);
%! [s.Time, s.Data, s.Quality]
