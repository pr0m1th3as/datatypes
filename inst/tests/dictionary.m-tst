## Conversion to a key of type 'double', measured on R2024a
%!test
%! d = configureDictionary ('double', 'double');
%! d(5) = 1;
%! assert_equal (keys (d, 'cell'), {5});
%!test
%! d = configureDictionary ('double', 'double');
%! d(int8 (5)) = 1;
%! assert_equal (keys (d, 'cell'), {5});
%!test
%! d = configureDictionary ('double', 'double');
%! d(true) = 1;
%! assert_equal (keys (d, 'cell'), {1});
%!test
%! d = configureDictionary ('double', 'double');
%! d('x') = 1;
%! assert_equal (keys (d, 'cell'), {120});
%!test
%! d = configureDictionary ('double', 'double');
%! d('5') = 1;
%! assert_equal (keys (d, 'cell'), {53});
%!test
%! d = configureDictionary ('double', 'double');
%! d(string ('x')) = 1;
%! assert_equal (keys (d, 'cell'), {NaN});
%!test
%! d = configureDictionary ('double', 'double');
%! d(string ('5')) = 1;
%! assert_equal (keys (d, 'cell'), {5});
%!error<dictionary.subsasgn: unable to use 'cell' as key of a dictionary of 'double' keys.> ...
%! d = configureDictionary ('double', 'double');
%! d({'x'}) = 1;
%!error<dictionary.subsasgn: unable to use 'cell' as key of a dictionary of 'double' keys.> ...
%! d = configureDictionary ('double', 'double');
%! d({5}) = 1;
%!test
%! d = configureDictionary ('double', 'double');
%! d(categorical ({'x'})) = 1;
%! assert_equal (keys (d, 'cell'), {1});
%!error<dictionary.subsasgn: unable to use 'datetime' as key of a dictionary of 'double' keys.> ...
%! d = configureDictionary ('double', 'double');
%! d(datetime (2024, 1, 1)) = 1;
%!error<dictionary.subsasgn: unable to use 'duration' as key of a dictionary of 'double' keys.> ...
%! d = configureDictionary ('double', 'double');
%! d(hours (1)) = 1;
%!error<dictionary.subsasgn: unable to use 'calendarDuration' as key of a dictionary of 'double' keys.> ...
%! d = configureDictionary ('double', 'double');
%! d(calmonths (1)) = 1;
%!test
%! d = configureDictionary ('double', 'double');
%! d(missing) = 1;
%! assert_equal (keys (d, 'cell'), {NaN});
%!error<dictionary.subsasgn: unable to use 'struct' as key of a dictionary of 'double' keys.> ...
%! d = configureDictionary ('double', 'double');
%! d(struct ('a', 1)) = 1;
%!error<dictionary.subsasgn: unable to use 'table' as key of a dictionary of 'double' keys.> ...
%! d = configureDictionary ('double', 'double');
%! d(table (1)) = 1;
%!error<dictionary.subsasgn: unable to use 'function_handle' as key of a dictionary of 'double' keys.> ...
%! d = configureDictionary ('double', 'double');
%! d(@sin) = 1;

