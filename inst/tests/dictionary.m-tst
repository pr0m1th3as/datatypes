%! assert_equal (size (tb1.Key), [3, 1]);
%! assert_equal (cellstr (tb1.Key), {'a'; 'b'; 'c'});
%! assert_equal (categories (tb1.Key), {'a'; 'b'; 'c'});
%! assert_equal (isordinal (tb1.Key), false);
%! assert_equal (tb1.Value, [10; 20; 30]);
%!assert_equal (isequal (D, R), true)
%!assert_equal (isequaln (D, R), true)
%!assert_equal (keyHash (D) == keyHash (R), false)
%!assert_equal (keyHash (D) == keyHash (D), true)
%!assert_equal (keyMatch (D, R), false)
%!assert_equal (CV{categorical ({'b'})}, 'two')
%!test
%! c = CV;
%! c{categorical ({'a'})} = 5;
%! assert_equal (c(categorical ({'a'})), {5});
%!test
%! c = CV;
%! c{categorical ({'b'})}(2) = 7;
%! r = c{categorical ({'b'})};
%! assert_equal (double (r), [116, 7, 111]);
%!error<dictionary.subsref: key not found.> ...
%! CV{categorical ({'z'})};

## Keys of type 'ordinal', measured on R2024a
%!shared D, R, CV
%! D = dictionary (categorical ({'lo'}, {'lo', 'mid', 'hi'}, 'Ordinal', ...
%!                              true), 10);
%! D(categorical ({'mid'}, {'lo', 'mid', 'hi'}, 'Ordinal', true)) = 20;
%! D(categorical ({'hi'}, {'lo', 'mid', 'hi'}, 'Ordinal', true)) = 30;
%! R = dictionary (categorical ({'hi'}, {'lo', 'mid', 'hi'}, 'Ordinal', ...
%!                              true), 30);
%! R(categorical ({'mid'}, {'lo', 'mid', 'hi'}, 'Ordinal', true)) = 20;
%! R(categorical ({'lo'}, {'lo', 'mid', 'hi'}, 'Ordinal', true)) = 10;
%! CV = dictionary (categorical ({'lo'}, {'lo', 'mid', 'hi'}, 'Ordinal', ...
%!                               true), {1});
%! CV(categorical ({'mid'}, {'lo', 'mid', 'hi'}, 'Ordinal', true)) = {'two'};
%! CV(categorical ({'hi'}, {'lo', 'mid', 'hi'}, 'Ordinal', true)) = {[3, 4]};
%!test
%! r = keys (D);
%! assert_equal (class (r), 'categorical');
%! assert_equal (size (r), [3, 1]);
%! assert_equal (cellstr (r), {'lo'; 'mid'; 'hi'});
%! assert_equal (categories (r), {'lo'; 'mid'; 'hi'});
%! assert_equal (isordinal (r), true);
%!assert_equal (values (D), [10; 20; 30])
%!test
%! r = keys (D, 'cell');
%! assert_equal (size (r), [3, 1]);
%! assert_equal (class (r{1}), 'categorical');
%! assert_equal (size (r{1}), [1, 1]);
%! assert_equal (cellstr (r{1}), {'lo'});
%! assert_equal (categories (r{1}), {'lo'; 'mid'; 'hi'});
%! assert_equal (isordinal (r{1}), true);
%! assert_equal (class (r{2}), 'categorical');
%! assert_equal (size (r{2}), [1, 1]);
%! assert_equal (cellstr (r{2}), {'mid'});
%! assert_equal (categories (r{2}), {'lo'; 'mid'; 'hi'});
%! assert_equal (isordinal (r{2}), true);
%! assert_equal (class (r{3}), 'categorical');
%! assert_equal (size (r{3}), [1, 1]);
%! assert_equal (cellstr (r{3}), {'hi'});
%! assert_equal (categories (r{3}), {'lo'; 'mid'; 'hi'});
%! assert_equal (isordinal (r{3}), true);
%!assert_equal (numEntries (D), 3)
%!test
%! r = D(categorical ({'mid'}, {'lo', 'mid', 'hi'}, 'Ordinal', true));
%! assert_equal (r, 20);
%!test
%! r = isKey (D, categorical ({'lo'}, {'lo', 'mid', 'hi'}, 'Ordinal', true));
%! assert_equal (r, true);
%!test
%! r = lookup (D, categorical ({'mid'}, {'lo', 'mid', 'hi'}, 'Ordinal', true));
%! assert_equal (r, 20);
%!test
%! d = D;
%! d(categorical ({'lo'}, {'lo', 'mid', 'hi'}, 'Ordinal', true)) = 99;
%! assert_equal (values (d), [99; 20; 30]);
%!test
%! d = D;
%! d = insert (d, ...
%!             categorical ({'lo'}, {'lo', 'mid', 'hi'}, 'Ordinal', true), 99);
%! assert_equal (values (d), [99; 20; 30]);
%!test
%! d = D;
%! d = insert (d, ...
%!             categorical ({'lo'}, {'lo', 'mid', 'hi'}, 'Ordinal', ...
%!                          true), 99, 'Overwrite', false);
%! assert_equal (values (d), [10; 20; 30]);
%!test
%! d = D;
%! d = remove (d, categorical ({'lo'}, {'lo', 'mid', 'hi'}, 'Ordinal', true));
%! r = keys (d, 'cell');
%! assert_equal (size (r), [2, 1]);
%! assert_equal (class (r{1}), 'categorical');
%! assert_equal (size (r{1}), [1, 1]);
%! assert_equal (cellstr (r{1}), {'mid'});
%! assert_equal (categories (r{1}), {'lo'; 'mid'; 'hi'});
%! assert_equal (isordinal (r{1}), true);
%! assert_equal (class (r{2}), 'categorical');
%! assert_equal (size (r{2}), [1, 1]);
%! assert_equal (cellstr (r{2}), {'hi'});
%! assert_equal (categories (r{2}), {'lo'; 'mid'; 'hi'});
%! assert_equal (isordinal (r{2}), true);
%!test
%! d = D;
%! d(categorical ({'lo'}, {'lo', 'mid', 'hi'}, 'Ordinal', true)) = [];
%! assert_equal (values (d), [20; 30]);
%!test
%! d = D;
%! d = remove (d, categorical ({'lo'}, {'lo', 'mid', 'hi'}, 'Ordinal', true));
%! d(categorical ({'lo'}, {'lo', 'mid', 'hi'}, 'Ordinal', true)) = 11;
%! assert_equal (values (d), [20; 30; 11]);
%!test
%! r = entries (D, 'struct');
%! assert_equal (size (r), [3, 1]);
%! assert_equal (fieldnames (r), {'Key'; 'Value'});
%! assert_equal (class (r(1).Key), 'categorical');
%! assert_equal (size (r(1).Key), [1, 1]);
%! assert_equal (cellstr (r(1).Key), {'lo'});
%! assert_equal (categories (r(1).Key), {'lo'; 'mid'; 'hi'});
%! assert_equal (isordinal (r(1).Key), true);
%! assert_equal (r(1).Value, 10);
%! assert_equal (class (r(2).Key), 'categorical');
%! assert_equal (size (r(2).Key), [1, 1]);
%! assert_equal (cellstr (r(2).Key), {'mid'});
%! assert_equal (categories (r(2).Key), {'lo'; 'mid'; 'hi'});
%! assert_equal (isordinal (r(2).Key), true);
%! assert_equal (r(2).Value, 20);
%! assert_equal (class (r(3).Key), 'categorical');
%! assert_equal (size (r(3).Key), [1, 1]);
%! assert_equal (cellstr (r(3).Key), {'hi'});
%! assert_equal (categories (r(3).Key), {'lo'; 'mid'; 'hi'});
%! assert_equal (isordinal (r(3).Key), true);
%! assert_equal (r(3).Value, 30);
%!test
%! r = entries (D, 'cell');
%! assert_equal (size (r), [3, 2]);
%! assert_equal (class (r{1}), 'categorical');
%! assert_equal (size (r{1}), [1, 1]);
%! assert_equal (cellstr (r{1}), {'lo'});
%! assert_equal (categories (r{1}), {'lo'; 'mid'; 'hi'});
%! assert_equal (isordinal (r{1}), true);
%! assert_equal (class (r{2}), 'categorical');
%! assert_equal (size (r{2}), [1, 1]);
%! assert_equal (cellstr (r{2}), {'mid'});
%! assert_equal (categories (r{2}), {'lo'; 'mid'; 'hi'});
%! assert_equal (isordinal (r{2}), true);
%! assert_equal (class (r{3}), 'categorical');
%! assert_equal (size (r{3}), [1, 1]);
%! assert_equal (cellstr (r{3}), {'hi'});
%! assert_equal (categories (r{3}), {'lo'; 'mid'; 'hi'});
%! assert_equal (isordinal (r{3}), true);
%! assert_equal (r{4}, 10);
%! assert_equal (r{5}, 20);
%! assert_equal (r{6}, 30);
%!test
%! r = entries (D);
%! tb1 = r;
%! assert_equal (size (tb1), [3, 2]);
%! assert_equal (tb1.Properties.VariableNames, {'Key', 'Value'});
%! assert_equal (class (tb1.Key), 'categorical');
%! assert_equal (size (tb1.Key), [3, 1]);
%! assert_equal (cellstr (tb1.Key), {'lo'; 'mid'; 'hi'});
%! assert_equal (categories (tb1.Key), {'lo'; 'mid'; 'hi'});
%! assert_equal (isordinal (tb1.Key), true);
%! assert_equal (tb1.Value, [10; 20; 30]);
%!assert_equal (isequal (D, R), true)
%!assert_equal (isequaln (D, R), true)
%!assert_equal (keyHash (D) == keyHash (R), false)
%!assert_equal (keyHash (D) == keyHash (D), true)
%!assert_equal (keyMatch (D, R), false)
%!test
%! r = CV{categorical ({'mid'}, {'lo', 'mid', 'hi'}, 'Ordinal', true)};
%! assert_equal (r, 'two');
%!test
%! c = CV;
%! c{categorical ({'lo'}, {'lo', 'mid', 'hi'}, 'Ordinal', true)} = 5;
%! r = c(categorical ({'lo'}, {'lo', 'mid', 'hi'}, 'Ordinal', true));
%! assert_equal (r, {5});
%!test
%! c = CV;
%! c{categorical ({'mid'}, {'lo', 'mid', 'hi'}, 'Ordinal', true)}(2) = 7;
%! r = c{categorical ({'mid'}, {'lo', 'mid', 'hi'}, 'Ordinal', true)};
%! assert_equal (double (r), [116, 7, 111]);

## Keys of type 'dictionary', measured on R2024a
%!shared D, R, CV
%! D = dictionary (dictionary (1, 2), 10);
%! D(dictionary (3, 4)) = 20;
%! D(dictionary (5, 6)) = 30;
%! R = dictionary (dictionary (5, 6), 30);
%! R(dictionary (3, 4)) = 20;
%! R(dictionary (1, 2)) = 10;
%! CV = dictionary (dictionary (1, 2), {1});
%! CV(dictionary (3, 4)) = {'two'};
%! CV(dictionary (5, 6)) = {[3, 4]};
%!error<dictionary.keys: cannot join keys of type 'dictionary'; use the 'cell' format.> ...
%! keys (D);
%!assert_equal (values (D), [10; 20; 30])
%!test
%! r = keys (D, 'cell');
%! assert_equal (size (r), [3, 1]);
%! dc1 = r{1};
%! [kt2, vt3] = types (dc1);
%! assert_equal ([kt2, vt3], string ({'double', 'double'}));
%! assert_equal (numEntries (dc1), 1);
%! assert_equal (keys (dc1, 'cell'), {1});
%! assert_equal (values (dc1, 'cell'), {2});
%! dc6 = r{2};
%! [kt7, vt8] = types (dc6);
%! assert_equal ([kt7, vt8], string ({'double', 'double'}));
%! assert_equal (numEntries (dc6), 1);
%! assert_equal (keys (dc6, 'cell'), {3});
%! assert_equal (values (dc6, 'cell'), {4});
%! dc11 = r{3};
%! [kt12, vt13] = types (dc11);
%! assert_equal ([kt12, vt13], string ({'double', 'double'}));
%! assert_equal (numEntries (dc11), 1);
%! assert_equal (keys (dc11, 'cell'), {5});
%! assert_equal (values (dc11, 'cell'), {6});
%!assert_equal (numEntries (D), 3)
%!assert_equal (D(dictionary (3, 4)), 20)
%!assert_equal (isKey (D, dictionary (1, 2)), true)
%!assert_equal (lookup (D, dictionary (3, 4)), 20)
%!assert_equal (isKey (D, dictionary (9, 9)), false)
%!assert_equal (lookup (D, dictionary (9, 9), 'FallbackValue', 0), 0)
%!error<dictionary.subsref: key not found.> ...
%! D(dictionary (9, 9));
%!test
%! d = D;
%! d(dictionary (9, 9)) = [];
%! assert_equal (numEntries (d), 3);
%!test
%! d = D;
%! d = remove (d, dictionary (9, 9));
%! assert_equal (numEntries (d), 3);
%!test
%! d = D;
%! d(dictionary (7, 8)) = 40;
%! r = keys (d, 'cell');
%! assert_equal (size (r), [4, 1]);
%! dc1 = r{1};
%! [kt2, vt3] = types (dc1);
%! assert_equal ([kt2, vt3], string ({'double', 'double'}));
%! assert_equal (numEntries (dc1), 1);
%! assert_equal (keys (dc1, 'cell'), {1});
%! assert_equal (values (dc1, 'cell'), {2});
%! dc6 = r{2};
%! [kt7, vt8] = types (dc6);
%! assert_equal ([kt7, vt8], string ({'double', 'double'}));
%! assert_equal (numEntries (dc6), 1);
%! assert_equal (keys (dc6, 'cell'), {3});
%! assert_equal (values (dc6, 'cell'), {4});
%! dc11 = r{3};
%! [kt12, vt13] = types (dc11);
%! assert_equal ([kt12, vt13], string ({'double', 'double'}));
%! assert_equal (numEntries (dc11), 1);
%! assert_equal (keys (dc11, 'cell'), {5});
%! assert_equal (values (dc11, 'cell'), {6});
%! dc16 = r{4};
%! [kt17, vt18] = types (dc16);
%! assert_equal ([kt17, vt18], string ({'double', 'double'}));
%! assert_equal (numEntries (dc16), 1);
%! assert_equal (keys (dc16, 'cell'), {7});
%! assert_equal (values (dc16, 'cell'), {8});
%!test
%! d = D;
%! d = insert (d, dictionary (7, 8), 40);
%! assert_equal (values (d), [10; 20; 30; 40]);
%!test
%! d = D;
%! d(dictionary (1, 2)) = 99;
%! assert_equal (values (d), [99; 20; 30]);
%!test
%! d = D;
%! d = insert (d, dictionary (1, 2), 99);
%! assert_equal (values (d), [99; 20; 30]);
%!test
%! d = D;
%! d = insert (d, dictionary (1, 2), 99, 'Overwrite', false);
%! assert_equal (values (d), [10; 20; 30]);
%!test
%! d = D;
%! d = remove (d, dictionary (1, 2));
%! r = keys (d, 'cell');
%! assert_equal (size (r), [2, 1]);
%! dc1 = r{1};
%! [kt2, vt3] = types (dc1);
%! assert_equal ([kt2, vt3], string ({'double', 'double'}));
%! assert_equal (numEntries (dc1), 1);
%! assert_equal (keys (dc1, 'cell'), {3});
%! assert_equal (values (dc1, 'cell'), {4});
%! dc6 = r{2};
%! [kt7, vt8] = types (dc6);
%! assert_equal ([kt7, vt8], string ({'double', 'double'}));
%! assert_equal (numEntries (dc6), 1);
%! assert_equal (keys (dc6, 'cell'), {5});
%! assert_equal (values (dc6, 'cell'), {6});
%!test
%! d = D;
%! d(dictionary (1, 2)) = [];
%! assert_equal (values (d), [20; 30]);
%!test
%! d = D;
%! d = remove (d, dictionary (1, 2));
%! d(dictionary (1, 2)) = 11;
%! assert_equal (values (d), [20; 30; 11]);
%!test
%! r = entries (D, 'struct');
%! assert_equal (size (r), [3, 1]);
%! assert_equal (fieldnames (r), {'Key'; 'Value'});
%! dc1 = r(1).Key;
%! [kt2, vt3] = types (dc1);
%! assert_equal ([kt2, vt3], string ({'double', 'double'}));
%! assert_equal (numEntries (dc1), 1);
%! assert_equal (keys (dc1, 'cell'), {1});
%! assert_equal (values (dc1, 'cell'), {2});
%! assert_equal (r(1).Value, 10);
%! dc6 = r(2).Key;
%! [kt7, vt8] = types (dc6);
%! assert_equal ([kt7, vt8], string ({'double', 'double'}));
%! assert_equal (numEntries (dc6), 1);
%! assert_equal (keys (dc6, 'cell'), {3});
%! assert_equal (values (dc6, 'cell'), {4});
%! assert_equal (r(2).Value, 20);
%! dc11 = r(3).Key;
%! [kt12, vt13] = types (dc11);
%! assert_equal ([kt12, vt13], string ({'double', 'double'}));
%! assert_equal (numEntries (dc11), 1);
%! assert_equal (keys (dc11, 'cell'), {5});
%! assert_equal (values (dc11, 'cell'), {6});
%! assert_equal (r(3).Value, 30);
%!test
%! r = entries (D, 'cell');
%! assert_equal (size (r), [3, 2]);
%! dc1 = r{1};
%! [kt2, vt3] = types (dc1);
%! assert_equal ([kt2, vt3], string ({'double', 'double'}));
%! assert_equal (numEntries (dc1), 1);
%! assert_equal (keys (dc1, 'cell'), {1});
%! assert_equal (values (dc1, 'cell'), {2});
%! dc6 = r{2};
%! [kt7, vt8] = types (dc6);
%! assert_equal ([kt7, vt8], string ({'double', 'double'}));
%! assert_equal (numEntries (dc6), 1);
%! assert_equal (keys (dc6, 'cell'), {3});
%! assert_equal (values (dc6, 'cell'), {4});
%! dc11 = r{3};
%! [kt12, vt13] = types (dc11);
%! assert_equal ([kt12, vt13], string ({'double', 'double'}));
%! assert_equal (numEntries (dc11), 1);
%! assert_equal (keys (dc11, 'cell'), {5});
%! assert_equal (values (dc11, 'cell'), {6});
%! assert_equal (r{4}, 10);
%! assert_equal (r{5}, 20);
%! assert_equal (r{6}, 30);
%!error<dictionary.entries: a table cannot hold these entries; use the 'cell' or 'struct' format.> ...
%! entries (D);
%!assert_equal (isequal (D, R), true)
%!assert_equal (isequaln (D, R), true)
%!assert_equal (keyHash (D) == keyHash (R), false)
%!assert_equal (keyHash (D) == keyHash (D), true)
%!assert_equal (keyMatch (D, R), false)
%!assert_equal (CV{dictionary (3, 4)}, 'two')
%!test
%! c = CV;
%! c{dictionary (1, 2)} = 5;
%! assert_equal (c(dictionary (1, 2)), {5});
