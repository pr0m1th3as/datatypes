%! t(string ({'e', 'h'})) = [80, 81];
%! t = insert (t, string ('d'), 85);
%! t = insert (t, string ('d'), 25, 'Overwrite', false);
%! t(string ('e')) = 84;
%! t = insert (t, string ('c'), 87);
%! t(string ('f')) = 53;
%! t(string ({'e', 'b'})) = [53, 54];
%! t(string ('e')) = 15;
%! t(string ({'h', 'c'})) = [70, 71];
%! t(string ('g')) = 78;
%! t(string ('b')) = 8;
%! t(string ('h')) = 29;
%! t = insert (t, string ('a'), 28);
%! t = insert (t, string ('e'), 18);
%! t(string ('a')) = 73;
%! t(string ('d')) = [];
%! t(string ('f')) = 99;
%! t(string ({'c', 'b'})) = [10, 11];
%! t = insert (t, string ('g'), 45, 'Overwrite', false);
%! t(string ({'g', 'f'})) = [10, 11];
%! t(string ({'d', 'g'})) = [63, 64];
%! t = insert (t, string ('h'), 11, 'Overwrite', false);
%! t(string ('a')) = 28;
%! t(string ('a')) = 65;
%! t(string ('f')) = 2;
%! t(string ('c')) = 75;
%! t = insert (t, string ('d'), 51, 'Overwrite', false);
%! t(string ('c')) = 90;
%! t = insert (t, string ('e'), 67);
%! t(string ({'b', 'f'})) = [58, 59];
%! assert_equal (values (t), [90; 58; 64; 67; 29; 59; 65; 63]);
