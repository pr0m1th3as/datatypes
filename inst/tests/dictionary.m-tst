%! d = configureDictionary ('double', 'table');
%! d(1) = datetime (2024, 1, 1);
%! r = values (d, 'cell');
%! assert_equal (size (r), [1, 1]);
%! tb1 = r{1};
%! assert_equal (size (tb1), [1, 1]);
%! assert_equal (tb1.Properties.VariableNames, {'Var1'});
%! x2 = tb1.Var1;
%! x2.Format = 'yyyy-MM-dd HH:mm:ss.SSS';
%! assert_equal (cellstr (x2), {'2024-01-01 00:00:00.000'});
%! assert_equal (x2.TimeZone, '');
