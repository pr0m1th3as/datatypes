%! assert_equal (size (r), [1, 1]);
%! assert_equal (class (r{1}), 'categorical');
%! assert_equal (size (r{1}), [1, 1]);
%! assert_equal (cellstr (r{1}), {'x'});
%! assert_equal (categories (r{1}), {'x'});
%! assert_equal (isordinal (r{1}), false);
%!test
%! d = configureDictionary ('double', 'categorical');
%! d(1) = string ('5');
%! r = values (d, 'cell');
%! assert_equal (size (r), [1, 1]);
%! assert_equal (class (r{1}), 'categorical');
%! assert_equal (size (r{1}), [1, 1]);
%! assert_equal (cellstr (r{1}), {'5'});
%! assert_equal (categories (r{1}), {'5'});
%! assert_equal (isordinal (r{1}), false);
%!test
%! d = configureDictionary ('double', 'categorical');
%! d(1) = {'x'};
%! r = values (d, 'cell');
%! assert_equal (size (r), [1, 1]);
%! assert_equal (class (r{1}), 'categorical');
%! assert_equal (size (r{1}), [1, 1]);
%! assert_equal (cellstr (r{1}), {'x'});
%! assert_equal (categories (r{1}), {'x'});
%! assert_equal (isordinal (r{1}), false);
%!error<dictionary.subsasgn: unable to use 'cell' as value of a dictionary of 'categorical' values.> ...
%! d = configureDictionary ('double', 'categorical');
%! d(1) = {5};
%!test
%! d = configureDictionary ('double', 'categorical');
%! d(1) = categorical ({'x'});
%! r = values (d, 'cell');
%! assert_equal (size (r), [1, 1]);
%! assert_equal (class (r{1}), 'categorical');
%! assert_equal (size (r{1}), [1, 1]);
%! assert_equal (cellstr (r{1}), {'x'});
