## Keys of type 'duration', measured on R2024a
%!shared D, R, CV
%! D = dictionary (hours (1), 10);
%! D(hours (2)) = 20;
%! D(hours (3)) = 30;
%! R = dictionary (hours (3), 30);
%! R(hours (2)) = 20;
%! R(hours (1)) = 10;
%! CV = dictionary (hours (1), {1});
%! CV(hours (2)) = {'two'};
%! CV(hours (3)) = {[3, 4]};
%!test
%! r = keys (D);
%! assert_equal (class (r), 'duration');
%! assert_equal (seconds (r), [3600; 7200; 10800]);
%!assert_equal (values (D), [10; 20; 30])
%!test
%! r = keys (D, 'cell');
%! assert_equal (size (r), [3, 1]);
%! assert_equal (class (r{1}), 'duration');
%! assert_equal (seconds (r{1}), 3600);
%! assert_equal (class (r{2}), 'duration');
%! assert_equal (seconds (r{2}), 7200);
%! assert_equal (class (r{3}), 'duration');
%! assert_equal (seconds (r{3}), 10800);
%!assert_equal (numEntries (D), 3)
%!assert_equal (D(hours (2)), 20)
%!assert_equal (isKey (D, hours (1)), true)
%!assert_equal (lookup (D, hours (2)), 20)
%!assert_equal (isKey (D, hours (9)), false)
%!assert_equal (lookup (D, hours (9), 'FallbackValue', 0), 0)
%!error<dictionary.subsref: key not found.> ...
%! D(hours (9));
%!test
%! d = D;
%! d(hours (9)) = [];
%! assert_equal (numEntries (d), 3);
%!test
%! d = D;
%! d = remove (d, hours (9));
%! assert_equal (numEntries (d), 3);
%!assert_equal (D(hours ([1, 3])), [10, 30])
%!assert_equal (isKey (D, hours ([1, 3])), [true, true])
%!test
%! r = dictionary (hours ([1, 3]), 7);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'duration', 'double'}));
%! assert_equal (numEntries (r), 2);
%! kc3 = keys (r, 'cell');
%! assert_equal (class (kc3{1}), 'duration');
%! assert_equal (seconds (kc3{1}), 3600);
%! assert_equal (class (kc3{2}), 'duration');
%! assert_equal (seconds (kc3{2}), 10800);
%! assert_equal (values (r, 'cell'), {7; 7});
%!test
%! d = D;
%! d(hours (4)) = 40;
%! r = keys (d, 'cell');
%! assert_equal (size (r), [4, 1]);
%! assert_equal (class (r{1}), 'duration');
%! assert_equal (seconds (r{1}), 3600);
%! assert_equal (class (r{2}), 'duration');
%! assert_equal (seconds (r{2}), 7200);
%! assert_equal (class (r{3}), 'duration');
%! assert_equal (seconds (r{3}), 10800);
%! assert_equal (class (r{4}), 'duration');
%! assert_equal (seconds (r{4}), 14400);
%!test
%! d = D;
%! d = insert (d, hours (4), 40);
%! assert_equal (values (d), [10; 20; 30; 40]);
%!test
%! d = D;
%! d(hours (1)) = 99;
%! assert_equal (values (d), [99; 20; 30]);
%!test
%! d = D;
%! d = insert (d, hours (1), 99);
%! assert_equal (values (d), [99; 20; 30]);
%!test
%! d = D;
%! d = insert (d, hours (1), 99, 'Overwrite', false);
%! assert_equal (values (d), [10; 20; 30]);
%!test
%! d = D;
%! d = remove (d, hours (1));
%! r = keys (d, 'cell');
%! assert_equal (size (r), [2, 1]);
%! assert_equal (class (r{1}), 'duration');
%! assert_equal (seconds (r{1}), 7200);
%! assert_equal (class (r{2}), 'duration');
%! assert_equal (seconds (r{2}), 10800);
%!test
%! d = D;
%! d(hours (1)) = [];
%! assert_equal (values (d), [20; 30]);
%!test
%! d = D;
%! d = remove (d, hours (1));
%! d(hours (1)) = 11;
%! assert_equal (values (d), [20; 30; 11]);
%!test
%! r = entries (D, 'struct');
%! assert_equal (size (r), [3, 1]);
%! assert_equal (fieldnames (r), {'Key'; 'Value'});
%! assert_equal (class (r(1).Key), 'duration');
%! assert_equal (seconds (r(1).Key), 3600);
%! assert_equal (r(1).Value, 10);
%! assert_equal (class (r(2).Key), 'duration');
%! assert_equal (seconds (r(2).Key), 7200);
%! assert_equal (r(2).Value, 20);
%! assert_equal (class (r(3).Key), 'duration');
%! assert_equal (seconds (r(3).Key), 10800);
%! assert_equal (r(3).Value, 30);
%!test
%! r = entries (D, 'cell');
%! assert_equal (size (r), [3, 2]);
%! assert_equal (class (r{1}), 'duration');
%! assert_equal (seconds (r{1}), 3600);
%! assert_equal (class (r{2}), 'duration');
%! assert_equal (seconds (r{2}), 7200);
%! assert_equal (class (r{3}), 'duration');
%! assert_equal (seconds (r{3}), 10800);
%! assert_equal (r{4}, 10);
%! assert_equal (r{5}, 20);
%! assert_equal (r{6}, 30);
%!test
%! r = entries (D);
%! tb1 = r;
%! assert_equal (size (tb1), [3, 2]);
%! assert_equal (tb1.Properties.VariableNames, {'Key', 'Value'});
%! assert_equal (class (tb1.Key), 'duration');
%! assert_equal (seconds (tb1.Key), [3600; 7200; 10800]);
%! assert_equal (tb1.Value, [10; 20; 30]);
%!assert_equal (isequal (D, R), true)
%!assert_equal (isequaln (D, R), true)
%!assert_equal (keyHash (D) == keyHash (R), false)
%!assert_equal (keyHash (D) == keyHash (D), true)
%!assert_equal (keyMatch (D, R), false)
%!assert_equal (CV{hours (2)}, 'two')
%!test
%! c = CV;
%! c{hours (1)} = 5;
%! assert_equal (c(hours (1)), {5});
%!test
%! c = CV;
%! c{hours (2)}(2) = 7;
%! r = c{hours (2)};
%! assert_equal (double (r), [116, 7, 111]);
%!error<dictionary.subsref: key not found.> ...
%! CV{hours (9)};

## Keys of type 'calendarDuration', measured on R2024a
%!shared D, R, CV
