%! c = CV;
%! c{dictionary (3, 4)}(2) = 7;
%! r = c{dictionary (3, 4)};
%! assert_equal (double (r), [116, 7, 111]);
%!error<dictionary.subsref: key not found.> ...
%! CV{dictionary (9, 9)};

## Keys of type 'logical', measured on R2024a
%!shared D, R, CV
%! D = dictionary (true, 10);
%! D(false) = 20;
%! R = dictionary (false, 20);
%! R(true) = 10;
%! CV = dictionary (true, {1});
%! CV(false) = {'two'};
%!assert_equal (keys (D), [true; false])
%!assert_equal (values (D), [10; 20])
%!assert_equal (keys (D, 'cell'), {true; false})
%!assert_equal (numEntries (D), 2)
%!assert_equal (D(false), 20)
%!assert_equal (isKey (D, true), true)
%!assert_equal (lookup (D, false), 20)
%!assert_equal (D([false, true]), [20, 10])
%!assert_equal (isKey (D, [false, true]), [true, true])
%!test
%! r = dictionary ([false, true], 7);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'logical', 'double'}));
%! assert_equal (numEntries (r), 2);
%! assert_equal (keys (r, 'cell'), {false; true});
%! assert_equal (values (r, 'cell'), {7; 7});
%!test
%! d = D;
%! d(true) = 99;
%! assert_equal (values (d), [99; 20]);
%!test
%! d = D;
%! d = insert (d, true, 99);
%! assert_equal (values (d), [99; 20]);
%!test
%! d = D;
%! d = insert (d, true, 99, 'Overwrite', false);
%! assert_equal (values (d), [10; 20]);
%!test
%! d = D;
%! d = remove (d, true);
%! assert_equal (keys (d, 'cell'), {false});
%!test
%! d = D;
%! d(true) = [];
%! assert_equal (values (d), 20);
%!test
%! d = D;
%! d = remove (d, true);
%! d(true) = 11;
%! assert_equal (values (d), [20; 11]);
%!test
%! r = entries (D, 'struct');
%! assert_equal (size (r), [2, 1]);
%! assert_equal (fieldnames (r), {'Key'; 'Value'});
%! assert_equal (r(1).Key, true);
%! assert_equal (r(1).Value, 10);
%! assert_equal (r(2).Key, false);
%! assert_equal (r(2).Value, 20);
%!assert_equal (entries (D, 'cell'), {true, 10; false, 20})
%!test
%! r = entries (D);
%! tb1 = r;
%! assert_equal (size (tb1), [2, 2]);
%! assert_equal (tb1.Properties.VariableNames, {'Key', 'Value'});
%! assert_equal (tb1.Key, [true; false]);
%! assert_equal (tb1.Value, [10; 20]);
%!assert_equal (isequal (D, R), true)
%!assert_equal (isequaln (D, R), true)
%!assert_equal (keyHash (D) == keyHash (R), false)
%!assert_equal (keyHash (D) == keyHash (D), true)
%!assert_equal (keyMatch (D, R), false)
%!assert_equal (CV{false}, 'two')
%!test
%! c = CV;
%! c{true} = 5;
%! assert_equal (c(true), {5});
%!test
%! c = CV;
%! c{false}(2) = 7;
%! r = c{false};
%! assert_equal (double (r), [116, 7, 111]);

## Keys of type 'missing', measured on R2024a
%!test
%! d = dictionary (missing, 10);
%! r = keys (d);
%! assert_equal (class (r), 'missing');
%! assert_equal (size (r), [1, 1]);
%!test
%! d = dictionary (missing, 10);
%! assert_equal (d(missing), 10);
%!test
%! d = dictionary (missing, 10);
%! assert_equal (isKey (d, missing), true);
%!test
%! d = dictionary (missing, 10);
%! d(missing) = 20;
%! assert_equal (values (d), 20);
%!test
%! d = dictionary (missing, 10);
%! d = remove (d, missing);
%! assert_equal (numEntries (d), 0);
%!test
%! d = dictionary (missing, 10);
%! r = entries (d, 'struct');
%! assert_equal (size (r), [1, 1]);
%! assert_equal (fieldnames (r), {'Key'; 'Value'});
%! assert_equal (class (r(1).Key), 'missing');
%! assert_equal (size (r(1).Key), [1, 1]);
%! assert_equal (r(1).Value, 10);
%!error<dictionary.subsref: unable to use 'double' as key of a dictionary of 'missing' keys.> ...
%! d = dictionary (missing, 10);
%! d(NaN);
%!test
%! d = dictionary (missing, 10);
%! assert_equal (keyHash (d) == keyHash (dictionary (missing, 10)), true);

## Conversion to a value of type 'double', measured on R2024a
%!test
%! d = configureDictionary ('double', 'double');
%! d(1) = 5;
%! assert_equal (values (d, 'cell'), {5});
%!test
%! d = configureDictionary ('double', 'double');
%! d(1) = int8 (5);
%! assert_equal (values (d, 'cell'), {5});
%!test
%! d = configureDictionary ('double', 'double');
%! d(1) = true;
%! assert_equal (values (d, 'cell'), {1});
%!test
%! d = configureDictionary ('double', 'double');
%! d(1) = 'x';
%! assert_equal (values (d, 'cell'), {120});
%!test
%! d = configureDictionary ('double', 'double');
%! d(1) = '5';
%! assert_equal (values (d, 'cell'), {53});
%!test
%! d = configureDictionary ('double', 'double');
%! d(1) = string ('x');
%! assert_equal (values (d, 'cell'), {NaN});
