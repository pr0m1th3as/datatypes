%! assert_equal (keys (r, 'cell'), {1; 2});
%! assert_equal (values (r, 'cell'), {{@sin}; {@cos}});
%!test
%! r = dictionary (datetime (2024, 1, [1, 2]), [1, 2]);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'datetime', 'double'}));
%! assert_equal (numEntries (r), 2);
%! kc3 = keys (r, 'cell');
%! x5 = kc3{1};
%! x5.Format = 'yyyy-MM-dd HH:mm:ss.SSS';
%! assert_equal (cellstr (x5), {'2024-01-01 00:00:00.000'});
%! assert_equal (x5.TimeZone, '');
%! x6 = kc3{2};
%! x6.Format = 'yyyy-MM-dd HH:mm:ss.SSS';
%! assert_equal (cellstr (x6), {'2024-01-02 00:00:00.000'});
%! assert_equal (x6.TimeZone, '');
%! assert_equal (values (r, 'cell'), {1; 2});
%!test
%! r = dictionary (datetime (2024, 1, [1, 1]), [1, 2]);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'datetime', 'double'}));
%! assert_equal (numEntries (r), 1);
%! kc3 = keys (r, 'cell');
%! x5 = kc3{1};
%! x5.Format = 'yyyy-MM-dd HH:mm:ss.SSS';
%! assert_equal (cellstr (x5), {'2024-01-01 00:00:00.000'});
%! assert_equal (x5.TimeZone, '');
%! assert_equal (values (r, 'cell'), {2});
%!test
%! r = dictionary ([datetime(2024, 1, 1), NaT, NaT], [1, 2, 3]);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'datetime', 'double'}));
%! assert_equal (numEntries (r), 2);
%! kc3 = keys (r, 'cell');
%! x5 = kc3{1};
%! x5.Format = 'yyyy-MM-dd HH:mm:ss.SSS';
%! assert_equal (cellstr (x5), {'2024-01-01 00:00:00.000'});
%! assert_equal (x5.TimeZone, '');
%! x6 = kc3{2};
%! x6.Format = 'yyyy-MM-dd HH:mm:ss.SSS';
%! assert_equal (cellstr (x6), {'NaT'});
%! assert_equal (x6.TimeZone, '');
%! assert_equal (values (r, 'cell'), {1; 3});
%!test
%! r = dictionary (datetime (2024, 1, 1, 'TimeZone', 'UTC'), 1);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'datetime', 'double'}));
%! assert_equal (numEntries (r), 1);
%! kc3 = keys (r, 'cell');
%! x5 = kc3{1};
%! x5.Format = 'yyyy-MM-dd HH:mm:ss.SSS';
%! assert_equal (cellstr (x5), {'2024-01-01 00:00:00.000'});
%! assert_equal (x5.TimeZone, 'UTC');
%! assert_equal (values (r, 'cell'), {1});
%!test
%! r = dictionary (datetime (2024, 1, 1, 'TimeZone', 'Europe/Athens'), 1);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'datetime', 'double'}));
%! assert_equal (numEntries (r), 1);
%! kc3 = keys (r, 'cell');
%! x5 = kc3{1};
%! x5.Format = 'yyyy-MM-dd HH:mm:ss.SSS';
%! assert_equal (cellstr (x5), {'2024-01-01 00:00:00.000'});
%! assert_equal (x5.TimeZone, 'Europe/Athens');
%! assert_equal (values (r, 'cell'), {1});
%!test
%! r = dictionary (1, datetime (2024, 1, 1, 'TimeZone', 'UTC'));
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'datetime'}));
%! assert_equal (numEntries (r), 1);
%! assert_equal (keys (r, 'cell'), {1});
%! vc4 = values (r, 'cell');
%! x5 = vc4{1};
%! x5.Format = 'yyyy-MM-dd HH:mm:ss.SSS';
%! assert_equal (cellstr (x5), {'2024-01-01 00:00:00.000'});
%! assert_equal (x5.TimeZone, 'UTC');
%!test
%! r = dictionary (hours ([1, 2]), [1, 2]);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'duration', 'double'}));
%! assert_equal (numEntries (r), 2);
%! kc3 = keys (r, 'cell');
%! assert_equal (class (kc3{1}), 'duration');
%! assert_equal (seconds (kc3{1}), 3600);
%! assert_equal (class (kc3{2}), 'duration');
%! assert_equal (seconds (kc3{2}), 7200);
%! assert_equal (values (r, 'cell'), {1; 2});
%!test
%! r = dictionary (hours (1), 1, minutes (60), 2);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'duration', 'double'}));
%! assert_equal (numEntries (r), 1);
%! kc3 = keys (r, 'cell');
%! assert_equal (class (kc3{1}), 'duration');
%! assert_equal (seconds (kc3{1}), 3600);
%! assert_equal (values (r, 'cell'), {2});
%!test
%! r = dictionary ([hours(1), seconds(3600)], [1, 2]);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'duration', 'double'}));
%! assert_equal (numEntries (r), 1);
%! kc3 = keys (r, 'cell');
%! assert_equal (class (kc3{1}), 'duration');
%! assert_equal (seconds (kc3{1}), 3600);
%! assert_equal (values (r, 'cell'), {2});
%!test
%! r = dictionary ([hours(NaN), hours(NaN)], [1, 2]);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'duration', 'double'}));
%! assert_equal (numEntries (r), 1);
%! kc3 = keys (r, 'cell');
%! assert_equal (class (kc3{1}), 'duration');
%! assert_equal (seconds (kc3{1}), NaN);
%! assert_equal (values (r, 'cell'), {2});
%!test
%! r = dictionary (calmonths ([1, 2]), [1, 2]);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'calendarDuration', 'double'}));
%! assert_equal (numEntries (r), 2);
%! kc3 = keys (r, 'cell');
%! [m5, dd6, t7] = split (kc3{1}, {'months', 'days', 'time'});
%! assert_equal ([m5(:), dd6(:), seconds(t7(:))], [1, 0, 0]);
%! [m8, dd9, t10] = split (kc3{2}, {'months', 'days', 'time'});
%! assert_equal ([m8(:), dd9(:), seconds(t10(:))], [2, 0, 0]);
%! assert_equal (values (r, 'cell'), {1; 2});
%!test
%! r = dictionary ([calmonths(12), calyears(1)], [1, 2]);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'calendarDuration', 'double'}));
%! assert_equal (numEntries (r), 1);
%! kc3 = keys (r, 'cell');
%! [m5, dd6, t7] = split (kc3{1}, {'months', 'days', 'time'});
%! assert_equal ([m5(:), dd6(:), seconds(t7(:))], [12, 0, 0]);
%! assert_equal (values (r, 'cell'), {2});
%!test
%! r = dictionary ([caldays(7), calweeks(1)], [1, 2]);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'calendarDuration', 'double'}));
%! assert_equal (numEntries (r), 1);
%! kc3 = keys (r, 'cell');
%! [m5, dd6, t7] = split (kc3{1}, {'months', 'days', 'time'});
%! assert_equal ([m5(:), dd6(:), seconds(t7(:))], [0, 7, 0]);
%! assert_equal (values (r, 'cell'), {2});
%!test
%! r = dictionary (categorical ({'r', 'g', 'r'}), [1, 2, 3]);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'categorical', 'double'}));
%! assert_equal (numEntries (r), 2);
%! kc3 = keys (r, 'cell');
%! assert_equal (class (kc3{1}), 'categorical');
%! assert_equal (size (kc3{1}), [1, 1]);
%! assert_equal (cellstr (kc3{1}), {'r'});
%! assert_equal (categories (kc3{1}), {'g'; 'r'});
%! assert_equal (isordinal (kc3{1}), false);
%! assert_equal (class (kc3{2}), 'categorical');
%! assert_equal (size (kc3{2}), [1, 1]);
%! assert_equal (cellstr (kc3{2}), {'g'});
%! assert_equal (categories (kc3{2}), {'g'; 'r'});
%! assert_equal (isordinal (kc3{2}), false);
%! assert_equal (values (r, 'cell'), {3; 2});
%!test
%! r = dictionary (categorical ({'r', 'g'}, {'r', 'g', 'b'}), [1, 2]);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'categorical', 'double'}));
%! assert_equal (numEntries (r), 2);
%! kc3 = keys (r, 'cell');
%! assert_equal (class (kc3{1}), 'categorical');
%! assert_equal (size (kc3{1}), [1, 1]);
%! assert_equal (cellstr (kc3{1}), {'r'});
%! assert_equal (categories (kc3{1}), {'r'; 'g'; 'b'});
%! assert_equal (isordinal (kc3{1}), false);
%! assert_equal (class (kc3{2}), 'categorical');
%! assert_equal (size (kc3{2}), [1, 1]);
%! assert_equal (cellstr (kc3{2}), {'g'});
%! assert_equal (categories (kc3{2}), {'r'; 'g'; 'b'});
%! assert_equal (isordinal (kc3{2}), false);
%! assert_equal (values (r, 'cell'), {1; 2});
%!test
%! r = dictionary (categorical ({'lo', 'hi'}, {'lo', 'hi'}, 'Ordinal', ...
%!                              true), [1, 2]);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'categorical', 'double'}));
%! assert_equal (numEntries (r), 2);
%! kc3 = keys (r, 'cell');
%! assert_equal (class (kc3{1}), 'categorical');
%! assert_equal (size (kc3{1}), [1, 1]);
%! assert_equal (cellstr (kc3{1}), {'lo'});
%! assert_equal (categories (kc3{1}), {'lo'; 'hi'});
%! assert_equal (isordinal (kc3{1}), true);
%! assert_equal (class (kc3{2}), 'categorical');
%! assert_equal (size (kc3{2}), [1, 1]);
%! assert_equal (cellstr (kc3{2}), {'hi'});
%! assert_equal (categories (kc3{2}), {'lo'; 'hi'});
%! assert_equal (isordinal (kc3{2}), true);
%! assert_equal (values (r, 'cell'), {1; 2});
%!test
%! r = dictionary (categorical ({'r', ''}), [1, 2]);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'categorical', 'double'}));
%! assert_equal (numEntries (r), 2);
%! kc3 = keys (r, 'cell');
%! assert_equal (class (kc3{1}), 'categorical');
%! assert_equal (size (kc3{1}), [1, 1]);
%! assert_equal (cellstr (kc3{1}), {'r'});
%! assert_equal (categories (kc3{1}), {'r'});
%! assert_equal (isordinal (kc3{1}), false);
%! assert_equal (class (kc3{2}), 'categorical');
%! assert_equal (size (kc3{2}), [1, 1]);
%! assert_equal (isundefined (kc3{2}), true);
%! assert_equal (categories (kc3{2}), {'r'});
%! assert_equal (isordinal (kc3{2}), false);
%! assert_equal (values (r, 'cell'), {1; 2});
%!test
%! r = dictionary (categorical ({'', ''}), [1, 2]);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'categorical', 'double'}));
%! assert_equal (numEntries (r), 1);
%! kc3 = keys (r, 'cell');
%! assert_equal (class (kc3{1}), 'categorical');
%! assert_equal (size (kc3{1}), [1, 1]);
%! assert_equal (isundefined (kc3{1}), true);
%! assert_equal (categories (kc3{1}), cell (0, 0));
%! assert_equal (isordinal (kc3{1}), false);
%! assert_equal (values (r, 'cell'), {2});
%!test
%! r = dictionary (1, categorical ({'x'}));
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'categorical'}));
%! assert_equal (numEntries (r), 1);
%! assert_equal (keys (r, 'cell'), {1});
%! vc4 = values (r, 'cell');
%! assert_equal (class (vc4{1}), 'categorical');
%! assert_equal (size (vc4{1}), [1, 1]);
%! assert_equal (cellstr (vc4{1}), {'x'});
%! assert_equal (categories (vc4{1}), {'x'});
%! assert_equal (isordinal (vc4{1}), false);
%!test
%! r = dictionary (missing, 1);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'missing', 'double'}));
%! assert_equal (numEntries (r), 1);
%! kc3 = keys (r, 'cell');
%! assert_equal (class (kc3{1}), 'missing');
%! assert_equal (size (kc3{1}), [1, 1]);
%! assert_equal (values (r, 'cell'), {1});
%!test
%! r = dictionary ([missing, missing], [1, 2]);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'missing', 'double'}));
%! assert_equal (numEntries (r), 1);
%! kc3 = keys (r, 'cell');
%! assert_equal (class (kc3{1}), 'missing');
%! assert_equal (size (kc3{1}), [1, 1]);
%! assert_equal (values (r, 'cell'), {2});
%!test
%! r = dictionary (1, missing);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'missing'}));
%! assert_equal (numEntries (r), 1);
%! assert_equal (keys (r, 'cell'), {1});
%! vc4 = values (r, 'cell');
%! assert_equal (class (vc4{1}), 'missing');
%! assert_equal (size (vc4{1}), [1, 1]);
%!test
%! r = dictionary ([1, 2], [missing, missing]);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'missing'}));
%! assert_equal (numEntries (r), 2);
%! assert_equal (keys (r, 'cell'), {1; 2});
%! vc4 = values (r, 'cell');
%! assert_equal (class (vc4{1}), 'missing');
%! assert_equal (size (vc4{1}), [1, 1]);
%! assert_equal (class (vc4{2}), 'missing');
%! assert_equal (size (vc4{2}), [1, 1]);
%!test
%! r = dictionary (string ('a'), missing);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'string', 'missing'}));
%! assert_equal (numEntries (r), 1);
%! assert_equal (keys (r, 'cell'), {string('a')});
%! vc4 = values (r, 'cell');
%! assert_equal (class (vc4{1}), 'missing');
%! assert_equal (size (vc4{1}), [1, 1]);
%!test
%! r = dictionary (dictionary (1, 2), 3);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'dictionary', 'double'}));
%! assert_equal (numEntries (r), 1);
%! kc3 = keys (r, 'cell');
%! dc5 = kc3{1};
%! [kt6, vt7] = types (dc5);
%! assert_equal ([kt6, vt7], string ({'double', 'double'}));
%! assert_equal (numEntries (dc5), 1);
%! assert_equal (keys (dc5, 'cell'), {1});
%! assert_equal (values (dc5, 'cell'), {2});
%! assert_equal (values (r, 'cell'), {3});
%!test
%! r = dictionary (1, dictionary (1, 2));
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'dictionary'}));
%! assert_equal (numEntries (r), 1);
%! assert_equal (keys (r, 'cell'), {1});
%! vc4 = values (r, 'cell');
%! dc5 = vc4{1};
%! [kt6, vt7] = types (dc5);
%! assert_equal ([kt6, vt7], string ({'double', 'double'}));
%! assert_equal (numEntries (dc5), 1);
%! assert_equal (keys (dc5, 'cell'), {1});
%! assert_equal (values (dc5, 'cell'), {2});
%!test
%! r = dictionary (1, table (1));
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'table'}));
%! assert_equal (numEntries (r), 1);
%! assert_equal (keys (r, 'cell'), {1});
%! vc4 = values (r, 'cell');
%! tb5 = vc4{1};
%! assert_equal (size (tb5), [1, 1]);
%! assert_equal (tb5.Properties.VariableNames, {'Var1'});
%! assert_equal (tb5.Var1, 1);

## D3: a table of any size is one value, where MATLAB takes only 1-by-1.
%!test
%! r = dictionary ([1, 2], [table(1); table(2)]);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'table'}));
%! assert_equal (numEntries (r), 2);
%! assert_equal (keys (r, 'cell'), {1; 2});
%! vc4 = values (r, 'cell');
%! tb5 = vc4{1};
%! assert_equal (size (tb5), [2, 1]);
%! assert_equal (tb5.Properties.VariableNames, {'Var1'});
%! assert_equal (tb5.Var1, [1; 2]);
%! tb6 = vc4{2};
%! assert_equal (size (tb6), [2, 1]);
%! assert_equal (tb6.Properties.VariableNames, {'Var1'});
%! assert_equal (tb6.Var1, [1; 2]);
%!error<dictionary: unsupported key type 'table'.> ...
%! dictionary (table (1), 1);
%!error<dictionary: each key must be followed by a value.> ...
%! dictionary (1, 2, 3);
%!test
%! r = dictionary (1, 2, 3, 4);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'double'}));
%! assert_equal (numEntries (r), 2);
%! assert_equal (keys (r, 'cell'), {1; 3});
%! assert_equal (values (r, 'cell'), {2; 4});
%!test
%! r = dictionary (1, 2, 1, 4);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'double'}));
%! assert_equal (numEntries (r), 1);
%! assert_equal (keys (r, 'cell'), {1});
%! assert_equal (values (r, 'cell'), {4});
%!test
%! r = dictionary (1, 2, string ('3'), 4);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'double'}));
%! assert_equal (numEntries (r), 2);
%! assert_equal (keys (r, 'cell'), {1; 3});
%! assert_equal (values (r, 'cell'), {2; 4});
%!test
%! r = dictionary (string ('a'), 1, 2, 3);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'string', 'double'}));
%! assert_equal (numEntries (r), 2);
%! assert_equal (keys (r, 'cell'), {string('a'); string('2')});
%! assert_equal (values (r, 'cell'), {1; 3});
%!test
%! r = dictionary (string ('a'), 1, string ('b'), 'x');
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'string', 'double'}));
%! assert_equal (numEntries (r), 2);
%! assert_equal (keys (r, 'cell'), {string('a'); string('b')});
%! assert_equal (values (r, 'cell'), {1; 120});
%!test
%! r = dictionary (1, 2, [], []);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'double'}));
%! assert_equal (numEntries (r), 1);
%! assert_equal (keys (r, 'cell'), {1});
%! assert_equal (values (r, 'cell'), {2});
%!test
%! r = dictionary (1, 2, [3, 4], [5, 6]);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'double'}));
%! assert_equal (numEntries (r), 3);
%! assert_equal (keys (r, 'cell'), {1; 3; 4});
%! assert_equal (values (r, 'cell'), {2; 5; 6});
%!test
%! r = dictionary (int8 (1), 1, 2.7, 3);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'int8', 'double'}));
%! assert_equal (numEntries (r), 2);
%! assert_equal (keys (r, 'cell'), {int8(1); int8(3)});
%! assert_equal (values (r, 'cell'), {1; 3});
%!test
%! r = dictionary (int8 (1), 1, 300, 3);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'int8', 'double'}));
%! assert_equal (numEntries (r), 2);
%! assert_equal (keys (r, 'cell'), {int8(1); int8(127)});
%! assert_equal (values (r, 'cell'), {1; 3});
%!test
%! r = dictionary (true, 1, 2, 3);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'logical', 'double'}));
%! assert_equal (numEntries (r), 1);
%! assert_equal (keys (r, 'cell'), {true});
%! assert_equal (values (r, 'cell'), {3});
%!test
%! r = dictionary (1, true, 2, 3);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'logical'}));
%! assert_equal (numEntries (r), 2);
%! assert_equal (keys (r, 'cell'), {1; 2});
%! assert_equal (values (r, 'cell'), {true; true});
%!test
%! r = dictionary (1, int8 (5), 2, 3.6);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'int8'}));
%! assert_equal (numEntries (r), 2);
%! assert_equal (keys (r, 'cell'), {1; 2});
%! assert_equal (values (r, 'cell'), {int8(5); int8(4)});
%!test
%! r = dictionary (1, 2, 'a', 3);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'double'}));
%! assert_equal (numEntries (r), 2);
%! assert_equal (keys (r, 'cell'), {1; 97});
%! assert_equal (values (r, 'cell'), {2; 3});
%!test
%! r = dictionary (string ('a'), 1, 7, 2);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'string', 'double'}));
%! assert_equal (numEntries (r), 2);
%! assert_equal (keys (r, 'cell'), {string('a'); string('7')});
%! assert_equal (values (r, 'cell'), {1; 2});
%!test
%! r = dictionary (string ('a'), 1, true, 2);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'string', 'double'}));
%! assert_equal (numEntries (r), 2);
%! assert_equal (keys (r, 'cell'), {string('a'); string('true')});
%! assert_equal (values (r, 'cell'), {1; 2});
%!test
%! r = dictionary (datetime (2024, 1, 1), 1, '2024-01-02', 2);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'datetime', 'double'}));
%! assert_equal (numEntries (r), 2);
%! kc3 = keys (r, 'cell');
%! x5 = kc3{1};
%! x5.Format = 'yyyy-MM-dd HH:mm:ss.SSS';
%! assert_equal (cellstr (x5), {'2024-01-01 00:00:00.000'});
%! assert_equal (x5.TimeZone, '');
%! x6 = kc3{2};
%! x6.Format = 'yyyy-MM-dd HH:mm:ss.SSS';
%! assert_equal (cellstr (x6), {'2024-01-02 00:00:00.000'});
%! assert_equal (x6.TimeZone, '');
%! assert_equal (values (r, 'cell'), {1; 2});
%!error<dictionary: unable to use 'double' as key of a dictionary of 'datetime' keys.> ...
%! dictionary (datetime (2024, 1, 1), 1, 5, 2);
%!test
%! r = dictionary (categorical ({'r'}), 1, string ('g'), 2);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'categorical', 'double'}));
%! assert_equal (numEntries (r), 2);
%! kc3 = keys (r, 'cell');
%! assert_equal (class (kc3{1}), 'categorical');
%! assert_equal (size (kc3{1}), [1, 1]);
%! assert_equal (cellstr (kc3{1}), {'r'});
%! assert_equal (categories (kc3{1}), {'r'});
%! assert_equal (isordinal (kc3{1}), false);
%! assert_equal (class (kc3{2}), 'categorical');
%! assert_equal (size (kc3{2}), [1, 1]);
%! assert_equal (cellstr (kc3{2}), {'g'});
%! assert_equal (categories (kc3{2}), {'g'});
%! assert_equal (isordinal (kc3{2}), false);
%! assert_equal (values (r, 'cell'), {1; 2});
%!error<dictionary: unable to use 'char' as key of a dictionary of 'categorical' keys.> ...
%! dictionary (categorical ({'r'}), 1, 'g', 2);
%!test
%! r = dictionary (1, string ('x'), 2, 5);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'string'}));
%! assert_equal (numEntries (r), 2);
%! assert_equal (keys (r, 'cell'), {1; 2});
%! assert_equal (values (r, 'cell'), {string('x'); string('5')});
%!test
%! r = dictionary (1, string ('x'), 2, missing);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'string'}));
%! assert_equal (numEntries (r), 2);
%! assert_equal (keys (r, 'cell'), {1; 2});
%! vc4 = values (r, 'cell');
%! assert_equal (vc4{1}, string ('x'));
%! assert_equal (class (vc4{2}), 'string');
%! assert_equal (ismissing (vc4{2}), true);
%!test
%! r = dictionary (1, 2, 3, missing);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'double'}));
%! assert_equal (numEntries (r), 2);
%! assert_equal (keys (r, 'cell'), {1; 3});
%! assert_equal (values (r, 'cell'), {2; NaN});
%!test
%! r = dictionary (string ('a'), 1, missing, 2);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'string', 'double'}));
%! assert_equal (numEntries (r), 2);
%! kc3 = keys (r, 'cell');
%! assert_equal (kc3{1}, string ('a'));
%! assert_equal (class (kc3{2}), 'string');
%! assert_equal (ismissing (kc3{2}), true);
%! assert_equal (values (r, 'cell'), {1; 2});
%!assert_equal (isConfigured (dictionary ()), false)
%!assert_equal (isConfigured (dictionary (1, 2)), true)
%!assert_equal (isConfigured (configureDictionary ('double', 'double')), true)
%!assert_equal (numEntries (dictionary ()), 0)
%!assert_equal (numEntries (configureDictionary ('double', 'double')), 0)
%!test
%! r = types (dictionary ());
%! assert_equal (class (r), 'string');
%! assert_equal (ismissing (r), true);
%!assert_equal (types (dictionary (1, string ('x'))), string ('double'))
%!test
%! [kt, vt] = types (dictionary (1, string ('x')));
%! assert_equal (vt, string ('string'));
%!test
%! [kt, vt] = types (dictionary ());
%! r = vt;
%! assert_equal (class (r), 'string');
%! assert_equal (ismissing (r), true);

################################################################################
##                          ** Keys and values **                             ##
################################################################################
##                             Available Methods                              ##
##                                                                            ##
## 'keys'             'values'           'isKey'                              ##
##                                                                            ##
################################################################################

%!shared D, C
%! D = dictionary (string ({'a'; 'b'; 'c'}), [1; 2; 3]);
%! C = configureDictionary ('string', 'double');

%!assert_equal (keys (D), string ({'a'; 'b'; 'c'}))
%!assert_equal (keys (D, 'uniform'), string ({'a'; 'b'; 'c'}))
%!assert_equal (keys (D, 'cell'), {string('a'); string('b'); string('c')})
%!assert_equal (keys (D, string ('cell')), ...
%!              {string('a'); string('b'); string('c')})
%!assert_equal (keys (C), string (cell (0, 1)))
%!assert_equal (keys (C, 'cell'), cell (0, 1))
%!assert_equal (keys (dictionary ({'a'; 'b'}, [1; 2]), 'cell'), {{'a'}; {'b'}})
%!assert_equal (keys (dictionary (@sin, 1)), @sin)
%!test
%! k = keys (configureDictionary ('datetime', 'double'));
%! assert_equal (class (k), 'datetime');
%! assert_equal (size (k), [0, 1]);
%!assert_equal (keys (D, 'c'), {string('a'); string('b'); string('c')})
%!assert_equal (keys (D, 'UNIFORM'), string ({'a'; 'b'; 'c'}))
%!error<dictionary.keys: D is not configured.> keys (dictionary ())
%!error<dictionary.keys: FORMAT must be a character vector or a string scalar.> ...
%! keys (D, 1)
%!error<dictionary.keys: invalid format 'foo'.> keys (D, 'foo')
%!error<dictionary.keys: cannot join keys of type 'function_handle'; use the 'cell' format.> ...
%! keys (dictionary (@sin, 1, @cos, 2))

%!assert_equal (values (D), [1; 2; 3])
%!assert_equal (values (D, 'uniform'), [1; 2; 3])
%!assert_equal (values (D, 'cell'), {1; 2; 3})
%!assert_equal (values (C), zeros (0, 1))
%!assert_equal (values (dictionary (string ('f'), @sin)), @sin)
%!test
%! d = dictionary (string ({'f'; 'g'}), {@sin; @cos});
%! assert_equal (values (d), {@sin; @cos});
%!test
%! d = dictionary (string ('a'), struct ('x', 1), ...
%!                 string ('b'), struct ('y', 2));
%! v = values (d, 'cell');
%! assert_equal (v{2}, struct ('y', 2));
%!test
%! d = dictionary (string ('a'), table (1), string ('b'), table (2));
%! assert_equal (isequal (values (d), table ([1; 2])), true);
%!assert_equal (values (D, 'u'), [1; 2; 3])
%!assert_equal (values (D, 'Cell'), {1; 2; 3})
%!error<dictionary.values: D is not configured.> values (dictionary ())
%!error<dictionary.values: FORMAT must be a character vector or a string scalar.> ...
%! values (D, string ({'b'; 'a'}))
%!error<dictionary.values: invalid format 'foo'.> values (D, 'foo')
%!error<dictionary.values: cannot join values of type 'struct'; use the 'cell' format.> ...
%! values (dictionary (string ('a'), struct ('x', 1), ...
%!                     string ('b'), struct ('y', 2)))
%!error<dictionary.values: cannot join values of type 'table'; use the 'cell' format.> ...
%! values (dictionary (string ('a'), table ([1; 2]), string ('b'), table (3)))
%!error<dictionary.values: cannot join values of type 'function_handle'; use the 'cell' format.> ...
%! values (dictionary (string ('f'), @sin, string ('g'), @cos))
%!error<dictionary.values: cannot join values of type 'dictionary'; use the 'cell' format.> ...
%! values (dictionary (string ('a'), dictionary (1, 2), ...
%!                     string ('b'), dictionary (3, 4)))

%!assert_equal (isKey (D, string ('a')), true)
%!assert_equal (isKey (D, string ('z')), false)
%!assert_equal (isKey (D, string ({'a'; 'z'})), [true; false])
%!assert_equal (isKey (D, string ({'a', 'z'; 'c', 'b'})), ...
%!              [true, false; true, true])
%!assert_equal (isKey (D, string (cell (0, 0))), false (0, 0))
%!assert_equal (isKey (D, []), false (0, 0))
%!assert_equal (isKey (D, 'a'), true)
%!assert_equal (isKey (D, {'a'}), true)
%!assert_equal (isKey (D, 1), false)
%!assert_equal (isKey (D, datetime (2024, 1, 1)), false)
%!assert_equal (isKey (dictionary ([1; 2], [3; 4]), string ('1')), true)
%!assert_equal (isKey (dictionary ([1; 2], [3; 4]), string ('abc')), false)
%!assert_equal (isKey (dictionary ([1; 2], [3; 4]), 'a'), false)
%!assert_equal (isKey (dictionary ([1; 2], [3; 4]), NaN), false)
%!assert_equal (isKey (dictionary ({'a'; 'b'}, [1; 2]), {'a'; 'z'}), ...
%!              [true; false])
%!assert_equal (isKey (dictionary (int8 ([1, 2]), [5, 6]), 1.4), true)
%!assert_equal (isKey (dictionary (int8 ([1, 2]), [5, 6]), 300), false)
%!assert_equal (isKey (C, string ('a')), false)
%!error<dictionary.isKey: invalid number of input arguments.> isKey (D)
%!error<dictionary.isKey: D is not configured.> isKey (dictionary (), string ('a'))
%!error<dictionary.isKey: unable to use 'cell' as key of a dictionary of 'double' keys.> ...
%! isKey (dictionary ([1; 2], [3; 4]), {1})
%!error<dictionary.isKey: unsupported input type 'table'.> ...
%! isKey (dictionary ({1}, 1), {table(1)})
%!error<dictionary.isKey: unable to use 'char' as key of a dictionary of 'cell' keys.> ...
%! isKey (dictionary ({'a'; 'b'}, [1; 2]), 'a')

################################################################################
##                             ** Entries **                                  ##
################################################################################
##                             Available Methods                              ##
##                                                                            ##
## 'insert'           'lookup'           'remove'           'entries'         ##
##                                                                            ##
################################################################################

%!shared D, CV
%! D = dictionary (string ({'a'; 'b'; 'c'}), [1; 2; 3]);
%! CV = dictionary (string ({'a'; 'b'}), {1; 'two'});

%!assert_equal (values (insert (D, string ('a'), 9)), [9; 2; 3])
%!assert_equal (values (insert (D, string ('z'), 9)), [1; 2; 3; 9])
%!assert_equal (values (insert (D, string ('a'), 9, 'Overwrite', false)), ...
%!              [1; 2; 3])
%!assert_equal (values (insert (D, string ('a'), 9, 'overwrite', false)), ...
%!              [1; 2; 3])
%!assert_equal (values (insert (D, string ('a'), 9, ...
%!                              string ('Overwrite'), 0)), ...
%!              [1; 2; 3])
%!assert_equal (values (insert (D, string ('a'), 9, 'Overwrite', -1)), ...
%!              [9; 2; 3])
%!assert_equal (values (insert (D, string ('a'), 9, 'Overwrite', true, ...
%!                              'Overwrite', false)), [1; 2; 3])
%!assert_equal (values (insert (D, string ({'z'; 'a'}), [8; 9], ...
%!                              'Overwrite', false)), [1; 2; 3; 8])
%!assert_equal (values (insert (D, string ({'z'; 'z'}), [8; 9])), [1; 2; 3; 9])
%!assert_equal (values (insert (D, string ({'z'; 'z'}), [8; 9], ...
%!                              'Overwrite', false)), [1; 2; 3; 8])
%!assert_equal (values (insert (D, string ({'x'; 'y'}), 7)), [1; 2; 3; 7; 7])
%!assert_equal (numEntries (insert (D, string (cell (0, 1)), 5)), 3)
%!assert_equal (keys (insert (D, {1}, 4)), string ({'a'; 'b'; 'c'; '1'}))
%!assert_equal (values (insert (D, string ('q'), string ('7'))), [1; 2; 3; 7])
%!test
%! d = insert (dictionary (), string ('k'), {1});
%! [kt, vt] = types (d);
%! assert_equal (kt, string ('string'));
%! assert_equal (vt, string ('cell'));
%!assert_equal (numEntries (D.insert (string ('q'), 1)), 4)
%!error<dictionary.insert: invalid number of input arguments.> ...
%! insert (D, string ('a'))
%!error<dictionary.insert: name-value arguments must be in pairs.> ...
%! insert (D, string ('a'), 9, 'Overwrite')
%!error<dictionary.insert: name-value arguments must be in pairs.> ...
%! insert (D, string ('a'), 9, 5)
%!error<dictionary.insert: invalid optional paired argument.> ...
%! insert (D, string ('a'), 9, 'Foo', true)
%!error<dictionary.insert: unsupported key type 'table'.> ...
%! insert (dictionary (), table (1), 2)
%!error<dictionary.insert: unable to use 'cell' as key of a dictionary of 'double' keys.> ...
%! insert (dictionary (1, 2), {1}, 2)
%!error<dictionary.insert: 'Overwrite' must be a logical scalar.> ...
%! insert (D, string ('a'), 9, 'Overwrite', [true, false])
%!error<dictionary.insert: 'Overwrite' must be a logical scalar.> ...
%! insert (D, string ('a'), 9, 'Overwrite', 'yes')
%!error<dictionary.insert: 'Overwrite' must be a logical scalar.> ...
%! insert (D, string ('a'), 9, 'Overwrite', [])
%!error<dictionary.insert: 'Overwrite' must be a logical scalar.> ...
%! insert (D, string ('a'), 9, 'Overwrite', NaN)
%!error<dictionary.insert: KEYS and VALUES must be the same size, or VALUES a scalar.> ...
%! insert (D, string ('a'), [])
%!error<dictionary.insert: unable to use 'cell' as value of a dictionary of 'double' values.> ...
%! insert (D, string ('a'), {1})

%!assert_equal (lookup (D, string ('b')), 2)
%!assert_equal (lookup (D, string ({'c'; 'a'})), [3; 1])
%!assert_equal (lookup (D, string ('z'), 'FallbackValue', 0), 0)
%!assert_equal (lookup (D, string ('z'), 'FALLBACKVALUE', 0), 0)
%!assert_equal (lookup (D, string ({'a', 'z'; 'z', 'b'}), ...
%!                      'FallbackValue', -1), ...
%!              [1, -1; -1, 2])
%!assert_equal (lookup (D, [], 'FallbackValue', -1), zeros (0, 0))
%!assert_equal (lookup (D, string (cell (0, 1))), zeros (0, 1))
%!assert_equal (lookup (D, string ('z'), 'FallbackValue', missing), NaN)
%!assert_equal (lookup (D, string ('z'), 'FallbackValue', '7'), 55)
%!assert_equal (lookup (D, string ('z'), 'FallbackValue', string ('7')), 7)
%!assert_equal (lookup (D, string ('z'), 'FallbackValue', int8 (4)), 4)
%!test
%! ## The fallback is not checked when every key is found
%! assert_equal (lookup (D, string ('a'), 'FallbackValue', {1}), 1);
%! assert_equal (lookup (D, string ('a'), 'FallbackValue', [1, 2]), 1);
%!assert_equal (lookup (CV, string ('a')), {1})
%!assert_equal (lookup (CV, string ({'a'; 'z'}), 'FallbackValue', {5}), {1; 5})
%!test
%! d = dictionary (string ('f'), @sin);
%! assert_equal (lookup (d, string ('z'), 'FallbackValue', @cos), @cos);
%!test
%! d = dictionary ([1, 2], string ({'a', 'b'}));
%! v = lookup (d, [1, 3], 'FallbackValue', 'none');
%! assert_equal (v, string ({'a', 'none'}));
%!test
%! d = dictionary ([1, 2], datetime (2024, 1, [1, 2]));
%! v = lookup (d, [1, 3], 'FallbackValue', '2021-01-01');
%! assert_equal (datenum (v), datenum ([2024, 2021], 1, 1));
%!error<dictionary.lookup: invalid number of input arguments.> lookup (D)
%!error<dictionary.lookup: name-value arguments must be in pairs.> ...
%! lookup (D, string ('a'), 5)
%!error<dictionary.lookup: invalid optional paired argument.> ...
%! lookup (D, string ('a'), 'Foo', 1)
%!error<dictionary.lookup: key not found.> lookup (D, string ('z'))
%!error<dictionary.lookup: element 2 of the keys not found.> ...
%! lookup (D, string ({'a'; 'z'}))
%!error<dictionary.lookup: key not found.> lookup (D, 1)
%!error<dictionary.lookup: ':' is not supported; use 'keys' or 'values'.> ...
%! lookup (D, ':')
%!error<dictionary.lookup: unable to use 'cell' as key of a dictionary of 'double' keys.> ...
%! lookup (dictionary (1, 2), {1})
%!error<dictionary.lookup: unsupported input type 'table'.> ...
%! lookup (dictionary ({1}, 1), {table(1)})
%!error<dictionary.lookup: 'FallbackValue' must be a scalar.> ...
%! lookup (D, string ('z'), 'FallbackValue', [])
%!error<dictionary.lookup: 'FallbackValue' must be a scalar.> ...
%! lookup (D, string ('z'), 'FallbackValue', [-1; -2])
%!error<dictionary.lookup: unable to use 'cell' as value of a dictionary of 'double' values.> ...
%! lookup (D, string ('z'), 'FallbackValue', {1})
%!error<dictionary.lookup: unable to use 'double' as value of a dictionary of 'cell' values.> ...
%! lookup (CV, string ('z'), 'FallbackValue', 5)
%!error<dictionary.lookup: D is not configured.> ...
%! lookup (dictionary (), string ('z'), 'FallbackValue', 1)
%!error<dictionary.lookup: cannot join values of type 'function_handle'; look up each key separately.> ...
%! lookup (dictionary (string ('f'), @sin), string ({'f'; 'z'}), ...
%!         'FallbackValue', @cos)

%!assert_equal (keys (remove (D, string ('b'))), string ({'a'; 'c'}))
%!assert_equal (keys (remove (D, string ({'a', 'c'}))), string ('b'))
%!assert_equal (numEntries (remove (D, string ('zz'))), 3)
%!assert_equal (numEntries (remove (D, [])), 3)
%!assert_equal (keys (remove (D, {'b'})), string ({'a'; 'c'}))
%!assert_equal (numEntries (remove (D, 1)), 3)
%!test
%! d = remove (D, string ('a'));
%! d = insert (d, string ('a'), 1);
%! assert_equal (keys (d), string ({'b'; 'c'; 'a'}));
%!error<dictionary.remove: invalid number of input arguments.> remove (D)
%!error<dictionary.remove: D is not configured.> ...
%! remove (dictionary (), string ('a'))
%!error<dictionary.remove: unable to use 'cell' as key of a dictionary of 'double' keys.> ...
%! remove (dictionary ([1; 2], [3; 4]), {1})
%!error<dictionary.remove: unsupported input type 'table'.> ...
%! remove (dictionary ({1}, 1), {table(1)})
%!test
%! d = dictionary (datetime (2024, 1, [1, 2, 3]), [1, 2, 3]);
%! d = remove (d, datetime (2024, 1, 1));
%! d(datetime (2024, 1, 1)) = 4;
%! assert_equal (values (d), [2; 3; 4]);
%!test
%! d = dictionary (categorical ({'r', 'g'}), [1, 2]);
%! d = insert (d, categorical ({'g', 'b'}), [20, 3], 'Overwrite', false);
%! assert_equal (values (d), [1; 2; 3]);
%!test
%! d = dictionary (hours ([1, 2]), [10, 20]);
%! assert_equal (lookup (d, minutes (120)), 20);
%!test
%! s = entries (dictionary (missing, 1), 'struct');
%! assert_equal (class (s.Key), 'missing');
%! assert_equal (s.Value, 1);

%!test
%! e = entries (D);
%! assert_equal (istable (e), true);
%! assert_equal (e.Properties.VariableNames, {'Key', 'Value'});
%! assert_equal (e.Key, string ({'a'; 'b'; 'c'}));
%! assert_equal (e.Value, [1; 2; 3]);
%!test
%! e = entries (D, 'TABLE');
%! assert_equal (size (e), [3, 2]);
%!test
%! e = entries (D, 'struct');
%! assert_equal (size (e), [3, 1]);
%! assert_equal (e(2).Key, string ('b'));
%! assert_equal (e(2).Value, 2);
%!test
%! e = entries (D, 's');
%! assert_equal (fieldnames (e), {'Key'; 'Value'});
%!test
%! e = entries (D, 'Cell');
%! assert_equal (e, {string('a'), 1; string('b'), 2; string('c'), 3});
%!test
%! e = entries (configureDictionary ('string', 'double'));
%! assert_equal (size (e), [0, 2]);
%! assert_equal (e.Key, string (cell (0, 1)));
%! assert_equal (e.Value, zeros (0, 1));
%!test
%! e = entries (configureDictionary ('string', 'double'), 'struct');
%! assert_equal (size (e), [0, 1]);
%! assert_equal (fieldnames (e), {'Key'; 'Value'});
%!assert_equal (entries (configureDictionary ('string', 'double'), 'cell'), ...
%!              cell (0, 2))
%!test
%! e = entries (dictionary ({'a'; 'b'}, [1; 2]));
%! assert_equal (e.Key, {'a'; 'b'});
%!test
%! e = entries (CV);
%! assert_equal (e.Value, {1; 'two'});
%!test
%! e = entries (CV, 'struct');
%! assert_equal (e(2).Value, {'two'});
%!test
%! e = entries (CV, 'cell');
%! assert_equal (e{2,2}, {'two'});
%!test
%! e = entries (dictionary (string ({'f'; 'g'}), {@sin; @cos}));
%! assert_equal (e.Value, {@sin; @cos});
%!test
%! e = entries (dictionary (string ('t'), table (1)));
%! assert_equal (istable (e.Value), true);
%!test
%! e = entries (dictionary (string ('f'), @sin), 'struct');
%! assert_equal (e.Value, @sin);
%!error<dictionary.entries: FORMAT must be a character vector or a string scalar.> ...
%! entries (D, 1)
%!error<dictionary.entries: invalid format 'foo'.> entries (D, 'foo')
%!error<dictionary.entries: D is not configured.> entries (dictionary ())
%!error<dictionary.entries: a table cannot hold these entries; use the 'cell' or 'struct' format.> ...
%! entries (dictionary (string ('f'), @sin))
%!error<dictionary.entries: a table cannot hold these entries; use the 'cell' or 'struct' format.> ...
%! entries (dictionary (@sin, 1))
%!error<dictionary.entries: a table cannot hold these entries; use the 'cell' or 'struct' format.> ...
%! entries (dictionary (string ('d'), dictionary (1, 2)))
%!error<dictionary.entries: a table cannot hold these entries; use the 'cell' or 'struct' format.> ...
%! entries (dictionary (string ('a'), struct ('x', 1), ...
%!                      string ('b'), struct ('y', 2)))

## The entry methods, measured on R2024a
%!shared k
%! k = dictionary (string ({'b', 'a', 'c'}), [2, 1, 3]);
%!assert_equal (keys (k), string ({'b'; 'a'; 'c'}))
%!assert_equal (values (k), [2; 1; 3])
%!assert_equal (keys (k, 'cell'), {string('b'); string('a'); string('c')})
%!assert_equal (values (k, 'cell'), {2; 1; 3})
%!assert_equal (keys (k, 'Cell'), {string('b'); string('a'); string('c')})
%!assert_equal (keys (k, 'c'), {string('b'); string('a'); string('c')})
%!assert_equal (keys (k, 'uniform'), string ({'b'; 'a'; 'c'}))
%!assert_equal (keys (k, 'u'), string ({'b'; 'a'; 'c'}))
%!error<dictionary.keys: invalid format 'x'.> ...
%! keys (k, 'x');
%!error<dictionary.keys: FORMAT must be a character vector or a string scalar.> ...
%! keys (k, 5);
%!assert_equal (values (k, 'un'), [2; 1; 3])
%!test
%! r = entries (k);
%! tb1 = r;
%! assert_equal (size (tb1), [3, 2]);
%! assert_equal (tb1.Properties.VariableNames, {'Key', 'Value'});
%! assert_equal (tb1.Key, string ({'b'; 'a'; 'c'}));
%! assert_equal (tb1.Value, [2; 1; 3]);
%!test
%! r = entries (k, 'struct');
%! assert_equal (size (r), [3, 1]);
%! assert_equal (fieldnames (r), {'Key'; 'Value'});
%! assert_equal (r(1).Key, string ('b'));
%! assert_equal (r(1).Value, 2);
%! assert_equal (r(2).Key, string ('a'));
%! assert_equal (r(2).Value, 1);
%! assert_equal (r(3).Key, string ('c'));
%! assert_equal (r(3).Value, 3);
%!test
%! r = entries (k, 'cell');
%! assert_equal (r, {string('b'), 2; string('a'), 1; string('c'), 3});
%!test
%! r = entries (k, 'table');
%! tb1 = r;
%! assert_equal (size (tb1), [3, 2]);
%! assert_equal (tb1.Properties.VariableNames, {'Key', 'Value'});
%! assert_equal (tb1.Key, string ({'b'; 'a'; 'c'}));
%! assert_equal (tb1.Value, [2; 1; 3]);
%!test
%! r = entries (k, 'S');
%! assert_equal (size (r), [3, 1]);
%! assert_equal (fieldnames (r), {'Key'; 'Value'});
%! assert_equal (r(1).Key, string ('b'));
%! assert_equal (r(1).Value, 2);
%! assert_equal (r(2).Key, string ('a'));
%! assert_equal (r(2).Value, 1);
%! assert_equal (r(3).Key, string ('c'));
%! assert_equal (r(3).Value, 3);
%!error<dictionary.entries: invalid format 'x'.> ...
%! entries (k, 'x');
%!assert_equal (isKey (k, string ('a')), true)
%!test
%! r = isKey (k, string ({'a', 'z'; 'c', 'b'}));
%! assert_equal (r, [true, false; true, true]);
%!assert_equal (isKey (k, 'a'), true)
%!assert_equal (isKey (k, {'a', 'z'}), [true, false])
%!assert_equal (isKey (k, 1), false)
%!assert_equal (isKey (k, []), false (0, 0))
%!assert_equal (isKey (k, missing), false)
%!assert_equal (isKey (k, string (missing)), false)
%!error<dictionary.isKey: invalid number of input arguments.> ...
%! isKey (k);
%!assert_equal (types (k), string ('string'))
%!assert_equal (numEntries (k), 3)
%!assert_equal (lookup (k, string ('a')), 1)
%!assert_equal (lookup (k, string ({'c', 'a'})), [3, 1])
%!assert_equal (lookup (k, string ({'c', 'a'; 'b', 'b'})), [3, 1; 2, 2])
%!error<dictionary.lookup: key not found.> ...
%! lookup (k, string ('z'));
%!assert_equal (lookup (k, string ({'a', 'z'}), 'FallbackValue', -1), [1, -1])
%!assert_equal (lookup (k, string ({'a', 'z'}), 'fallbackvalue', -1), [1, -1])
%!test
%! r = lookup (k, string ({'z', 'y'}), 'FallbackValue', NaN);
%! assert_equal (r, [NaN, NaN]);
%!assert_equal (lookup (k, string ('a'), 'FallbackValue', 'x'), 1)
%!assert_equal (lookup (k, string ('z'), 'FallbackValue', 'x'), 120)
%!error<dictionary.lookup: 'FallbackValue' must be a scalar.> ...
%! lookup (k, string ('z'), 'FallbackValue', [1, 2]);
%!error<dictionary.lookup: 'FallbackValue' must be a scalar.> ...
%! lookup (k, string ('z'), 'FallbackValue', []);
%!assert_equal (lookup (k, string ('z'), 'FallbackValue', int8 (4)), 4)
%!error<dictionary.lookup: name-value arguments must be in pairs.> ...
%! lookup (k, string ('z'), 'FallbackValue');
%!error<dictionary.lookup: invalid optional paired argument.> ...
%! lookup (k, string ('z'), 'Foo', 1);
%!assert_equal (lookup (k, []), zeros (0, 0))
%!assert_equal (lookup (k, 'a'), 1)
%!error<dictionary.lookup: invalid number of input arguments.> ...
%! lookup (k);
%!error<dictionary.lookup: ':' is not supported; use 'keys' or 'values'.> ...
%! lookup (k, ':');
%!test
%! cv = dictionary (string ({'a', 'b'}), {1, 'two'});
%! r = lookup (cv, string ({'a', 'z'}), 'FallbackValue', {0});
%! assert_equal (r, {1, 0});
%!error<dictionary.lookup: unable to use 'double' as value of a dictionary of 'cell' values.> ...
%! cv = dictionary (string ({'a', 'b'}), {1, 'two'});
%! lookup (cv, string ('z'), 'FallbackValue', 0);
%!test
%! k2 = insert (k, string ('d'), 4);
%! assert_equal (keys (k2), string ({'b'; 'a'; 'c'; 'd'}));
%!test
%! k2 = insert (k, string ('a'), 100);
%! assert_equal (values (k2), [2; 100; 3]);
%!test
%! k2 = insert (k, string ({'a', 'e'}), [100, 5], 'Overwrite', false);
%! assert_equal (values (k2), [2; 1; 3; 5]);
%!test
%! k2 = insert (k, string ({'e', 'e'}), [5, 6], 'Overwrite', false);
%! assert_equal (values (k2), [2; 1; 3; 5]);
%!test
%! k2 = insert (k, string ({'e', 'e'}), [5, 6]);
%! assert_equal (values (k2), [2; 1; 3; 6]);
%!test
%! k2 = insert (k, string ({'e', 'f'}), 7);
%! assert_equal (values (k2), [2; 1; 3; 7; 7]);
%!error<dictionary.insert: KEYS and VALUES must be the same size, or VALUES a scalar.> ...
%! k2 = insert (k, string ({'e', 'f'}), [1, 2, 3]);
%!test
%! k2 = insert (k, string ('e'), 1, 'overwrite', 0);
%! assert_equal (keys (k2), string ({'b'; 'a'; 'c'; 'e'}));
%!error<dictionary.insert: 'Overwrite' must be a logical scalar.> ...
%! k2 = insert (k, string ('e'), 1, 'Overwrite', 'no');
%!error<dictionary.insert: 'Overwrite' must be a logical scalar.> ...
%! k2 = insert (k, string ('e'), 1, 'Overwrite', [true, true]);
%!error<dictionary.insert: invalid number of input arguments.> ...
%! k2 = insert (k, string ('e'));
%!test
%! k2 = insert (k, [], []);
%! assert_equal (numEntries (k2), 3);
%!test
%! k2 = insert (dictionary (), string ('a'), 1);
%! r = k2;
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'string', 'double'}));
%! assert_equal (numEntries (r), 1);
%! assert_equal (keys (r, 'cell'), {string('a')});
%! assert_equal (values (r, 'cell'), {1});
%!test
%! k2 = insert (k, 5, 6);
%! assert_equal (keys (k2), string ({'b'; 'a'; 'c'; '5'}));
%!test
%! k2 = remove (k, string ('a'));
%! assert_equal (keys (k2), string ({'b'; 'c'}));
%!test
%! k2 = remove (k, string ({'a', 'z'}));
%! assert_equal (keys (k2), string ({'b'; 'c'}));
%!test
%! k2 = remove (k, string ({'a', 'b', 'c'}));
%! r = k2;
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'string', 'double'}));
%! assert_equal (numEntries (r), 0);
%!test
%! k2 = remove (k, []);
%! assert_equal (numEntries (k2), 3);
%!test
%! k2 = remove (k, string ({'a', 'a'}));
%! assert_equal (keys (k2), string ({'b'; 'c'}));
%!test
%! k2 = remove (k, 'b');
%! assert_equal (keys (k2), string ({'a'; 'c'}));
%!error<dictionary.remove: invalid number of input arguments.> ...
%! k2 = remove (k);
%!error<dictionary.remove: D is not configured.> ...
%! k2 = remove (dictionary (), 1);
%!test
%! k2 = remove (configureDictionary ('double', 'double'), 1);
%! r = k2;
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'double'}));
%! assert_equal (numEntries (r), 0);
%!test
%! k2 = remove (k, string ('b'));
%! k2 = insert (k2, string ('b'), 9);
%! assert_equal (keys (k2), string ({'a'; 'c'; 'b'}));
%!test
%! k2 = remove (k, string ({'a', 'b', 'c'}));
%! k2 = insert (k2, string ('z'), 1);
%! r = k2;
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'string', 'double'}));
%! assert_equal (numEntries (r), 1);
%! assert_equal (keys (r, 'cell'), {string('z')});
%! assert_equal (values (r, 'cell'), {1});

################################################################################
##                               ** Files **                                  ##
################################################################################
##                             Available Methods                              ##
##                                                                            ##
## 'writedictionary'                                                          ##
##                                                                            ##
################################################################################

## Write D to a temporary file, return its text, and delete the file
%!function s = wj (d, varargin)
%!  s = wjx (d, '.json', varargin{:});
%!endfunction
%!function s = wjx (d, ext, varargin)
%!  f = [tempname() ext];
%!  unwind_protect
%!    writedictionary (d, f, varargin{:});
%!    s = fileread (f);
%!  unwind_protect_cleanup
%!    if (exist (f, 'file'))
%!      delete (f);
%!    endif
%!  end_unwind_protect
%!endfunction

## Measured on MATLAB Online R2026b
%!test
%! s = wj (dictionary (string ({'a', 'b'}), [1, 2]));
%! assert_equal (s, ...
%!               strjoin ({'{', '    "a": 1.0,', '    "b": 2.0', '}'}, "\n"));
%!test
%! s = wj (dictionary (string ({'a', 'b'}), [1, 2]), 'PrettyPrint', false);
%! assert_equal (s, '{"a":1.0,"b":2.0}');
%!test
%! s = wj (dictionary (string ({'a', 'b', 'c', 'd'}), [1.5, pi, 0.1, 1e20]), ...
%!         'PrettyPrint', false);
%! assert_equal (s, ...
%!               ['{"a":1.5,"b":3.141592653589793,"c":0.1,', ...
%!                '"d":100000000000000000000.0}']);
%!test
%! s = wj (dictionary (string ({'a', 'b', 'c'}), [-0, 1, -7]), ...
%!         'PrettyPrint', false);
%! assert_equal (s, '{"a":-0.0,"b":1.0,"c":-7.0}');
%!test
%! s = wj (dictionary (string ({'a', 'b', 'c'}), [NaN, Inf, -Inf]), ...
%!         'PrettyPrint', false);
%! assert_equal (s, '{"a":NaN,"b":Infinity,"c":-Infinity}');
%!test
%! s = wj (dictionary (string ({'a', 'b', 'c'}), [NaN, Inf, -Inf]), ...
%!         'PrettyPrint', false, 'PreserveInfAndNaN', false);
%! assert_equal (s, '{"a":null,"b":null,"c":null}');
%!test
%! s = wj (dictionary (string ({'a', 'b'}), [string('x'), string(missing)]), ...
%!         'PrettyPrint', false);
%! assert_equal (s, '{"a":"x","b":null}');
%!test
%! s = wj (dictionary (string ({'a', 'b'}), [true, false]), 'PrettyPrint', ...
%!         false);
%! assert_equal (s, '{"a":true,"b":false}');
%!test
%! s = wj (dictionary (string ({'a', 'b'}), int8 ([5, -3])), 'PrettyPrint', ...
%!         false);
%! assert_equal (s, '{"a":5,"b":-3}');
%!test
%! s = wj (dictionary ('a', intmax ('int64')), 'PrettyPrint', false);
%! assert_equal (s, '{"a":9223372036854775807}');
%!test
%! s = wj (dictionary ('a', intmax ('uint64')), 'PrettyPrint', false);
%! assert_equal (s, '{"a":18446744073709551615}');
%!test
%! s = wj (dictionary (string ({'a', 'b'}), single ([1.5, 0.1])), ...
%!         'PrettyPrint', false);
%! assert_equal (s, '{"a":1.5,"b":0.10000000149011612}');
%!test
%! s = wj (dictionary (string ({'a', 'b'}), datetime (2024, 1, [1, 2])), ...
%!         'PrettyPrint', false);
%! assert_equal (s, '{"a":"01-Jan-2024","b":"02-Jan-2024"}');
%!test
%! s = wj (dictionary ('a', datetime (2024, 1, 1, 'TimeZone', 'UTC')), ...
%!         'PrettyPrint', false);
%! assert_equal (s, '{"a":"01-Jan-2024"}');
%!assert_equal (wj (dictionary ('a', NaT), 'PrettyPrint', false), '{"a":null}')
%!test
%! s = wj (dictionary (string ({'a', 'b'}), hours ([1, 2])), 'PrettyPrint', ...
%!         false);
%! assert_equal (s, '{"a":"1 hr","b":"2 hr"}');
%!error<dictionary.writedictionary: unable to write values of type 'calendarDuration' to JSON.> ...
%! wj (dictionary ('a', calmonths (1)), 'PrettyPrint', false);
%!error<dictionary.writedictionary: unable to write values of type 'categorical' to JSON.> ...
%! wj (dictionary (string ({'a', 'b'}), categorical (string ({'r', 'g'}))), ...
%!     'PrettyPrint', false);
%!test
%! s = wj (dictionary (string ({'a', 'b', 'c', 'd', 'e'}), ...
%!                     {1, 'x', [1, 2, 3], {3, 'y'}, []}), 'PrettyPrint', ...
%!         false);
%! assert_equal (s, '{"a":1.0,"b":"x","c":[1.0,2.0,3.0],"d":[3.0,"y"],"e":[]}');
%!error<dictionary.writedictionary: unable to write matrices to JSON.> ...
%! wj (dictionary ('a', {[1, 2;, 3, 4]}), 'PrettyPrint', false);
%!test
%! s = wj (dictionary ('a', {true}), 'PrettyPrint', false);
%! assert_equal (s, '{"a":true}');
%!test
%! s = wj (dictionary ('a', {missing}), 'PrettyPrint', false);
%! assert_equal (s, '{"a":null}');
%!assert_equal (wj (dictionary ('a', {NaN}), 'PrettyPrint', false), '{"a":NaN}')
%!error<dictionary.writedictionary: unable to write values of type 'struct' to JSON.> ...
%! wj (dictionary ('a', struct ('x', 1, 'y', 's')), 'PrettyPrint', false);
%!error<dictionary.writedictionary: unable to write values of type 'struct' to JSON.> ...
%! wj (dictionary ('a', {struct('x', {1, 2})}), 'PrettyPrint', false);
%!test
%! s = wj (dictionary ('a', dictionary (string ({'x', 'y'}), [1, 2])), ...
%!         'PrettyPrint', false);
%! assert_equal (s, '{"a":{"x":1.0,"y":2.0}}');
%!test
%! s = wj (dictionary ('a', dictionary (1, 2)), 'PrettyPrint', false);
%! assert_equal (s, '{"a":{"1":2.0}}');
%!test
%! s = wj (dictionary ('a', {dictionary('x', 1)}), 'PrettyPrint', false);
%! assert_equal (s, '{"a":{"x":1.0}}');
%!test
%! s = wj (dictionary ('a', missing), 'PrettyPrint', false);
%! assert_equal (s, '{"a":null}');
%!error<dictionary.writedictionary: unable to write values of type 'function_handle' to JSON.> ...
%! wj (dictionary ('a', @sin), 'PrettyPrint', false);
%!error<dictionary.writedictionary: unable to write values of type 'table' to JSON.> ...
%! wj (dictionary ('a', table (1)), 'PrettyPrint', false);
%!test
%! s = wj (dictionary ([1, 2], [3, 4]), 'PrettyPrint', false);
%! assert_equal (s, '{"1":3.0,"2":4.0}');
%!test
%! s = wj (dictionary ([1.5, -2], [3, 4]), 'PrettyPrint', false);
%! assert_equal (s, '{"1.5":3.0,"-2":4.0}');
%!test
%! s = wj (dictionary ([true, false], [3, 4]), 'PrettyPrint', false);
%! assert_equal (s, '{"true":3.0,"false":4.0}');
%!test
%! s = wj (dictionary (int8 ([1, 2]), [3, 4]), 'PrettyPrint', false);
%! assert_equal (s, '{"1":3.0,"2":4.0}');
%!test
%! s = wj (dictionary (datetime (2024, 1, [1, 2]), [3, 4]), 'PrettyPrint', ...
%!         false);
%! assert_equal (s, '{"01-Jan-2024":3.0,"02-Jan-2024":4.0}');
%!test
%! s = wj (dictionary (hours ([1, 2]), [3, 4]), 'PrettyPrint', false);
%! assert_equal (s, '{"1 hr":3.0,"2 hr":4.0}');
%!error<dictionary.writedictionary: unable to write keys of type 'categorical' to JSON.> ...
%! wj (dictionary (categorical (string ({'r', 'g'})), [3, 4]), ...
%!     'PrettyPrint', false);
%!test
%! s = wj (dictionary ({'a' 'b'}, [3, 4]), 'PrettyPrint', false);
%! assert_equal (s, '{"a":3.0,"b":4.0}');
%!error<dictionary.writedictionary: unable to write keys of type 'missing' to JSON.> ...
%! wj (dictionary (missing, 1), 'PrettyPrint', false);
%!error<dictionary.writedictionary: unable to write a missing string key to JSON.> ...
%! wj (dictionary ([string('a'), string(missing)], [1, 2]), 'PrettyPrint', ...
%!     false);
%!test
%! s = wj (dictionary (string ({'', 'a'}), [1, 2]), 'PrettyPrint', false);
%! assert_equal (s, '{"":1.0,"a":2.0}');
%!test
%! s = wj (dictionary ([string('a"b'), string(sprintf ('c\nd')), ...
%!                      string('é')], [1, 2, 3]), 'PrettyPrint', false);
%! assert_equal (s, '{"a\"b":1.0,"c\nd":2.0,"é":3.0}');
%!assert_equal (wj (dictionary, 'PrettyPrint', false), '{}')
%!test
%! s = wj (configureDictionary ('string', 'double'), 'PrettyPrint', false);
%! assert_equal (s, '{}');
%!test
%! s = wj (dictionary (string ({'a', 'b'}), {1, {}}));
%! assert_equal (s, strjoin ({'{', '    "a": 1.0,', '    "b": []', '}'}, "\n"));
%!test
%! s = wj (dictionary ('a', dictionary ('b', dictionary ('c', 1))));
%! assert_equal (s, ...
%!               strjoin ({'{', '    "a": {', '        "b": {', ...
%!                         '            "c": 1.0', '        }', '    }', ...
%!                         '}'}, "\n"));
%!error<dictionary.writedictionary: unable to tell the file type from the extension; set 'FileType'.> ...
%! wjx (dictionary (string ({'a', 'b'}), [1, 2]), '.txt');
%!test
%! s = wjx (dictionary (string ({'a', 'b'}), [1, 2]), '.txt', 'FileType', ...
%!          'json');
%! assert_equal (s, ...
%!               strjoin ({'{', '    "a": 1.0,', '    "b": 2.0', '}'}, "\n"));
%!test
%! s = wj (dictionary (string ({'a', 'b'}), [1, 2]), 'prettyprint', false);
%! assert_equal (s, '{"a":1.0,"b":2.0}');
%!error<dictionary.writedictionary: 'PrettyPrint' must be a logical scalar.> ...
%! wj (dictionary (string ({'a', 'b'}), [1, 2]), 'PrettyPrint', 'yes');
%!error<dictionary.writedictionary: invalid optional paired argument.> ...
%! wj (dictionary (string ({'a', 'b'}), [1, 2]), 'Foo', 1);
%!test
%! s = wj (dictionary ('a', ...
%!                     datetime (2024, 1, 1, 10, 0, 0, 'Format', ...
%!                               'yyyy-MM-dd''T''HH:mm:ss')), 'PrettyPrint', ...
%!         false);
%! assert_equal (s, '{"a":"2024-01-01T10:00:00"}');
%!test
%! s = wj (dictionary ('a', seconds (90)), 'PrettyPrint', false);
%! assert_equal (s, '{"a":"90 sec"}');
%!test
%! s = wj (dictionary ('a', {{'x', 1, true}}), 'PrettyPrint', false);
%! assert_equal (s, '{"a":["x",1.0,true]}');
%!test
%! s = wj (dictionary ('a', {[1, 2, 3]'}), 'PrettyPrint', false);
%! assert_equal (s, '{"a":[1.0,2.0,3.0]}');
%!test
%! s = wj (dictionary ('a', {string({'x', 'y'})}), 'PrettyPrint', false);
%! assert_equal (s, '{"a":["x","y"]}');
%!test
%! s = wj (dictionary ('a', {{'x' 'y'}}), 'PrettyPrint', false);
%! assert_equal (s, '{"a":["x","y"]}');
%!test
%! s = wj (dictionary ('a', {zeros(1, 0)}), 'PrettyPrint', false);
%! assert_equal (s, '{"a":[]}');
%!test
%! s = wj (dictionary ('a', {int8([1, 2])}), 'PrettyPrint', false);
%! assert_equal (s, '{"a":[1,2]}');
%!test
%! s = wj (dictionary ('a', {datetime(2024, 1, [1, 2])}), 'PrettyPrint', false);
%! assert_equal (s, '{"a":["01-Jan-2024","02-Jan-2024"]}');

## Complex values are refused wherever they are (R2026b crashes)
%!error<dictionary.writedictionary: unable to write complex values to JSON.> ...
%! wj (dictionary ('a', 1+2i));
%!error<dictionary.writedictionary: unable to write complex values to JSON.> ...
%! wj (dictionary ('a', {1+2i}));
%!error<dictionary.writedictionary: unable to write complex values to JSON.> ...
%! wj (dictionary ('a', {{1, 2i}}));
%!error<dictionary.writedictionary: unable to write complex values to JSON.> ...
%! wj (dictionary ('a', dictionary ('b', 3i)));
%!error<dictionary.writedictionary: unable to write complex values to JSON.> ...
%! wj (dictionary (1+2i, 1));

## Ours: the number layout beyond what R2026b showed, after RapidJSON
%!test
%! d = dictionary (string ({'a', 'b', 'c', 'd', 'e', 'f'}), ...
%!                 [1e21, 1e-7, 1e-6, 1.5e300, -1e-5, 2^53]);
%! s = wj (d, 'PrettyPrint', false);
%! assert_equal (s, ['{"a":1e21,"b":1e-7,"c":0.000001,"d":1.5e300,', ...
%!                   '"e":-0.00001,"f":9007199254740992.0}']);
%!test
%! s = wj (dictionary ('a', intmin ('int64')), 'PrettyPrint', false);
%! assert_equal (s, '{"a":-9223372036854775808}');
%!test
%! s = wj (dictionary ('a', uint8 (255)), 'PrettyPrint', false);
%! assert_equal (s, '{"a":255}');
%!test
%! d = dictionary (string ({'a', 'b'}), seconds ([90, NaN]));
%! assert_equal (wj (d, 'PrettyPrint', false), '{"a":"90 sec","b":null}');
%!test
%! s = wj (dictionary ('a', [char(1), 'b', char(8), char(12), '/']), ...
%!         'PrettyPrint', false);
%! assert_equal (s, '{"a":"\u0001b\b\f/"}');

## Ours: arrays and empty objects when indented
%!test
%! s = wj (dictionary ('a', {[1, 2]}));
%! assert_equal (s, strjoin ({'{', '    "a": [', '        1.0,', ...
%!                            '        2.0', '    ]', '}'}, "\n"));
%!test
%! s = wj (dictionary ('a', {{1, {}}}));
%! assert_equal (s, strjoin ({'{', '    "a": [', '        1.0,', ...
%!                            '        []', '    ]', '}'}, "\n"));
%!test
%! s = wj (dictionary ('a', dictionary ()));
%! assert_equal (s, strjoin ({'{', '    "a": {}', '}'}, "\n"));
%!assert_equal (wj (dictionary ()), '{}')

## Ours: keys of NaN, Inf and NaT
%!test
%! s = wj (dictionary ([NaN, Inf], [1, 2]), 'PrettyPrint', false);
%! assert_equal (s, '{"NaN":1.0,"Inf":2.0}');
%!assert_equal (wj (dictionary (NaT, 1), 'PrettyPrint', false), '{"NaT":1.0}')
%!test
%! s = wj (dictionary (single (0.5), 1), 'PrettyPrint', false);
%! assert_equal (s, '{"0.5":1.0}');
%!error<dictionary.writedictionary: unable to write keys of type 'cell' to JSON.> ...
%! wj (dictionary ({1}, 2));

## Ours: the file is replaced, and the method can be called with '.'
%!test
%! f = [tempname() '.json'];
%! unwind_protect
%!   writedictionary (dictionary (string ({'a', 'b'}), [1, 2]), f);
%!   d = dictionary ('z', 9);
%!   d.writedictionary (f, 'PrettyPrint', false);
%!   assert_equal (fileread (f), '{"z":9.0}');
%! unwind_protect_cleanup
%!   delete (f);
%! end_unwind_protect

## Ours: options and locations
%!error<dictionary.writedictionary: FILENAME must be a character vector or a string scalar.> ...
%! writedictionary (dictionary ('a', 1), 5);
%!error<dictionary.writedictionary: FILENAME must be a character vector or a string scalar.> ...
%! writedictionary (dictionary ('a', 1));
%!error<dictionary.writedictionary: name-value arguments must be in pairs.> ...
%! wj (dictionary ('a', 1), 'PrettyPrint');
%!error<dictionary.writedictionary: 'PreserveInfAndNaN' must be a logical scalar.> ...
%! wj (dictionary ('a', 1), 'PreserveInfAndNaN', 'yes');
%!error<dictionary.writedictionary: invalid 'FileType' value 'xml'.> ...
%! wj (dictionary ('a', 1), 'FileType', 'xml');
%!error<dictionary.writedictionary: 'FileType' must be a character vector or a string scalar.> ...
%! wj (dictionary ('a', 1), 'FileType', 5);
%!error<dictionary.writedictionary: writing to remote locations is not supported.> ...
%! writedictionary (dictionary ('a', 1), 's3://bucket/x.json');
%!error<dictionary.writedictionary: writing to remote locations is not supported.> ...
%! writedictionary (dictionary ('a', 1), 'https://example.org/x.json');

## Round trips through readdictionary, as on R2026b
%!test
%! d0 = dictionary ('a', dictionary (string ({'x', 'y'}), {1, 'x'}));
%! f = [tempname() '.json'];
%! unwind_protect
%!   writedictionary (d0, f);
%!   assert_equal (isequal (d0, readdictionary (f)), false);
%! unwind_protect_cleanup
%!   delete (f);
%! end_unwind_protect
%!test
%! d0 = dictionary (string ({'a', 'b'}), {[1, 2, 3], 's'});
%! f = [tempname() '.json'];
%! unwind_protect
%!   writedictionary (d0, f);
%!   v = values (readdictionary (f), 'cell');
%!   assert_equal (v{1}, {{1; 2; 3}});
%! unwind_protect_cleanup
%!   delete (f);
%! end_unwind_protect
%!test
%! d0 = dictionary (string ({'a', 'b'}), datetime (2024, 1, [1, 2]));
%! f = [tempname() '.json'];
%! unwind_protect
%!   writedictionary (d0, f);
%!   d1 = readdictionary (f);
%!   assert_equal (datenum (values (d1)), datenum (2024, 1, [1; 2]));
%! unwind_protect_cleanup
%!   delete (f);
%! end_unwind_protect

## OpenDocument spreadsheets, an extension of this package
%!test
%! d = dictionary (string ({'Sales', 'Q 2024'}), ...
%!                 {table([1; 2]), timetable(hours ([1; 2]), [3; 4])});
%! f = [tempname() '.ods'];
%! unwind_protect
%!   writedictionary (d, f);
%!   r = readdictionary (f);
%!   assert_equal (keys (r), string ({'Sales'; 'Q 2024'}));
%!   assert_equal (r{string('Sales')}.Var1, [1; 2]);
%!   assert_equal (class (r{string('Q 2024')}), 'timetable');
%! unwind_protect_cleanup
%!   delete (f);
%! end_unwind_protect
%!test
%! d = dictionary ('t', table (1));
%! f = [tempname() '.fods'];
%! unwind_protect
%!   writedictionary (d, f);
%!   [~, vt] = types (readdictionary (f));
%!   assert_equal (vt, string ('table'));
%! unwind_protect_cleanup
%!   delete (f);
%! end_unwind_protect
%!error<dictionary.writedictionary: only tables and timetables can be written to ODS files.> ...
%! wjx (dictionary ('x', 1), '.ods');
%!error<dictionary.writedictionary: the keys must be text to name the sheets of an ODS file.> ...
%! wjx (dictionary (1, table (1)), '.ods');
%!error<dictionary.writedictionary: a dictionary with no entries has no sheets to write.> ...
%! wjx (configureDictionary ('string', 'table'), '.ods');
%!error<dictionary.writedictionary: 'PrettyPrint' does not apply to ODS files.> ...
%! wjx (dictionary ('x', table (1)), '.ods', 'PrettyPrint', false);
%!error<dictionary.writedictionary: 'PreserveInfAndNaN' does not apply to ODS files.> ...
%! wjx (dictionary ('x', table (1)), '.ods', 'PreserveInfAndNaN', false);

################################################################################
##                         ** Compare and hash **                             ##
################################################################################
##                             Available Methods                              ##
##                                                                            ##
## 'isequal'          'isequaln'         'keyHash'                            ##
##                                                                            ##
################################################################################

%!shared D1, D2, D4, D5, D6
%! D1 = dictionary (string ({'a'; 'b'}), [1; 2]);
%! D2 = dictionary (string ({'b'; 'a'}), [2; 1]);
%! D4 = dictionary (string ({'a'; 'b'}), [1; 2]);
%! D5 = dictionary (string ({'a'; 'b'}), [1; 3]);
%! D6 = dictionary (string ({'a'; 'b'}), int8 ([1; 2]));

%!assert_equal (isequal (D1, D2), true)
%!assert_equal (isequal (D1, D4, D2), true)
%!assert_equal (isequal (D1, D5), false)
%!assert_equal (isequal (D1, D6), true)
%!assert_equal (isequal (D1, 5), false)
%!assert_equal (isequal (5, D1), false)
%!assert_equal (isequal (dictionary (string ('a'), 1), ...
%!                       dictionary (1, 1)), false)
%!assert_equal (isequal (dictionary (string ('a'), NaN), ...
%!                       dictionary (string ('a'), NaN)), false)
%!assert_equal (isequal (dictionary (string ({'a'; 'b'}), {1; 2}), ...
%!                       dictionary (string ({'b'; 'a'}), {2; 1})), true)
%!assert_equal (isequal (dictionary (), dictionary ()), true)
%!assert_equal (isequal (dictionary (), ...
%!                       configureDictionary ('string', 'double')), false)
%!assert_equal (isequal (configureDictionary ('string', 'double'), ...
%!                       configureDictionary ('string', 'int8')), true)
%!assert_equal (isequal (configureDictionary ('double', 'double'), ...
%!                       configureDictionary ('string', 'double')), false)
%!assert_equal (isequal (dictionary (string (cell (0, 0)), []), ...
%!                       configureDictionary ('string', 'double')), true)
%!error<dictionary.isequal: invalid number of input arguments.> isequal (D1)

%!assert_equal (isequaln (dictionary (string ('a'), NaN), ...
%!                        dictionary (string ('a'), NaN)), true)
%!assert_equal (isequaln (D1, D2), true)
%!assert_equal (isequaln (D1, D4, D5), false)
%!error<dictionary.isequaln: invalid number of input arguments.> isequaln (D1)

%!assert_equal (class (keyHash (D1)), 'uint64')
%!assert_equal (keyHash (D1) == keyHash (D4), true)
%!assert_equal (keyHash (D1) == keyHash (D2), false)
%!assert_equal (keyHash (D1) == keyHash (D5), false)
%!assert_equal (keyHash (D1) == keyHash (D6), false)
%!assert_equal (keyHash (D1, uint64 (5)) == keyHash (D1), false)
%!assert_equal (keyMatch (D1, D4), true)
%!assert_equal (keyMatch (D1, D2), false)
%!assert_equal (keyMatch (D1, D6), false)
%!assert_equal (keyMatch (dictionary (string ('a'), NaN), ...
%!                        dictionary (string ('a'), NaN)), true)
%!assert_equal (keyMatch (dictionary (), dictionary ()), true)
%!assert_equal (keyMatch (dictionary (), ...
%!                        configureDictionary ('string', 'double')), false)
%!assert_equal (keyMatch (configureDictionary ('string', 'double'), ...
%!                        configureDictionary ('string', 'int8')), false)
%!assert_equal (class (keyHash (dictionary (string ('f'), @sin))), 'uint64')
%!assert_equal (D1.keyHash () == keyHash (D1), true)
%!error<dictionary.keyHash: BASE must be a UINT64 scalar.> keyHash (D1, 5)
%!error<keyHash: unsupported input type 'table'.> ...
%! keyHash (dictionary (string ('t'), table (1)))

## Comparison and hashing, measured on R2024a
%!shared q1, q2, q3, q4, q5
%! q1 = dictionary (string ({'a', 'b'}), [1, 2]);
%! q2 = dictionary (string ({'b', 'a'}), [2, 1]);
%! q3 = dictionary (string ({'a', 'b'}), int8 ([1, 2]));
%! q4 = dictionary (string ({'a', 'b'}), [1, NaN]);
%! q5 = dictionary (string ({'a', 'b'}), [1, NaN]);
%!assert_equal (isequal (q1, q2), true)
%!assert_equal (isequal (q1, q3), true)
%!assert_equal (isequal (q4, q5), false)
%!assert_equal (isequaln (q4, q5), true)
%!assert_equal (isequal (q1, q1, q2), true)
%!assert_equal (isequal (q1, q2, q4), false)
%!assert_equal (isequal (q1, 5), false)
%!assert_equal (isequal (5, q1), false)
%!error<dictionary.isequal: invalid number of input arguments.> ...
%! isequal (q1);
%!assert_equal (isequaln (q1, q2, q3), true)
%!error<dictionary.isequaln: invalid number of input arguments.> ...
%! isequaln (q1);
%!assert_equal (keyHash (q1) == keyHash (q2), false)
%!assert_equal (keyHash (q1) == keyHash (q1), true)
%!assert_equal (keyHash (q1) == keyHash (q3), false)
%!assert_equal (keyMatch (q1, q2), false)
%!assert_equal (keyMatch (q1, q1), true)
%!assert_equal (keyMatch (q4, q5), true)
## keyHash takes a BASE, an extension of this package.
%!assert_equal (keyHash (q1, uint64 (5)) == keyHash (q1, uint64 (5)), true)
## keyHash takes a BASE, an extension of this package.
%!assert_equal (keyHash (q1, uint64 (5)) == keyHash (q1), false)
%!error<dictionary.keyHash: BASE must be a UINT64 scalar.> ...
%! keyHash (q1, 5);
%!assert_equal (isequal (dictionary (), dictionary ()), true)
%!test
%! r = isequal (dictionary (), configureDictionary ('double', 'double'));
%! assert_equal (r, false);
%!test
%! r = isequal (configureDictionary ('double', 'double'), ...
%!              configureDictionary ('string', 'double'));
%! assert_equal (r, false);
%!test
%! r = isequal (configureDictionary ('string', 'double'), ...
%!              configureDictionary ('string', 'int8'));
%! assert_equal (r, true);
%!test
%! r = isequal (dictionary ([1, 2], [3, 4]), ...
%!              dictionary (string ({'1', '2'}), [3, 4]));
%! assert_equal (r, false);
%!assert_equal (isequal (dictionary (1, {1}), dictionary (1, {1})), true)
%!test
%! r = isequal (dictionary (1, dictionary (1, 2)), ...
%!              dictionary (1, dictionary (1, 2)));
%! assert_equal (r, true);
%!assert_equal (isequal (dictionary (1, 2), dictionary (int8 (1), 2)), false)
%!assert_equal (keyHash (dictionary ()) == keyHash (dictionary ()), true)
%!test
%! r = keyHash (dictionary ()) == keyHash (configureDictionary ('double', ...
%!                                                              'double'));
%! assert_equal (r, false);
%!error<keyHash: unsupported input type 'table'.> ...
%! keyHash (dictionary (string ('t'), table (1)));
%!test
%! r = keyHash (dictionary (string ('f'), ...
%!                          @sin)) == keyHash (dictionary (string ('f'), @sin));
%! assert_equal (r, true);
%!test
%! r = keyMatch (dictionary ([1, 2], [3, 4]), ...
%!               dictionary ([1, 2], int8 ([3, 4])));
%! assert_equal (r, false);

################################################################################
##                    ** Indexing and concatenation **                        ##
################################################################################
##                             Available Methods                              ##
##                                                                            ##
## 'subsref'          'subsasgn'         'end'                                ##
## 'horzcat'          'vertcat'          'cat'                                ##
##                                                                            ##
################################################################################

%!shared D, CV, C
%! D = dictionary (string ({'a'; 'b'; 'c'}), [1; 2; 3]);
%! CV = dictionary (string ({'a'; 'b'}), {[1, 2, 3]; [4, 5]});
%! C = configureDictionary ('string', 'double');

%!assert_equal (D(string ('b')), 2)
%!assert_equal (D(string ({'c'; 'a'})), [3; 1])
%!assert_equal (D(string ({'a', 'b'; 'c', 'a'})), [1, 2; 3, 1])
%!assert_equal (D('a'), 1)
%!assert_equal (D({'a'}), 1)
%!assert_equal (D([]), zeros (0, 0))
%!assert_equal (D(string (cell (0, 1))), zeros (0, 1))
%!assert_equal (D(string ('a'))(1), 1)
%!assert_equal (CV{string('a')}, [1, 2, 3])
%!assert_equal (CV{string('a')}(2), 2)
%!test
%! [p, q] = CV{string({'a'; 'b'})};
%! assert_equal (p, [1, 2, 3]);
%! assert_equal (q, [4, 5]);
%!test
%! x = {CV{string({'b'; 'a'})}};
%! assert_equal (x, {[4, 5], [1, 2, 3]});
%!test
%! d = dictionary (string ({'a'; 'b'}), struct ('x', {1; 2}));
%! assert_equal (d(string ('b')).x, 2);
%!assert_equal (D.keys (), string ({'a'; 'b'; 'c'}))
%!assert_equal (D.keys ('cell'), {string('a'); string('b'); string('c')})
%!assert_equal (D.isKey (string ('a')), true)
%!assert_equal (D.numEntries, 3)
%!test
%! [kt, vt] = D.types ();
%! assert_equal (kt, string ('string'));
%! assert_equal (vt, string ('double'));
%!assert_equal (keys (D'), string ({'a'; 'b'; 'c'}))
## Key types
%!test
%! d = dictionary (missing, 1);
%! assert_equal (d(missing), 1);
%! assert_equal (class (keys (d)), 'missing');
%!test
%! d = dictionary ([missing, missing], [1, 2]);
%! assert_equal (numEntries (d), 1);
%! assert_equal (values (d), 2);
%!test
%! d = configureDictionary ('missing', 'double');
%! d(missing) = 4;
%! assert_equal (values (d), 4);
%!test
%! d = dictionary (dictionary (1, 2), 5);
%! assert_equal (d(dictionary (1, 2)), 5);
%! d(dictionary (1, 2)) = 6;
%! assert_equal (numEntries (d), 1);
%! assert_equal (values (d), 6);
%!test
%! d = dictionary (dictionary (1, 2), 5, dictionary (3, 4), 6);
%! assert_equal (size (keys (d, 'cell')), [2, 1]);
%!test
%! ## Dates with and without a time zone are different keys
%! z = dictionary (datetime (2024, 1, 1, 'TimeZone', 'UTC'), 1);
%! assert_equal (isKey (z, datetime (2024, 1, 1)), false);
%! z(datetime (2024, 1, 2)) = 2;
%! assert_equal (numEntries (z), 2);
%!test
%! u = dictionary (datetime (2024, 1, 1), 1);
%! assert_equal (isKey (u, datetime (2024, 1, 1, 'TimeZone', 'UTC')), false);
%!test
%! ## Text is read in the time zone of the keys, where MATLAB reads it in none
%! z = dictionary (datetime (2024, 1, 1, 'TimeZone', 'UTC'), 1);
%! assert_equal (z(string ('2024-01-01')), 1);
%! z(string ('2024-01-02')) = 2;
%! k = keys (z);
%! assert_equal (k.TimeZone, 'UTC');
%! assert_equal (numEntries (z), 2);
%!test
%! z = dictionary (datetime (2024, 1, 1, 'TimeZone', 'UTC'), 1);
%! ny = datetime (2023, 12, 31, 19, 0, 0, 'TimeZone', 'America/New_York');
%! z(ny) = 5;
%! assert_equal (numEntries (z), 1);
%! assert_equal (values (z), 5);
%!test
%! d = dictionary (datetime (2024, 1, 1), 1, ...
%!                 datetime (2024, 1, 1, 'Format', 'yyyy-MM-dd'), 2);
%! assert_equal (values (d), 2);
%!assert_equal (dictionary (single (1), 1)(int8 (1)), 1)
%!test
%! d = dictionary (int8 (1), 1);
%! d(NaN) = 2;
%! assert_equal (keys (d), int8 ([1; 0]));
%!test
%! d = dictionary (seconds (1), 1);
%! d(seconds (NaN)) = 2;
%! d(seconds (NaN)) = 3;
%! assert_equal (numEntries (d), 2);
%!test
%! d = dictionary (calmonths (1), 1);
%! d(calmonths (NaN)) = 2;
%! d(calmonths (NaN)) = 3;
%! assert_equal (numEntries (d), 2);
## Octave cannot tell d(:) from d(':'), so ':' is the key ":"
%!test
%! d = dictionary (string (':'), 1);
%! assert_equal (d(':'), 1);
%!test
%! d = dictionary (string ({'a', 'b'}), [1, 2]);
%! d(:) = 5;
%! assert_equal (keys (d), string ({'a'; 'b'; ':'}));
%!test
%! d = dictionary ([1, 2], [3, 4]);
%! d(:) = 9;
%! assert_equal (keys (d), [1; 2; 58]);
## Assigning into the contents of a new key starts from empty
%!test
%! d = dictionary (string ('a'), {1});
%! d{string('new')}(2) = 7;
%! assert_equal (d{string('new')}, [0, 7]);
%!test
%! d = dictionary (string ('a'), {1});
%! d{string('a')}(3) = 7;
%! assert_equal (d{string('a')}, [1, 0, 7]);
## A date value keeps its own time zone; a date key moves to that of the keys
%!test
%! d = dictionary (1, datetime (2024, 1, 1, 'TimeZone', 'UTC'));
%! d(2) = datetime (2024, 1, 2, 'TimeZone', 'Europe/Athens');
%! v = values (d, 'cell');
%! assert_equal (v{2}.TimeZone, 'Europe/Athens');
%!test
%! d = dictionary (1, datetime (2024, 1, 1, 'TimeZone', 'UTC'));
%! d(2) = datetime (2024, 1, 2);
%! v = values (d, 'cell');
%! assert_equal (v{2}.TimeZone, '');
%!error<dictionary.values: cannot join values of type 'datetime'; use the 'cell' format.> ...
%! d = dictionary (1, datetime (2024, 1, 1, 'TimeZone', 'UTC'));
%! d(2) = datetime (2024, 1, 2);
%! values (d);
## An array of objects of another class holds one value per element
%!test
%! d = dictionary ([1, 2], [timeseries([1; 2]), timeseries([3; 4; 5])]);
%! assert_equal (d(2).Data, [3; 4; 5]);
%!test
%! d = dictionary ([1, 2], tscollection (timeseries ([1; 2; 3])));
%! assert_equal (numEntries (d), 2);
%! assert_equal (class (d(2)), 'tscollection');
## Conversion by the function of the type's name, as in MATLAB
%!test
%! d = configureDictionary ('double', 'table');
%! d(1) = 5;
%! assert_equal (d(1).Var1, 5);
%!test
%! d = configureDictionary ('double', 'categorical');
%! d(1) = 5;
%! assert_equal (cellstr (d(1)), {'5'});
%!test
%! d = configureDictionary ('double', 'categorical');
%! d(1) = missing;
%! assert_equal (isundefined (d(1)), true);
%!test
%! d = configureDictionary ('double', 'string');
%! d([1, 2, 3]) = [hours(1), hours(2), hours(3)];
%! assert_equal (d(1), string ('1 hr'));
%!test
%! d = configureDictionary ('double', 'string');
%! d(1) = categorical ({'x'});
%! assert_equal (d(1), string ('x'));
%!test
%! d = configureDictionary ('double', 'string');
%! d(1) = calmonths (1);
%! assert_equal (d(1), string ('1mo'));
%!test
%! d = configureDictionary ('double', 'double');
%! d(1) = categorical ({'x'});
%! assert_equal (d(1), 1);
%!test
%! d = configureDictionary ('double', 'int8');
%! d(1) = categorical ({'x'});
%! assert_equal (d(1), int8 (1));
%!test
%! d = configureDictionary ('double', 'logical');
%! d(1) = 'x';
%! assert_equal (d(1), true);
%!test
%! d = configureDictionary ('double', 'datetime');
%! d(1) = missing;
%! assert_equal (isnat (d(1)), true);
%!test
%! d = configureDictionary ('double', 'duration');
%! d(1) = missing;
%! assert_equal (isnan (d(1)), true);
%!test
%! d = configureDictionary ('double', 'calendarDuration');
%! d(1) = missing;
%! assert_equal (isnan (d(1)), true);
%!test
%! d = configureDictionary ('string', 'double');
%! d(hours (1)) = 1;
%! assert_equal (keys (d), string ('1 hr'));
%!test
%! d = configureDictionary ('categorical', 'double');
%! d(5) = 1;
%! assert_equal (cellstr (keys (d)), {'5'});
%!test
%! d = configureDictionary ('logical', 'double');
%! d('x') = 1;
%! assert_equal (keys (d), true);
%!test
%! d = configureDictionary ('datetime', 'double');
%! d(missing) = 1;
%! assert_equal (isnat (keys (d)), true);
%!error<dictionary.subsasgn: unable to use 'char' as value of a dictionary of 'table' values.> ...
%! d = configureDictionary ('double', 'table'); d(1) = 'x';
%!error<dictionary.subsasgn: unable to use 'string' as value of a dictionary of 'single' values.> ...
%! d = configureDictionary ('double', 'single'); d(1) = string ('5');
%!error<dictionary.subsasgn: unable to use 'string' as value of a dictionary of 'int8' values.> ...
%! d = configureDictionary ('double', 'int8'); d(1) = string ('5');
%!error<dictionary.subsasgn: unable to use 'missing' as value of a dictionary of 'int8' values.> ...
%! d = configureDictionary ('double', 'int8'); d(1) = missing;
%!error<dictionary.subsasgn: unable to use 'string' as key of a dictionary of 'int8' keys.> ...
%! d = configureDictionary ('int8', 'double'); d(string ('5')) = 1;
%!error<dictionary.subsasgn: unable to use 'duration' as value of a dictionary of 'struct' values.> ...
%! d = configureDictionary ('double', 'struct'); d(1) = hours (1);
%!error<dictionary.subsasgn: unable to use 'double' as value of a dictionary of 'cell' values.> ...
%! d = configureDictionary ('double', 'cell'); d(1) = 5;
%!error<dictionary.subsasgn: unable to use 'double' as value of a dictionary of 'logical' values.> ...
%! d = configureDictionary ('double', 'logical'); d(1) = NaN;
%!error<dictionary.subsref: key not found.> D(string ('z'))
%!error<dictionary.subsref: key not found.> D(true)
%!error<dictionary.subsref: element 2 of the keys not found.> ...
%! D(string ({'a'; 'z'}))
%!error<dictionary.subsref: index with one array of keys.> D(1, 2)
%!error<dictionary.subsref: ':' is not supported; use 'keys' or 'values'.> D(:)
%!error<dictionary.subsref: ':' is not supported; use 'keys' or 'values'.> ...
%! D(':')
%!error<dictionary.subsasgn: key not found.> ...
%! d = dictionary (1, struct ('f', 1)); d(2).f = 5;
%!error<dictionary.subsref: unable to use 'string' as key of a dictionary of 'datetime' keys.> ...
%! d = dictionary (datetime (2020, 1, 1), 1); d(string ('garbage'))
%!error<dictionary.isKey: unable to use 'string' as key of a dictionary of 'datetime' keys.> ...
%! isKey (dictionary (datetime (2020, 1, 1), 1), string ('garbage'))
%!error<dictionary.subsref: unable to use 'string' as key of a dictionary of 'int8' keys.> ...
%! d = dictionary (int8 ([0, 1]), [10, 11]); d(string ('abc'))
%!error<dictionary.subsref: D is not configured.> ...
%! d = dictionary (); d(string ('a'))
%!error<dictionary.subsref: unable to use 'cell' as key of a dictionary of 'double' keys.> ...
%! d = dictionary ([1; 2], [3; 4]); d({1})
%!error<dictionary.subsref: unsupported input type 'table'.> ...
%! d = dictionary ({1}, 1); d({table(1)})
%!error<dictionary.subsasgn: unsupported input type 'table'.> ...
%! d = dictionary ({1}, 1); d({table(1)}) = 2;
%!error<dictionary.subsasgn: ':' is not supported; use 'keys' or 'values'.> ...
%! d = dictionary (1, struct ('f', 1)); d(':').f = 2;
%!error<dictionary.subsref: cannot join values of type 'function_handle'; look up each key separately.> ...
%! d = dictionary (string ('f'), @sin); d(string ({'f'; 'f'}))
%!error<dictionary.subsref: '{}' indexing needs a dictionary of 'cell' values.> ...
%! D{string('a')}
%!error<dictionary.subsref: key not found.> CV{string('z')}
%!error<dictionary.subsref: no method named 'foo'.> D.foo
%!error<dictionary.subsref: unable to use 'double' as key of a dictionary of 'missing' keys.> ...
%! d = dictionary (missing, 1); d(NaN)
%!error<dictionary.subsref: unable to use 'double' as key of a dictionary of 'logical' keys.> ...
%! d = dictionary (true, 1); d(NaN)
%!error<dictionary.subsref: key not found.> ...
%! d = dictionary (dictionary (1, 2), 5); d(dictionary (1, 3))
%!error<dictionary.keys: cannot join keys of type 'datetime'; use the 'cell' format.> ...
%! z = dictionary (datetime (2024, 1, 1, 'TimeZone', 'UTC'), 1);
%! z(datetime (2024, 1, 2)) = 2; keys (z)

%!test
%! d = D;
%! d(string ('z')) = 26;
%! assert_equal (keys (d), string ({'a'; 'b'; 'c'; 'z'}));
%! assert_equal (values (d), [1; 2; 3; 26]);
%!test
%! ## Updating a value keeps the key's position
%! d = D;
%! d(string ('a')) = 11;
%! assert_equal (keys (d), string ({'a'; 'b'; 'c'}));
%! assert_equal (values (d), [11; 2; 3]);
%!test
%! d = D;
%! d(string ({'x', 'y'})) = [7, 8];
%! assert_equal (values (d), [1; 2; 3; 7; 8]);
%!test
%! d = D;
%! d(string ({'x'; 'y'})) = 9;
%! assert_equal (values (d), [1; 2; 3; 9; 9]);
%!test
%! d = D;
%! d(string ('e')) = string ('12');
%! assert_equal (d(string ('e')), 12);
%!test
%! d = D;
%! d(5) = 1;
%! assert_equal (keys (d), string ({'a'; 'b'; 'c'; '5'}));
%!test
%! d = D;
%! d(string (cell (0, 1))) = 5;
%! assert_equal (numEntries (d), 3);
%!test
%! d = D;
%! d(string ({'a'; 'nope'})) = [];
%! assert_equal (keys (d), string ({'b'; 'c'}));
%!test
%! d = D;
%! d({'b'}) = [];
%! assert_equal (keys (d), string ({'a'; 'c'}));
%!test
%! d = D;
%! d([]) = [];
%! assert_equal (numEntries (d), 3);
%!test
%! ## A key removed and added again goes to the end
%! d = D;
%! d(string ('b')) = [];
%! d(string ('b')) = 22;
%! assert_equal (keys (d), string ({'a'; 'c'; 'b'}));
%! assert_equal (values (d), [1; 3; 22]);
%!test
%! d = D;
%! e = d;
%! e(string ('a')) = [];
%! assert_equal (numEntries (d), 3);
%! assert_equal (numEntries (e), 2);
%!test
%! d = dictionary (string ({'a'; 'b'}), string ({'x'; 'y'}));
%! d(string ('a')) = '';
%! assert_equal (values (d), string ({''; 'y'}));
%!test
%! d = dictionary ();
%! d(string (cell (0, 1))) = 5;
%! assert_equal (isConfigured (d), true);
%!test
%! d = dictionary ();
%! d('abc') = 'xyz';
%! assert_equal (types (d), string ('string'));
%! assert_equal (values (d), string ('xyz'));
%!test
%! d = CV;
%! d{string('a')}(2) = 20;
%! assert_equal (d{string('a')}, [1, 20, 3]);
%!test
%! d = CV;
%! d{string('c')} = 7;
%! assert_equal (values (d), {[1, 2, 3]; [4, 5]; 7});
%!test
%! ## '{} = []' stores an empty value, '() = []' deletes
%! d = CV;
%! d{string('b')} = [];
%! assert_equal (values (d), {[1, 2, 3]; []});
%! d(string ('a')) = [];
%! assert_equal (keys (d), string ('b'));
%!test
%! d = dictionary ();
%! d{string('a')} = 1;
%! assert_equal (types (d), string ('string'));
%! assert_equal (values (d), {1});
%!test
%! d = dictionary (string ({'a'; 'b'}), struct ('x', {1; 2}));
%! d(string ('a')).x = 10;
%! assert_equal (d(string ('a')), struct ('x', 10));
%!error<dictionary.subsasgn: KEYS and VALUES must be the same size, or VALUES a scalar.> ...
%! d = D; d(string ({'p', 'q'})) = [7; 8];
%!error<dictionary.subsasgn: KEYS and VALUES must be the same size, or VALUES a scalar.> ...
%! d = D; d(string ('m')) = zeros (0, 0, 'single');
%!error<dictionary.subsasgn: KEYS and VALUES must be the same size, or VALUES a scalar.> ...
%! d = CV; d(string ('a')) = {};
%!error<dictionary.subsasgn: unable to use 'cell' as value of a dictionary of 'double' values.> ...
%! d = D; d(string ('a')) = {1};
%!error<dictionary.subsasgn: index with one array of keys.> ...
%! d = D; d(1, 2) = 3;
%!error<dictionary.subsasgn: D is not configured.> ...
%! d = dictionary (); d(string ('a')) = [];
%!error<dictionary.subsasgn: D is not configured.> ...
%! d = dictionary (); d(string ('a')).x = 1;
%!error<dictionary.subsasgn: '{}' indexing needs a dictionary of 'cell' values.> ...
%! d = D; d{string('a')} = 1;
%!error<dictionary.subsasgn: '{}' assignment takes a single key.> ...
%! d = CV; d{string({'a'; 'b'})} = 5;
%!error<dictionary.subsasgn: a dictionary has no properties to assign.> ...
%! d = D; d.foo = 1;
%!error<dictionary.subsasgn: unsupported key type 'table'.> ...
%! d = dictionary (); d(table (1)) = 1;

%!error<dictionary.end: 'end' is not supported for a dictionary.> D(end)

## The bracket forms raise core's own 'cat: dictionary/horzcat method failed'
## wrapper, which is not ours to test, so call the methods directly.
%!error<dictionary.horzcat: dictionaries cannot be concatenated.> horzcat (C, C)
%!error<dictionary.horzcat: dictionaries cannot be concatenated.> horzcat (C, 1)
%!error<dictionary.horzcat: dictionaries cannot be concatenated.> horzcat (1, C)
%!error<dictionary.horzcat: dictionaries cannot be concatenated.> horzcat (C)

%!error<dictionary.vertcat: dictionaries cannot be concatenated.> vertcat (C, C)
%!error<dictionary.vertcat: dictionaries cannot be concatenated.> vertcat (C, 1)
%!error<dictionary.vertcat: dictionaries cannot be concatenated.> vertcat (C)

%!error<dictionary.cat: dictionaries cannot be concatenated.> cat (1, C, C)
%!error<dictionary.cat: dictionaries cannot be concatenated.> cat (3, C)

## Indexing, measured on R2024a
%!test
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! assert_equal (d([3, 1]), [30, 10]);
%!test
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! assert_equal (d([3; 1]), [30; 10]);
%!test
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! assert_equal (d([1, 2; 3, 1]), [10, 20; 30, 10]);
%!error<dictionary.subsref: key not found.> ...
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! d(4);
%!error<dictionary.subsref: element 2 of the keys not found.> ...
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! d([1, 4]);
%!test
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! assert_equal (d([]), zeros (0, 0));
%!test
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! assert_equal (d(zeros (0, 3)), zeros (0, 3));
%!test
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! assert_equal (d(int8 (2)), 20);
%!test
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! assert_equal (d(true), 10);
%!error<dictionary.subsref: key not found.> ...
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! d('a');
%!test
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! assert_equal (d(string ('2')), 20);
%!error<dictionary.subsref: index with one array of keys.> ...
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! d(1, 2);
%!error<dictionary.subsref: key not found.> ...
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! d(NaN);
%!error<dictionary.subsref: ':' is not supported; use 'keys' or 'values'.> ...
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! d(:);
%!error<dictionary.subsref: '{}' indexing needs a dictionary of 'cell' values.> ...
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! d{1};
%!test
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! assert_equal (d.numEntries, 3);
%!error<dictionary.subsref: no method named 'Foo'.> ...
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! d.Foo;
%!test
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! assert_equal (d.keys, [1; 2; 3]);
%!test
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! assert_equal (d.keys (), [1; 2; 3]);
%!test
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! assert_equal (d.isConfigured, true);
%!test
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! assert_equal (d.types, string ('double'));
%!test
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! r = d.entries ('struct');
%! assert_equal (size (r), [3, 1]);
%! assert_equal (fieldnames (r), {'Key'; 'Value'});
%! assert_equal (r(1).Key, 1);
%! assert_equal (r(1).Value, 10);
%! assert_equal (r(2).Key, 2);
%! assert_equal (r(2).Value, 20);
%! assert_equal (r(3).Key, 3);
%! assert_equal (r(3).Value, 30);
%!test
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! d(4) = 40;
%! assert_equal (keys (d), [1; 2; 3; 4]);
%!test
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! d(2) = 200;
%! assert_equal (values (d), [10; 200; 30]);
%!test
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! d([5, 6]) = [50, 60];
%! assert_equal (keys (d), [1; 2; 3; 5; 6]);
%!test
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! d([7, 8]) = 0;
%! assert_equal (values (d), [10; 20; 30; 0; 0]);
%!error<dictionary.subsasgn: KEYS and VALUES must be the same size, or VALUES a scalar.> ...
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! d([9, 10]) = [1, 2, 3];
%!test
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! d(11) = [];
%! assert_equal (numEntries (d), 3);
%!test
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! d(2) = [];
%! assert_equal (keys (d), [1; 3]);
%!test
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! d(2) = [];
%! d(2) = 2;
%! assert_equal (keys (d), [1; 3; 2]);
%!test
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! d([1, 3]) = [];
%! assert_equal (keys (d), 2);
%!test
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! d(NaN) = 1;
%! d(NaN) = 2;
%! assert_equal (d(NaN), 2);
%!test
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! d(NaN) = 1;
%! d(NaN) = 2;
%! assert_equal (numEntries (d), 4);
%!test
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! d(-0) = 5;
%! assert_equal (d(0), 5);
%!test
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! d(-0) = 5;
%! assert_equal (keys (d), [1; 2; 3; -0]);
%!test
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! d(string ('3')) = 33;
%! assert_equal (d(3), 33);
%!test
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! d('a') = 1;
%! assert_equal (d(97), 1);
%!test
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! d(int8 (4)) = int8 (9);
%! assert_equal (d(4), 9);
%!test
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! d(12) = string ('5');
%! assert_equal (d(12), 5);
%!test
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! d(12) = string ('x');
%! assert_equal (d(12), NaN);
%!test
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! d(13) = 'x';
%! assert_equal (d(13), 120);
%!test
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! d(13) = true;
%! assert_equal (d(13), 1);
%!error<dictionary.subsasgn: unable to use 'cell' as value of a dictionary of 'double' values.> ...
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! d(14) = {1};
%!error<dictionary.subsasgn: unable to use 'dictionary' as value of a dictionary of 'double' values.> ...
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! d(20) = 1;
%! d(21) = d;
%!test
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! d(:) = 9;
%! assert_equal (keys (d), [1; 2; 3; 58]);
%!test
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! d(':') = 9;
%! assert_equal (d(':'), 9);
%!error<dictionary.subsasgn: index with one array of keys.> ...
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! d(1, 2) = 9;
%!error<dictionary.subsasgn: '{}' indexing needs a dictionary of 'cell' values.> ...
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! d{1} = 9;
%!error<dictionary.subsasgn: a dictionary has no properties to assign.> ...
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! d.x = 9;
%!error<dictionary.subsasgn: key not found.> ...
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! d(9).x = 9;
%!error<dictionary.subsasgn: KEYS and VALUES must be the same size, or VALUES a scalar.> ...
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! d(4) = [1, 2];
%!error<dictionary.subsasgn: KEYS and VALUES must be the same size, or VALUES a scalar.> ...
%! d = dictionary ([1, 2, 3], [10, 20, 30]);
%! d([4, 5]) = [1; 2];
%!test
%! c = dictionary (string ({'a', 'b'}), {1, 'two'});
%! assert_equal (c{string ('a')}, 1);
%!test
%! c = dictionary (string ({'a', 'b'}), {1, 'two'});
%! assert_equal (c(string ('a')), {1});
%!test
%! c = dictionary (string ({'a', 'b'}), {1, 'two'});
%! assert_equal (c(string ({'b', 'a'})), {'two', 1});
%!error<dictionary.subsref: key not found.> ...
%! c = dictionary (string ({'a', 'b'}), {1, 'two'});
%! c{string ('z')};
%!test
%! c = dictionary (string ({'a', 'b'}), {1, 'two'});
%! c{string ('c')} = 3;
%! assert_equal (c(string ('c')), {3});
%!test
%! c = dictionary (string ({'a', 'b'}), {1, 'two'});
%! c{string ('d')} = [];
%! assert_equal (c(string ('d')), {zeros(0, 0)});
%!error<dictionary.subsasgn: '{}' assignment takes a single key.> ...
%! c = dictionary (string ({'a', 'b'}), {1, 'two'});
%! c{string ({'e', 'f'})} = 5;
%!test
%! c = dictionary (string ({'a', 'b'}), {1, 'two'});
%! c(string ('g')) = {[1, 2, 3]};
%! assert_equal (c{string ('g')}(2), 2);
%!test
%! c = dictionary (string ({'a', 'b'}), {1, 'two'});
%! c(string ('g')) = {[1, 2, 3]};
%! c{string ('g')}(2) = 9;
%! assert_equal (c{string ('g')}, [1, 9, 3]);
%!error<dictionary.subsasgn: unable to use 'double' as value of a dictionary of 'cell' values.> ...
%! c = dictionary (string ({'a', 'b'}), {1, 'two'});
%! c(string ('h')) = 7;
%!error<dictionary.subsasgn: KEYS and VALUES must be the same size, or VALUES a scalar.> ...
%! c = dictionary (string ({'a', 'b'}), {1, 'two'});
%! c(string ('i')) = {};
%!test
%! c = dictionary (string ({'a', 'b'}), {1, 'two'});
%! c(string ('a')) = [];
%! assert_equal (keys (c), string ('b'));
%!test
%! c = dictionary (string ({'a', 'b'}), {1, 'two'});
%! c{string ('new')}(3) = 7;
%! assert_equal (c{string ('new')}, [0, 0, 7]);
%!test
%! c = dictionary (string ({'a', 'b'}), {1, 'two'});
%! c{string ('new')}.f = 7;
%! assert_equal (c{string ('new')}, struct ('f', 7));
%!test
%! c = dictionary (string ({'a', 'b'}), {1, 'two'});
%! c{:} = 5;
%! assert_equal (keys (c), string ({'a'; 'b'; ':'}));
%!error<dictionary.subsref: '{}' indexing needs a dictionary of 'cell' values.> ...
%! n = dictionary (1, 2);
%! n{1};
%!error<dictionary.subsasgn: '{}' indexing needs a dictionary of 'cell' values.> ...
%! n = dictionary (1, 2);
%! n{1} = 3;
%!test
%! s = dictionary ([1, 2], struct ('a', {10, 20}));
%! assert_equal (s(2).a, 20);
%!test
%! s = dictionary ([1, 2], struct ('a', {10, 20}));
%! s(2).a = 5;
%! assert_equal (s(2), struct ('a', 5));
%!error<dictionary.subsasgn: key not found.> ...
%! s = dictionary ([1, 2], struct ('a', {10, 20}));
%! s(3).a = 7;
%!test
%! s = dictionary ([1, 2], struct ('a', {10, 20}));
%! r = s([1, 2]);
%! assert_equal (size (r), [1, 2]);
%! assert_equal (fieldnames (r), {'a'});
%! assert_equal (r(1).a, 10);
%! assert_equal (r(2).a, 20);
%!test
%! s = dictionary ([1, 2], struct ('a', {10, 20}));
%! s(3) = struct ('b', 1);
%! assert_equal (s(3), struct ('b', 1));
%!test
%! s = dictionary ([1, 2], struct ('a', {10, 20}));
%! s(3) = struct ('b', 1);
%! r = values (s, 'cell');
%! assert_equal (r, {struct('a', 10); struct('a', 20); struct('b', 1)});
%!error<dictionary.values: cannot join values of type 'struct'; use the 'cell' format.> ...
%! s = dictionary ([1, 2], struct ('a', {10, 20}));
%! s(3) = struct ('b', 1);
%! values (s);
%!error<dictionary.subsref: cannot join values of type 'struct'; look up each key separately.> ...
%! s = dictionary ([1, 2], struct ('a', {10, 20}));
%! s(3) = struct ('b', 1);
%! s([1, 3]);
%!test
%! s = dictionary ([1, 2], struct ('a', {10, 20}));
%! s(3) = struct ('b', 1);
%! r = entries (s, 'struct');
%! assert_equal (size (r), [3, 1]);
%! assert_equal (fieldnames (r), {'Key'; 'Value'});
%! assert_equal (r(1).Key, 1);
%! assert_equal (r(1).Value, struct ('a', 10));
%! assert_equal (r(2).Key, 2);
%! assert_equal (r(2).Value, struct ('a', 20));
%! assert_equal (r(3).Key, 3);
%! assert_equal (r(3).Value, struct ('b', 1));
%!error<dictionary.entries: a table cannot hold these entries; use the 'cell' or 'struct' format.> ...
%! s = dictionary ([1, 2], struct ('a', {10, 20}));
%! s(3) = struct ('b', 1);
%! entries (s);
%!test
%! z = dictionary (1, datetime (2024, 1, 1, 'TimeZone', 'UTC'));
%! z(2) = datetime (2024, 1, 2);
%! r = values (z, 'cell');
%! assert_equal (size (r), [2, 1]);
%! x1 = r{1};
%! x1.Format = 'yyyy-MM-dd HH:mm:ss.SSS';
%! assert_equal (cellstr (x1), {'2024-01-01 00:00:00.000'});
%! assert_equal (x1.TimeZone, 'UTC');
%! x2 = r{2};
%! x2.Format = 'yyyy-MM-dd HH:mm:ss.SSS';
%! assert_equal (cellstr (x2), {'2024-01-02 00:00:00.000'});
%! assert_equal (x2.TimeZone, '');
%!error<dictionary.values: cannot join values of type 'datetime'; use the 'cell' format.> ...
%! z = dictionary (1, datetime (2024, 1, 1, 'TimeZone', 'UTC'));
%! z(2) = datetime (2024, 1, 2);
%! values (z);
%!test
%! z = dictionary (1, datetime (2024, 1, 1, 'TimeZone', 'UTC'));
%! z(3) = datetime (2024, 1, 3, 'TimeZone', 'Europe/Athens');
%! r = values (z, 'cell');
%! assert_equal (size (r), [2, 1]);
%! x1 = r{1};
%! x1.Format = 'yyyy-MM-dd HH:mm:ss.SSS';
%! assert_equal (cellstr (x1), {'2024-01-01 00:00:00.000'});
%! assert_equal (x1.TimeZone, 'UTC');
%! x2 = r{2};
%! x2.Format = 'yyyy-MM-dd HH:mm:ss.SSS';
%! assert_equal (cellstr (x2), {'2024-01-03 00:00:00.000'});
%! assert_equal (x2.TimeZone, 'Europe/Athens');
%!test
%! z = dictionary (1, datetime (2024, 1, 1));
%! z(2) = datetime (2024, 1, 2, 'TimeZone', 'UTC');
%! r = values (z, 'cell');
%! assert_equal (size (r), [2, 1]);
%! x1 = r{1};
%! x1.Format = 'yyyy-MM-dd HH:mm:ss.SSS';
%! assert_equal (cellstr (x1), {'2024-01-01 00:00:00.000'});
%! assert_equal (x1.TimeZone, '');
%! x2 = r{2};
%! x2.Format = 'yyyy-MM-dd HH:mm:ss.SSS';
%! assert_equal (cellstr (x2), {'2024-01-02 00:00:00.000'});
%! assert_equal (x2.TimeZone, 'UTC');
%!test
%! z = dictionary (datetime (2024, 1, 1, 'TimeZone', 'UTC'), 1);
%! assert_equal (isKey (z, datetime (2024, 1, 1)), false);
%!test
%! z = dictionary (datetime (2024, 1, 1, 'TimeZone', 'UTC'), 1);
%! z(datetime (2024, 1, 2)) = 2;
%! r = keys (z, 'cell');
%! assert_equal (size (r), [2, 1]);
%! x1 = r{1};
%! x1.Format = 'yyyy-MM-dd HH:mm:ss.SSS';
%! assert_equal (cellstr (x1), {'2024-01-01 00:00:00.000'});
%! assert_equal (x1.TimeZone, 'UTC');
%! x2 = r{2};
%! x2.Format = 'yyyy-MM-dd HH:mm:ss.SSS';
%! assert_equal (cellstr (x2), {'2024-01-02 00:00:00.000'});
%! assert_equal (x2.TimeZone, '');
%!error<dictionary.keys: cannot join keys of type 'datetime'; use the 'cell' format.> ...
%! z = dictionary (datetime (2024, 1, 1, 'TimeZone', 'UTC'), 1);
%! z(datetime (2024, 1, 2)) = 2;
%! keys (z);
%!test
%! z = dictionary (datetime (2024, 1, 1, 'TimeZone', 'UTC'), 1);
%! z(datetime (2023, 12, 31, 19, 0, 0, 'TimeZone', 'America/New_York')) = 5;
%! assert_equal (values (z), 5);
%!test
%! z = dictionary (datetime (2024, 1, 1, 'TimeZone', 'UTC'), 1);
%! z(datetime (2024, 1, 1, 0, 0, 0, 'TimeZone', 'Europe/Athens')) = 6;
%! r = keys (z);
%! x1 = r;
%! x1.Format = 'yyyy-MM-dd HH:mm:ss.SSS';
%! assert_equal (cellstr (x1), ...
%!               {'2024-01-01 00:00:00.000'; '2023-12-31 22:00:00.000'});
%! assert_equal (x1.TimeZone, 'UTC');

## D4: text is read in the time zone of the keys, where MATLAB reads none.
%!test
%! z = dictionary (datetime (2024, 1, 1, 'TimeZone', 'UTC'), 1);
%! z('2024-01-02') = 2;
%! r = keys (z);
%! x1 = r;
%! x1.Format = 'yyyy-MM-dd HH:mm:ss.SSS';
%! assert_equal (cellstr (x1), ...
%!               {'2024-01-01 00:00:00.000'; '2024-01-02 00:00:00.000'});
%! assert_equal (x1.TimeZone, 'UTC');
%!test
%! z = dictionary (datetime (2024, 1, 1), 1);
%! assert_equal (isKey (z, datetime (2024, 1, 1, 'TimeZone', 'UTC')), false);
%!error<dictionary.subsref: unable to use 'string' as key of a dictionary of 'datetime' keys.> ...
%! g = dictionary (datetime (2020, 1, 1), 1);
%! g(string ('garbage'));
%!error<dictionary.isKey: unable to use 'string' as key of a dictionary of 'datetime' keys.> ...
%! g = dictionary (datetime (2020, 1, 1), 1);
%! isKey (g, string ('garbage'));
%!test
%! k = dictionary (string (':'), 1);
%! assert_equal (k(':'), 1);
%!test
%! k = dictionary (string (':'), 1);
%! assert_equal (isKey (k, ':'), true);
%!test
%! v = dictionary ([1, 2], string ({'a', 'b'}));
%! r = lookup (v, [1, 3], 'FallbackValue', 'none');
%! assert_equal (r, string ({'a', 'none'}));
%!test
%! v = dictionary ([1, 2], datetime (2024, 1, [1, 2]));
%! r = lookup (v, [1, 3], 'FallbackValue', '2021-01-01');
%! x1 = r;
%! x1.Format = 'yyyy-MM-dd HH:mm:ss.SSS';
%! assert_equal (cellstr (x1), ...
%!               {'2024-01-01 00:00:00.000', '2021-01-01 00:00:00.000'});
%! assert_equal (x1.TimeZone, '');
%!test
%! w = dictionary (string ({'x', 'y'}), [1, 2]);
%! w2 = w;
%! w2(string ('x')) = 100;
%! assert_equal (w(string ('x')), 1);
%!test
%! r = dictionary (1:1000, 1:1000);
%! r = remove (r, 2:2:1000);
%! assert_equal (numEntries (r), 500);
%!test
%! r = dictionary (1:1000, 1:1000);
%! r = remove (r, 2:2:1000);
%! assert_equal (r([999, 1]), [999, 1]);
%!test
%! r = dictionary (1:1000, 1:1000);
%! r = remove (r, 2:2:1000);
%! assert_equal (isKey (r, [1, 2, 3, 4]), [true, false, true, false]);
%!test
%! r = dictionary (1:1000, 1:1000);
%! r = remove (r, 2:2:1000);
%! r(2) = 2;
%! assert_equal (sum (values (r)), 250002);
%!test
%! p = dictionary (string ({'a', 'b', 'c', 'd', 'e'}), 1:5);
%! p(string ({'b', 'd'})) = [];
%! p(string ('b')) = 20;
%! p(string ('a')) = 10;
%! assert_equal (keys (p), string ({'a'; 'c'; 'e'; 'b'}));
%!test
%! p = dictionary (string ({'a', 'b', 'c', 'd', 'e'}), 1:5);
%! p(string ({'b', 'd'})) = [];
%! p(string ('b')) = 20;
%! p(string ('a')) = 10;
%! assert_equal (values (p), [10; 3; 5; 20]);
%!test
%! p = dictionary (string ({'a', 'b', 'c', 'd', 'e'}), 1:5);
%! p = insert (p, string ({'f', 'b'}), [6, 200]);
%! assert_equal (values (p), [1; 200; 3; 4; 5; 6]);
%!test
%! u = dictionary ();
%! u(1) = 2;
%! r = u;
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'double'}));
%! assert_equal (numEntries (r), 1);
%! assert_equal (keys (r, 'cell'), {1});
%! assert_equal (values (r, 'cell'), {2});
%!test
%! u = dictionary ();
%! u(string ('a')) = 'x';
%! r = u;
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'string', 'string'}));
%! assert_equal (numEntries (r), 1);
%! assert_equal (keys (r, 'cell'), {string('a')});
%! assert_equal (values (r, 'cell'), {string('x')});
%!test
%! u = dictionary ();
%! u('ab') = 1;
%! r = u;
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'string', 'double'}));
%! assert_equal (numEntries (r), 1);
%! assert_equal (keys (r, 'cell'), {string('ab')});
%! assert_equal (values (r, 'cell'), {1});
%!error<dictionary.subsasgn: KEYS and VALUES must be the same size, or VALUES a scalar.> ...
%! u = dictionary ();
%! u(['ab'; 'cd']) = [1, 2];
%!test
%! u = dictionary ();
%! u(['ab'; 'cd']) = [1; 2];
%! r = u;
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'string', 'double'}));
%! assert_equal (numEntries (r), 2);
%! assert_equal (keys (r, 'cell'), {string('ab'); string('cd')});
%! assert_equal (values (r, 'cell'), {1; 2});
%!error<dictionary.subsasgn: D is not configured.> ...
%! u = dictionary ();
%! u([]) = [];
%!test
%! u = dictionary ();
%! u([]) = 5;
%! r = u;
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'double'}));
%! assert_equal (numEntries (r), 0);
%!test
%! u = dictionary ();
%! u{1} = 2;
%! r = u;
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'cell'}));
%! assert_equal (numEntries (r), 1);
%! assert_equal (keys (r, 'cell'), {1});
%! assert_equal (values (r, 'cell'), {{2}});
%!error<dictionary.subsasgn: D is not configured.> ...
%! u = dictionary ();
%! u(1) = [];
%!error<dictionary.subsref: D is not configured.> ...
%! u = dictionary ();
%! u(1);
%!test
%! u = dictionary ();
%! u(string ('a')) = {1};
%! r = u;
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'string', 'cell'}));
%! assert_equal (numEntries (r), 1);
%! assert_equal (keys (r, 'cell'), {string('a')});
%! assert_equal (values (r, 'cell'), {{1}});
%!test
%! u = dictionary ();
%! u(datetime (2024, 1, 1)) = hours (1);
%! r = u;
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'datetime', 'duration'}));
%! assert_equal (numEntries (r), 1);
%! kc3 = keys (r, 'cell');
%! x5 = kc3{1};
%! x5.Format = 'yyyy-MM-dd HH:mm:ss.SSS';
%! assert_equal (cellstr (x5), {'2024-01-01 00:00:00.000'});
%! assert_equal (x5.TimeZone, '');
%! vc4 = values (r, 'cell');
%! assert_equal (class (vc4{1}), 'duration');
%! assert_equal (seconds (vc4{1}), 3600);
%!error<dictionary.subsasgn: unsupported key type 'table'.> ...
%! u = dictionary ();
%! u(table (1)) = 1;

## D3: a table of any size is one value, where MATLAB takes only 1-by-1.
%!test
%! u = dictionary ();
%! u(1) = table ([1; 2]);
%! r = u;
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'table'}));
%! assert_equal (numEntries (r), 1);
%! assert_equal (keys (r, 'cell'), {1});
%! vc4 = values (r, 'cell');
%! tb5 = vc4{1};
%! assert_equal (size (tb5), [2, 1]);
%! assert_equal (tb5.Properties.VariableNames, {'Var1'});
%! assert_equal (tb5.Var1, [1; 2]);
%!test
%! u = dictionary ();
%! u{string ('a')}(2) = 7;
%! r = u;
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'string', 'cell'}));
%! assert_equal (numEntries (r), 1);
%! assert_equal (keys (r, 'cell'), {string('a')});
%! assert_equal (values (r, 'cell'), {{[0, 7]}});

## Keys of type 'double', measured on R2024a
%!shared D, R, CV
%! D = dictionary (1, 10);
%! D(2) = 20;
%! D(3) = 30;
%! R = dictionary (3, 30);
%! R(2) = 20;
%! R(1) = 10;
%! CV = dictionary (1, {1});
%! CV(2) = {'two'};
%! CV(3) = {[3, 4]};
%!assert_equal (keys (D), [1; 2; 3])
%!assert_equal (values (D), [10; 20; 30])
%!assert_equal (keys (D, 'cell'), {1; 2; 3})
%!assert_equal (numEntries (D), 3)
%!assert_equal (D(2), 20)
%!assert_equal (isKey (D, 1), true)
%!assert_equal (lookup (D, 2), 20)
%!assert_equal (isKey (D, 9), false)
%!assert_equal (lookup (D, 9, 'FallbackValue', 0), 0)
%!error<dictionary.subsref: key not found.> ...
%! D(9);
%!test
%! d = D;
%! d(9) = [];
%! assert_equal (numEntries (d), 3);
%!test
%! d = D;
%! d = remove (d, 9);
%! assert_equal (numEntries (d), 3);
%!assert_equal (D([1, 3]), [10, 30])
%!assert_equal (isKey (D, [1, 3]), [true, true])
%!test
%! r = dictionary ([1, 3], 7);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'double'}));
%! assert_equal (numEntries (r), 2);
%! assert_equal (keys (r, 'cell'), {1; 3});
%! assert_equal (values (r, 'cell'), {7; 7});
%!test
%! d = D;
%! d(4) = 40;
%! assert_equal (keys (d, 'cell'), {1; 2; 3; 4});
%!test
%! d = D;
%! d = insert (d, 4, 40);
%! assert_equal (values (d), [10; 20; 30; 40]);
%!test
%! d = D;
%! d(1) = 99;
%! assert_equal (values (d), [99; 20; 30]);
%!test
%! d = D;
%! d = insert (d, 1, 99);
%! assert_equal (values (d), [99; 20; 30]);
%!test
%! d = D;
%! d = insert (d, 1, 99, 'Overwrite', false);
%! assert_equal (values (d), [10; 20; 30]);
%!test
%! d = D;
%! d = remove (d, 1);
%! assert_equal (keys (d, 'cell'), {2; 3});
%!test
%! d = D;
%! d(1) = [];
%! assert_equal (values (d), [20; 30]);
%!test
%! d = D;
%! d = remove (d, 1);
%! d(1) = 11;
%! assert_equal (values (d), [20; 30; 11]);
%!test
%! r = entries (D, 'struct');
%! assert_equal (size (r), [3, 1]);
%! assert_equal (fieldnames (r), {'Key'; 'Value'});
%! assert_equal (r(1).Key, 1);
%! assert_equal (r(1).Value, 10);
%! assert_equal (r(2).Key, 2);
%! assert_equal (r(2).Value, 20);
%! assert_equal (r(3).Key, 3);
%! assert_equal (r(3).Value, 30);
%!assert_equal (entries (D, 'cell'), {1, 10; 2, 20; 3, 30})
%!test
%! r = entries (D);
%! tb1 = r;
%! assert_equal (size (tb1), [3, 2]);
%! assert_equal (tb1.Properties.VariableNames, {'Key', 'Value'});
%! assert_equal (tb1.Key, [1; 2; 3]);
%! assert_equal (tb1.Value, [10; 20; 30]);
%!assert_equal (isequal (D, R), true)
%!assert_equal (isequaln (D, R), true)
%!assert_equal (keyHash (D) == keyHash (R), false)
%!assert_equal (keyHash (D) == keyHash (D), true)
%!assert_equal (keyMatch (D, R), false)
%!assert_equal (CV{2}, 'two')
%!test
%! c = CV;
%! c{1} = 5;
%! assert_equal (c(1), {5});
%!test
%! c = CV;
%! c{2}(2) = 7;
%! r = c{2};
%! assert_equal (double (r), [116, 7, 111]);
%!error<dictionary.subsref: key not found.> ...
%! CV{9};

## Keys of type 'single', measured on R2024a
%!shared D, R, CV
%! D = dictionary (single (1), 10);
%! D(single (2)) = 20;
%! D(single (3)) = 30;
%! R = dictionary (single (3), 30);
%! R(single (2)) = 20;
%! R(single (1)) = 10;
%! CV = dictionary (single (1), {1});
%! CV(single (2)) = {'two'};
%! CV(single (3)) = {[3, 4]};
%!assert_equal (keys (D), single ([1; 2; 3]))
%!assert_equal (values (D), [10; 20; 30])
%!assert_equal (keys (D, 'cell'), {single(1); single(2); single(3)})
%!assert_equal (numEntries (D), 3)
%!assert_equal (D(single (2)), 20)
%!assert_equal (isKey (D, single (1)), true)
%!assert_equal (lookup (D, single (2)), 20)
%!assert_equal (isKey (D, single (9)), false)
%!assert_equal (lookup (D, single (9), 'FallbackValue', 0), 0)
%!error<dictionary.subsref: key not found.> ...
%! D(single (9));
%!test
%! d = D;
%! d(single (9)) = [];
%! assert_equal (numEntries (d), 3);
%!test
%! d = D;
%! d = remove (d, single (9));
%! assert_equal (numEntries (d), 3);
%!assert_equal (D(single ([1, 3])), [10, 30])
%!assert_equal (isKey (D, single ([1, 3])), [true, true])
%!test
%! r = dictionary (single ([1, 3]), 7);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'single', 'double'}));
%! assert_equal (numEntries (r), 2);
%! assert_equal (keys (r, 'cell'), {single(1); single(3)});
%! assert_equal (values (r, 'cell'), {7; 7});
%!test
%! d = D;
%! d(single (4)) = 40;
%! r = keys (d, 'cell');
%! assert_equal (r, {single(1); single(2); single(3); single(4)});
%!test
%! d = D;
%! d = insert (d, single (4), 40);
%! assert_equal (values (d), [10; 20; 30; 40]);
%!test
%! d = D;
%! d(single (1)) = 99;
%! assert_equal (values (d), [99; 20; 30]);
%!test
%! d = D;
%! d = insert (d, single (1), 99);
%! assert_equal (values (d), [99; 20; 30]);
%!test
%! d = D;
%! d = insert (d, single (1), 99, 'Overwrite', false);
%! assert_equal (values (d), [10; 20; 30]);
%!test
%! d = D;
%! d = remove (d, single (1));
%! assert_equal (keys (d, 'cell'), {single(2); single(3)});
%!test
%! d = D;
%! d(single (1)) = [];
%! assert_equal (values (d), [20; 30]);
%!test
%! d = D;
%! d = remove (d, single (1));
%! d(single (1)) = 11;
%! assert_equal (values (d), [20; 30; 11]);
%!test
%! r = entries (D, 'struct');
%! assert_equal (size (r), [3, 1]);
%! assert_equal (fieldnames (r), {'Key'; 'Value'});
%! assert_equal (r(1).Key, single (1));
%! assert_equal (r(1).Value, 10);
%! assert_equal (r(2).Key, single (2));
%! assert_equal (r(2).Value, 20);
%! assert_equal (r(3).Key, single (3));
%! assert_equal (r(3).Value, 30);
%!test
%! r = entries (D, 'cell');
%! assert_equal (r, {single(1), 10; single(2), 20; single(3), 30});
%!test
%! r = entries (D);
%! tb1 = r;
%! assert_equal (size (tb1), [3, 2]);
%! assert_equal (tb1.Properties.VariableNames, {'Key', 'Value'});
%! assert_equal (tb1.Key, single ([1; 2; 3]));
%! assert_equal (tb1.Value, [10; 20; 30]);
%!assert_equal (isequal (D, R), true)
%!assert_equal (isequaln (D, R), true)
%!assert_equal (keyHash (D) == keyHash (R), false)
%!assert_equal (keyHash (D) == keyHash (D), true)
%!assert_equal (keyMatch (D, R), false)
%!assert_equal (CV{single (2)}, 'two')
%!test
%! c = CV;
%! c{single (1)} = 5;
%! assert_equal (c(single (1)), {5});
%!test
%! c = CV;
%! c{single (2)}(2) = 7;
%! r = c{single (2)};
%! assert_equal (double (r), [116, 7, 111]);
%!error<dictionary.subsref: key not found.> ...
%! CV{single (9)};

## Keys of type 'int8', measured on R2024a
%!shared D, R, CV
%! D = dictionary (int8 (1), 10);
%! D(int8 (2)) = 20;
%! D(int8 (3)) = 30;
%! R = dictionary (int8 (3), 30);
%! R(int8 (2)) = 20;
%! R(int8 (1)) = 10;
%! CV = dictionary (int8 (1), {1});
%! CV(int8 (2)) = {'two'};
%! CV(int8 (3)) = {[3, 4]};
%!assert_equal (keys (D), int8 ([1; 2; 3]))
%!assert_equal (values (D), [10; 20; 30])
%!assert_equal (keys (D, 'cell'), {int8(1); int8(2); int8(3)})
%!assert_equal (numEntries (D), 3)
%!assert_equal (D(int8 (2)), 20)
%!assert_equal (isKey (D, int8 (1)), true)
%!assert_equal (lookup (D, int8 (2)), 20)
%!assert_equal (isKey (D, int8 (9)), false)
%!assert_equal (lookup (D, int8 (9), 'FallbackValue', 0), 0)
%!error<dictionary.subsref: key not found.> ...
%! D(int8 (9));
%!test
%! d = D;
%! d(int8 (9)) = [];
%! assert_equal (numEntries (d), 3);
%!test
%! d = D;
%! d = remove (d, int8 (9));
%! assert_equal (numEntries (d), 3);
