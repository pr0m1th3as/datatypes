%! d(int8 (5)) = 1;
%! assert_equal (keys (d, 'cell'), {string('5')});
%!test
%! d = configureDictionary ('string', 'double');
%! d(true) = 1;
%! assert_equal (keys (d, 'cell'), {string('true')});
%!test
%! d = configureDictionary ('string', 'double');
%! d('x') = 1;
%! assert_equal (keys (d, 'cell'), {string('x')});
%!test
%! d = configureDictionary ('string', 'double');
%! d('5') = 1;
%! assert_equal (keys (d, 'cell'), {string('5')});
%!test
%! d = configureDictionary ('string', 'double');
%! d(string ('x')) = 1;
%! assert_equal (keys (d, 'cell'), {string('x')});
%!test
%! d = configureDictionary ('string', 'double');
%! d(string ('5')) = 1;
%! assert_equal (keys (d, 'cell'), {string('5')});
%!test
%! d = configureDictionary ('string', 'double');
%! d({'x'}) = 1;
%! assert_equal (keys (d, 'cell'), {string('x')});
%!test
%! d = configureDictionary ('string', 'double');
%! d({5}) = 1;
%! assert_equal (keys (d, 'cell'), {string('5')});
%!test
%! d = configureDictionary ('string', 'double');
%! d(categorical ({'x'})) = 1;
%! assert_equal (keys (d, 'cell'), {string('x')});
%!test
%! d = configureDictionary ('string', 'double');
%! d(datetime (2024, 1, 1)) = 1;
%! assert_equal (keys (d, 'cell'), {string('01-Jan-2024')});
%!test
%! d = configureDictionary ('string', 'double');
%! d(hours (1)) = 1;
%! assert_equal (keys (d, 'cell'), {string('1 hr')});
%!test
%! d = configureDictionary ('string', 'double');
%! d(calmonths (1)) = 1;
%! assert_equal (keys (d, 'cell'), {string('1mo')});
%!test
%! d = configureDictionary ('string', 'double');
%! d(missing) = 1;
%! r = keys (d, 'cell');
%! assert_equal (size (r), [1, 1]);
%! assert_equal (class (r{1}), 'string');
%! assert_equal (ismissing (r{1}), true);
