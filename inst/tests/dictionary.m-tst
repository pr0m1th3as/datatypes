## Our categorical takes no calendarDuration, where MATLAB's makes '1mo'.
%!error<dictionary.subsasgn: unable to use 'calendarDuration' as value of a dictionary of 'categorical' values.> ...
%! d = configureDictionary ('double', 'categorical');
%! d(1) = calmonths (1);
%!test
%! d = configureDictionary ('double', 'categorical');
%! d(1) = missing;
%! r = values (d, 'cell');
%! assert_equal (size (r), [1, 1]);
%! assert_equal (class (r{1}), 'categorical');
%! assert_equal (size (r{1}), [1, 1]);
%! assert_equal (isundefined (r{1}), true);
%! assert_equal (categories (r{1}), cell (0, 0));
%! assert_equal (isordinal (r{1}), false);
%!error<dictionary.subsasgn: unable to use 'struct' as value of a dictionary of 'categorical' values.> ...
%! d = configureDictionary ('double', 'categorical');
%! d(1) = struct ('a', 1);
%!error<dictionary.subsasgn: unable to use 'table' as value of a dictionary of 'categorical' values.> ...
%! d = configureDictionary ('double', 'categorical');
%! d(1) = table (1);
%!error<dictionary.subsasgn: unable to use 'function_handle' as value of a dictionary of 'categorical' values.> ...
%! d = configureDictionary ('double', 'categorical');
%! d(1) = @sin;

