%!error<dictionary.subsasgn: unable to use 'cell' as key of a dictionary of 'duration' keys.> ...
%! d = configureDictionary ('duration', 'double');
%! d({5}) = 1;
%!error<dictionary.subsasgn: unable to use 'categorical' as key of a dictionary of 'duration' keys.> ...
%! d = configureDictionary ('duration', 'double');
%! d(categorical ({'x'})) = 1;
%!error<dictionary.subsasgn: unable to use 'datetime' as key of a dictionary of 'duration' keys.> ...
%! d = configureDictionary ('duration', 'double');
%! d(datetime (2024, 1, 1)) = 1;
%!test
%! d = configureDictionary ('duration', 'double');
%! d(hours (1)) = 1;
%! r = keys (d, 'cell');
%! assert_equal (size (r), [1, 1]);
%! assert_equal (class (r{1}), 'duration');
%! assert_equal (seconds (r{1}), 3600);
%!error<dictionary.subsasgn: unable to use 'calendarDuration' as key of a dictionary of 'duration' keys.> ...
%! d = configureDictionary ('duration', 'double');
%! d(calmonths (1)) = 1;
%!test
%! d = configureDictionary ('duration', 'double');
%! d(missing) = 1;
%! r = keys (d, 'cell');
%! assert_equal (size (r), [1, 1]);
%! assert_equal (class (r{1}), 'duration');
%! assert_equal (seconds (r{1}), NaN);
%!error<dictionary.subsasgn: unable to use 'struct' as key of a dictionary of 'duration' keys.> ...
%! d = configureDictionary ('duration', 'double');
%! d(struct ('a', 1)) = 1;
%!error<dictionary.subsasgn: unable to use 'table' as key of a dictionary of 'duration' keys.> ...
%! d = configureDictionary ('duration', 'double');
%! d(table (1)) = 1;
%!error<dictionary.subsasgn: unable to use 'function_handle' as key of a dictionary of 'duration' keys.> ...
%! d = configureDictionary ('duration', 'double');
%! d(@sin) = 1;

