%! d = configureDictionary ('double', 'categorical');
%! d(1) = true;
%! r = values (d, 'cell');
%! assert_equal (size (r), [1, 1]);
%! assert_equal (class (r{1}), 'categorical');
%! assert_equal (size (r{1}), [1, 1]);
%! assert_equal (cellstr (r{1}), {'true'});
%! assert_equal (categories (r{1}), {'true'});
