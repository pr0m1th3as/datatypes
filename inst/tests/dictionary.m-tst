%! t = insert (t, string ('g'), 15, 'Overwrite', false);
%! t = insert (t, string ('e'), 81, 'Overwrite', false);
%! t(string ('d')) = 9;
%! t(string ({'c', 'c'})) = [51, 52];
%! t(string ('e')) = 93;
%! t = remove (t, string ('b'));
%! t(string ('e')) = 38;
%! t(string ({'b', 'b'})) = [53, 54];
%! t = remove (t, string ('a'));
%! t = insert (t, string ('b'), 73);
%! t = remove (t, string ('a'));
%! t(string ('b')) = 46;
%! t(string ('h')) = 46;
%! t = insert (t, string ('h'), 5, 'Overwrite', false);
%! t(string ('b')) = [];
%! t = remove (t, string ('f'));
%! t(string ({'g', 'f'})) = [23, 24];
%! t = remove (t, string ('g'));
%! t = insert (t, string ('g'), 67, 'Overwrite', false);
%! t(string ({'b', 'f'})) = [18, 19];
%! t = insert (t, string ('b'), 88);
%! t(string ('h')) = 99;
%! t = insert (t, string ('f'), 25);
%! t = remove (t, string ('e'));
%! t = remove (t, string ('e'));
%! t = insert (t, string ('f'), 91);
%! t = insert (t, string ('g'), 59, 'Overwrite', false);
%! t(string ('f')) = [];
