## Conversion to a value of type 'string', measured on R2024a
%!test
%! d = configureDictionary ('double', 'string');
%! d(1) = 5;
%! assert_equal (values (d, 'cell'), {string('5')});
%!test
%! d = configureDictionary ('double', 'string');
%! d(1) = int8 (5);
%! assert_equal (values (d, 'cell'), {string('5')});
%!test
%! d = configureDictionary ('double', 'string');
%! d(1) = true;
%! assert_equal (values (d, 'cell'), {string('true')});
%!test
%! d = configureDictionary ('double', 'string');
%! d(1) = 'x';
%! assert_equal (values (d, 'cell'), {string('x')});
%!test
%! d = configureDictionary ('double', 'string');
%! d(1) = '5';
%! assert_equal (values (d, 'cell'), {string('5')});
%!test
%! d = configureDictionary ('double', 'string');
%! d(1) = string ('x');
%! assert_equal (values (d, 'cell'), {string('x')});
%!test
%! d = configureDictionary ('double', 'string');
%! d(1) = string ('5');
%! assert_equal (values (d, 'cell'), {string('5')});
%!test
%! d = configureDictionary ('double', 'string');
%! d(1) = {'x'};
%! assert_equal (values (d, 'cell'), {string('x')});
%!test
%! d = configureDictionary ('double', 'string');
%! d(1) = {5};
%! assert_equal (values (d, 'cell'), {string('5')});
%!test
%! d = configureDictionary ('double', 'string');
%! d(1) = categorical ({'x'});
%! assert_equal (values (d, 'cell'), {string('x')});
%!test
%! d = configureDictionary ('double', 'string');
%! d(1) = datetime (2024, 1, 1);
%! assert_equal (values (d, 'cell'), {string('01-Jan-2024')});
%!test
%! d = configureDictionary ('double', 'string');
%! d(1) = hours (1);
%! assert_equal (values (d, 'cell'), {string('1 hr')});
%!test
%! d = configureDictionary ('double', 'string');
%! d(1) = calmonths (1);
%! assert_equal (values (d, 'cell'), {string('1mo')});
%!test
%! d = configureDictionary ('double', 'string');
%! d(1) = missing;
%! r = values (d, 'cell');
%! assert_equal (size (r), [1, 1]);
%! assert_equal (class (r{1}), 'string');
%! assert_equal (ismissing (r{1}), true);
%!error<dictionary.subsasgn: unable to use 'struct' as value of a dictionary of 'string' values.> ...
%! d = configureDictionary ('double', 'string');
%! d(1) = struct ('a', 1);
%!error<dictionary.subsasgn: unable to use 'table' as value of a dictionary of 'string' values.> ...
%! d = configureDictionary ('double', 'string');
%! d(1) = table (1);
%!error<dictionary.subsasgn: unable to use 'function_handle' as value of a dictionary of 'string' values.> ...
%! d = configureDictionary ('double', 'string');
%! d(1) = @sin;

