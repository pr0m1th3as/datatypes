## Keys of type 'handle', measured on R2024a
%!shared D, R, CV
%! D = dictionary (@sin, 10);
%! D(@cos) = 20;
%! D(@tan) = 30;
%! R = dictionary (@tan, 30);
%! R(@cos) = 20;
%! R(@sin) = 10;
%! CV = dictionary (@sin, {1});
%! CV(@cos) = {'two'};
%! CV(@tan) = {[3, 4]};
%!error<dictionary.keys: cannot join keys of type 'function_handle'; use the 'cell' format.> ...
%! keys (D);
%!assert_equal (values (D), [10; 20; 30])
%!assert_equal (keys (D, 'cell'), {@sin; @cos; @tan})
%!assert_equal (numEntries (D), 3)
%!assert_equal (D(@cos), 20)
%!assert_equal (isKey (D, @sin), true)
%!assert_equal (lookup (D, @cos), 20)
%!assert_equal (isKey (D, @log), false)
%!assert_equal (lookup (D, @log, 'FallbackValue', 0), 0)
%!error<dictionary.subsref: key not found.> ...
%! D(@log);
%!test
%! d = D;
%! d(@log) = [];
%! assert_equal (numEntries (d), 3);
%!test
%! d = D;
%! d = remove (d, @log);
%! assert_equal (numEntries (d), 3);
%!test
%! d = D;
%! d(@exp) = 40;
%! assert_equal (keys (d, 'cell'), {@sin; @cos; @tan; @exp});
%!test
%! d = D;
%! d = insert (d, @exp, 40);
%! assert_equal (values (d), [10; 20; 30; 40]);
%!test
%! d = D;
%! d(@sin) = 99;
%! assert_equal (values (d), [99; 20; 30]);
%!test
%! d = D;
%! d = insert (d, @sin, 99);
%! assert_equal (values (d), [99; 20; 30]);
%!test
%! d = D;
%! d = insert (d, @sin, 99, 'Overwrite', false);
%! assert_equal (values (d), [10; 20; 30]);
%!test
%! d = D;
%! d = remove (d, @sin);
%! assert_equal (keys (d, 'cell'), {@cos; @tan});
%!test
%! d = D;
%! d(@sin) = [];
%! assert_equal (values (d), [20; 30]);
%!test
%! d = D;
%! d = remove (d, @sin);
%! d(@sin) = 11;
%! assert_equal (values (d), [20; 30; 11]);
%!test
%! r = entries (D, 'struct');
%! assert_equal (size (r), [3, 1]);
%! assert_equal (fieldnames (r), {'Key'; 'Value'});
%! assert_equal (r(1).Key, @sin);
%! assert_equal (r(1).Value, 10);
%! assert_equal (r(2).Key, @cos);
%! assert_equal (r(2).Value, 20);
%! assert_equal (r(3).Key, @tan);
%! assert_equal (r(3).Value, 30);
%!assert_equal (entries (D, 'cell'), {@sin, 10; @cos, 20; @tan, 30})
%!error<dictionary.entries: a table cannot hold these entries; use the 'cell' or 'struct' format.> ...
%! entries (D);
%!assert_equal (isequal (D, R), true)
%!assert_equal (isequaln (D, R), true)
%!assert_equal (keyHash (D) == keyHash (R), false)
%!assert_equal (keyHash (D) == keyHash (D), true)
%!assert_equal (keyMatch (D, R), false)
%!assert_equal (CV{@cos}, 'two')
%!test
%! c = CV;
%! c{@sin} = 5;
%! assert_equal (c(@sin), {5});
%!test
%! c = CV;
%! c{@cos}(2) = 7;
%! r = c{@cos};
%! assert_equal (double (r), [116, 7, 111]);
%!error<dictionary.subsref: key not found.> ...
%! CV{@log};

## Keys of type 'datetime', measured on R2024a
