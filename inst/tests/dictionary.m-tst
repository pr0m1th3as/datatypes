%! assert_equal ([kt1, vt2], string ({'cell', 'double'}));
%! assert_equal (numEntries (r), 2);
%! assert_equal (keys (r, 'cell'), {{'a'}; {[1, 2]}});
%! assert_equal (values (r, 'cell'), {7; 7});
%!test
%! d = D;
%! d({'d'}) = 40;
%! assert_equal (keys (d, 'cell'), {{'a'}; {1}; {[1, 2]}; {'d'}});
