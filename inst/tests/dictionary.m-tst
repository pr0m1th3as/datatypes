## Expected values measured on MATLAB R2024a.

################################################################################
##                  ** Create and describe 'dictionary' **                    ##
################################################################################
##                             Available Methods                              ##
##                                                                            ##
## 'dictionary'       'types'            'isConfigured'     'numEntries'      ##
## 'numel'            'length'           'size'             'ndims'           ##
## 'isempty'                                                                  ##
##                                                                            ##
################################################################################

%!shared U, C
%! U = dictionary ();
%! C = configureDictionary ('string', 'double');

%!assert_equal (class (dictionary ()), 'dictionary')
%!assert_equal (isConfigured (dictionary ()), false)
%!test
%! d = dictionary (string ({'delta'; 'alpha'; 'charlie'; 'bravo'}), ...
%!                 [4; 1; 3; 2]);
%! assert_equal (keys (d), string ({'delta'; 'alpha'; 'charlie'; 'bravo'}));
%! assert_equal (values (d), [4; 1; 3; 2]);
%!test
%! d = dictionary ([5, 3, 9, 1], [50, 30, 90, 10]);
%! assert_equal (keys (d), [5; 3; 9; 1]);
%!test
%! ## A repeated key keeps its first position and takes its last value
%! d = dictionary (string ({'a'; 'b'; 'a'}), [1; 2; 3]);
%! assert_equal (keys (d), string ({'a'; 'b'}));
%! assert_equal (values (d), [3; 2]);
%!test
%! d = dictionary (string ({'a', 'b', 'c'}), [1, 2, 3]);
%! assert_equal (keys (d), string ({'a'; 'b'; 'c'}));
%! assert_equal (values (d), [1; 2; 3]);
%!test
%! d = dictionary (string ({'a', 'b'; 'c', 'd'}), [1, 2; 3, 4]);
%! assert_equal (keys (d), string ({'a'; 'c'; 'b'; 'd'}));
%! assert_equal (values (d), [1; 3; 2; 4]);
%!test
%! d = dictionary (string ({'a'; 'b'}), 1);
%! assert_equal (values (d), [1; 1]);
%!test
%! d = dictionary ('a', 1, 'b', 2);
%! assert_equal (keys (d), string ({'a'; 'b'}));
%! assert_equal (values (d), [1; 2]);
%!test
%! d = dictionary (string ('a'), 1, 'b', int8 (2));
%! [kt, vt] = types (d);
%! assert_equal (kt, string ('string'));
%! assert_equal (vt, string ('double'));
%! assert_equal (values (d), [1; 2]);
%!test
%! d = dictionary (1, 2, string ('a'), 3);
%! assert_equal (keys (d), [1; NaN]);
%!test
%! d = dictionary (string ({'a'; 'b'}), [1; 2], string ({'c'; 'a'}), [3; 4]);
%! assert_equal (keys (d), string ({'a'; 'b'; 'c'}));
%! assert_equal (values (d), [4; 2; 3]);
%!test
%! d = dictionary ('abc', 1);
%! assert_equal (keys (d), string ('abc'));
%!test
%! d = dictionary (['ab'; 'cd'], [1; 2]);
%! assert_equal (keys (d), string ({'ab'; 'cd'}));
%!test
%! d = dictionary ('abc', 'xyz');
%! [kt, vt] = types (d);
%! assert_equal (vt, string ('string'));
%! assert_equal (values (d), string ('xyz'));
%!test
%! d = dictionary (['ab'; 'cd'], ['xy'; 'zw']);
%! assert_equal (values (d), string ({'xy'; 'zw'}));
%!test
%! d = dictionary (string ({'a'; 'b'}), 'xy');
%! assert_equal (values (d), string ({'xy'; 'xy'}));
%!test
%! d = dictionary ('', 1);
%! assert_equal (keys (d), string (''));
%!test
%! d = dictionary ([], 1);
%! [kt, vt] = types (d);
%! assert_equal (kt, string ('double'));
%! assert_equal (vt, string ('double'));
%! assert_equal (numEntries (d), 0);
%!test
%! d = dictionary (string (cell (0, 0)), 5);
%! assert_equal (isConfigured (d), true);
%! assert_equal (numEntries (d), 0);
%!test
%! d = dictionary ({'a'; 'b'}, [1; 2]);
%! assert_equal (types (d), string ('cell'));
%! assert_equal (keys (d), {'a'; 'b'});
%!test
%! d = dictionary (string ({'a'; 'b'}), {1; 2});
%! assert_equal (values (d), {1; 2});
%!test
%! d = dictionary (string ({'a'; 'b'}), {1});
%! assert_equal (values (d), {1; 1});
%!test
%! d = dictionary ([0, -0], [1, 2]);
%! assert_equal (numEntries (d), 1);
%! assert_equal (values (d), 2);
%!test
%! d = dictionary ([1, NaN, 2, NaN], [10, 20, 30, 40]);
%! assert_equal (values (d), [10; 40; 30]);
%!test
%! d = dictionary ([1, 1+2i], [5, 6]);
%! assert_equal (keys (d), [1; 1+2i]);
%!test
%! d = dictionary (sparse ([1, 2]), [5, 6]);
%! assert_equal (issparse (keys (d)), false);
%! assert_equal (keys (d), [1; 2]);
%!test
%! d = dictionary (string ('t'), table (1));
%! assert_equal (types (d), string ('string'));
%! assert_equal (isequal (values (d), table (1)), true);
%!test
%! ## A table of any size is one value, given here to both keys
%! d = dictionary (string ({'a'; 'b'}), table ([1; 2]));
%! v = values (d, 'cell');
%! assert_equal (numEntries (d), 2);
%! assert_equal (isequal (v{2}, table ([1; 2])), true);
%!test
%! d = dictionary (string ('t'), timetable (seconds ([1; 2]), [1; 2]));
%! assert_equal (types (d), string ('string'));
%! assert_equal (numEntries (d), 1);
%!test
%! d = dictionary (@sin, 1);
%! assert_equal (types (d), string ('function_handle'));
%! assert_equal (numEntries (d), 1);
%!test
%! d = dictionary (string ({'a'; 'b'}), struct ('x', {1; 2}));
%! assert_equal (values (d), struct ('x', {1; 2}));
%!test
%! d = dictionary (datetime (2024, 1, [1; 2], 'TimeZone', 'Europe/Athens'), ...
%!                 [1; 2]);
%! k = keys (d);
%! assert_equal (k.TimeZone, 'Europe/Athens');
%!test
%! d = dictionary (categorical ({'a'; 'b'}), [1; 2], ...
%!                 categorical ({'c'}, {'c', 'z'}), 3);
%! assert_equal (categories (keys (d)), {'a'; 'b'; 'c'; 'z'});
%!error<dictionary: each key must be followed by a value.> dictionary (1)
%!error<dictionary: each key must be followed by a value.> dictionary (1, 2, 3)
%!error<dictionary: KEYS and VALUES must be the same size, or VALUES a scalar.> ...
%! dictionary (string ({'a'; 'b'; 'c'}), [1; 2])
%!error<dictionary: KEYS and VALUES must be the same size, or VALUES a scalar.> ...
%! dictionary (string ({'a', 'b'}), [1; 2])
%!error<dictionary: KEYS and VALUES must be the same size, or VALUES a scalar.> ...
%! dictionary (string ('a'), ['xy'; 'zw'])
%!error<dictionary: KEYS and VALUES must be the same size, or VALUES a scalar.> ...
%! dictionary ([], 1:3)
%!error<dictionary: KEYS and VALUES must be the same size, or VALUES a scalar.> ...
%! dictionary (string ('a'), {1, 2})
%!error<dictionary: unsupported key type 'table'.> dictionary (table (1), 1)
%!error<dictionary: unable to use 'cell' as key of a dictionary of 'double' keys.> ...
%! dictionary (1, 2, {3}, 4)
%!error<dictionary: unable to use 'cell' as value of a dictionary of 'double' values.> ...
%! dictionary (string ('a'), 1, string ('b'), {2})

%!test
%! [kt, vt] = types (U);
%! assert_equal (class (kt), 'string');
%! assert_equal (ismissing (kt), true);
%! assert_equal (class (vt), 'string');
%! assert_equal (ismissing (vt), true);
%!test
%! [kt, vt] = types (C);
%! assert_equal (kt, string ('string'));
%! assert_equal (vt, string ('double'));
%!assert_equal (types (C), string ('string'))

%!assert_equal (isConfigured (U), false)
%!assert_equal (isConfigured (C), true)

%!assert_equal (numEntries (U), 0)
%!assert_equal (numEntries (C), 0)

%!assert_equal (numel (U), 1)
%!assert_equal (numel (C), 1)

%!assert_equal (length (U), 1)
%!assert_equal (length (C), 1)

%!assert_equal (size (U), [1, 1])
%!assert_equal (size (C), [1, 1])
%!assert_equal (size (C, 1), 1)
%!assert_equal (size (C, 2), 1)
%!assert_equal (size (C, 3), 1)
%!assert_equal (size (C, [1, 2]), [1, 1])
%!assert_equal (size (C, 1, 2), [1, 1])
%!test
%! [r, c] = size (C);
%! assert_equal ([r, c], [1, 1]);
%!test
%! [r, c, p] = size (C);
%! assert_equal ([r, c, p], [1, 1, 1]);
%!test
%! [r, c] = size (C, [1, 2]);
%! assert_equal ([r, c], [1, 1]);
%!error<dictionary.size: DIM must be positive integers.> size (C, 0)
%!error<dictionary.size: DIM must be positive integers.> size (C, 1.5)
%!error<dictionary.size: DIM must be positive integers.> size (C, [])
%!error<dictionary.size: DIM must be positive integers.> size (C, 'a')
%!error<dictionary.size: DIM must be positive integers.> size (C, 1, 0)
%!error<dictionary.size: each dimension must be a scalar.> size (C, 1, [1, 2])

%!assert_equal (ndims (U), 2)
%!assert_equal (ndims (C), 2)

%!assert_equal (isempty (U), false)
%!assert_equal (isempty (C), false)

################################################################################
##                          ** Keys and values **                             ##
################################################################################
##                             Available Methods                              ##
##                                                                            ##
## 'keys'             'values'           'isKey'                              ##
##                                                                            ##
################################################################################

%!shared D, C
%! D = dictionary (string ({'a'; 'b'; 'c'}), [1; 2; 3]);
%! C = configureDictionary ('string', 'double');

%!assert_equal (keys (D), string ({'a'; 'b'; 'c'}))
%!assert_equal (keys (D, 'uniform'), string ({'a'; 'b'; 'c'}))
%!assert_equal (keys (D, 'cell'), {string('a'); string('b'); string('c')})
%!assert_equal (keys (D, string ('cell')), ...
%!              {string('a'); string('b'); string('c')})
%!assert_equal (keys (C), string (cell (0, 1)))
%!assert_equal (keys (C, 'cell'), cell (0, 1))
%!assert_equal (keys (dictionary ({'a'; 'b'}, [1; 2]), 'cell'), {{'a'}; {'b'}})
%!assert_equal (keys (dictionary (@sin, 1)), @sin)
%!test
%! k = keys (configureDictionary ('datetime', 'double'));
%! assert_equal (class (k), 'datetime');
%! assert_equal (size (k), [0, 1]);
%!error<dictionary.keys: D is not configured.> keys (dictionary ())
%!error<dictionary.keys: FORMAT must be a character vector or a string scalar.> ...
%! keys (D, 1)
%!error<dictionary.keys: invalid format 'foo'.> keys (D, 'foo')
%!error<dictionary.keys: cannot join keys of type 'function_handle'; use the 'cell' format.> ...
%! keys (dictionary (@sin, 1, @cos, 2))

%!assert_equal (values (D), [1; 2; 3])
%!assert_equal (values (D, 'uniform'), [1; 2; 3])
%!assert_equal (values (D, 'cell'), {1; 2; 3})
%!assert_equal (values (C), zeros (0, 1))
%!assert_equal (values (dictionary (string ('f'), @sin)), @sin)
%!test
%! d = dictionary (string ({'f'; 'g'}), {@sin; @cos});
%! assert_equal (values (d), {@sin; @cos});
%!test
%! d = dictionary (string ('a'), struct ('x', 1), ...
%!                 string ('b'), struct ('y', 2));
%! v = values (d, 'cell');
%! assert_equal (v{2}, struct ('y', 2));
%!test
%! d = dictionary (string ('a'), table (1), string ('b'), table (2));
%! assert_equal (isequal (values (d), table ([1; 2])), true);
%!error<dictionary.values: D is not configured.> values (dictionary ())
%!error<dictionary.values: FORMAT must be a character vector or a string scalar.> ...
%! values (D, string ({'b'; 'a'}))
%!error<dictionary.values: invalid format 'foo'.> values (D, 'foo')
%!error<dictionary.values: cannot join values of type 'struct'; use the 'cell' format.> ...
%! values (dictionary (string ('a'), struct ('x', 1), ...
%!                     string ('b'), struct ('y', 2)))
%!error<dictionary.values: cannot join values of type 'table'; use the 'cell' format.> ...
%! values (dictionary (string ('a'), table ([1; 2]), string ('b'), table (3)))
%!error<dictionary.values: cannot join values of type 'function_handle'; use the 'cell' format.> ...
%! values (dictionary (string ('f'), @sin, string ('g'), @cos))
%!error<dictionary.values: cannot join values of type 'dictionary'; use the 'cell' format.> ...
%! values (dictionary (string ('a'), dictionary (1, 2), ...
%!                     string ('b'), dictionary (3, 4)))

%!assert_equal (isKey (D, string ('a')), true)
%!assert_equal (isKey (D, string ('z')), false)
%!assert_equal (isKey (D, string ({'a'; 'z'})), [true; false])
%!assert_equal (isKey (D, string ({'a', 'z'; 'c', 'b'})), ...
%!              [true, false; true, true])
%!assert_equal (isKey (D, string (cell (0, 0))), false (0, 0))
%!assert_equal (isKey (D, []), false (0, 0))
%!assert_equal (isKey (D, 'a'), true)
%!assert_equal (isKey (D, {'a'}), true)
%!assert_equal (isKey (D, 1), false)
%!assert_equal (isKey (D, datetime (2024, 1, 1)), false)
%!assert_equal (isKey (dictionary ([1; 2], [3; 4]), string ('1')), true)
%!assert_equal (isKey (dictionary ([1; 2], [3; 4]), string ('abc')), false)
%!assert_equal (isKey (dictionary ([1; 2], [3; 4]), 'a'), false)
%!assert_equal (isKey (dictionary ([1; 2], [3; 4]), NaN), false)
%!assert_equal (isKey (dictionary ({'a'; 'b'}, [1; 2]), {'a'; 'z'}), ...
%!              [true; false])
%!assert_equal (isKey (dictionary (int8 ([1, 2]), [5, 6]), 1.4), true)
%!assert_equal (isKey (dictionary (int8 ([1, 2]), [5, 6]), 300), false)
%!assert_equal (isKey (C, string ('a')), false)
%!error<dictionary.isKey: invalid number of input arguments.> isKey (D)
%!error<dictionary.isKey: D is not configured.> isKey (dictionary (), string ('a'))
%!error<dictionary.isKey: unable to use 'cell' as key of a dictionary of 'double' keys.> ...
%! isKey (dictionary ([1; 2], [3; 4]), {1})
%!error<dictionary.isKey: unable to use 'char' as key of a dictionary of 'cell' keys.> ...
%! isKey (dictionary ({'a'; 'b'}, [1; 2]), 'a')

################################################################################
##                    ** Indexing and concatenation **                        ##
################################################################################
##                             Available Methods                              ##
##                                                                            ##
## 'subsref'          'subsasgn'         'end'                                ##
## 'horzcat'          'vertcat'          'cat'                                ##
##                                                                            ##
################################################################################

%!shared D, CV, C
%! D = dictionary (string ({'a'; 'b'; 'c'}), [1; 2; 3]);
%! CV = dictionary (string ({'a'; 'b'}), {[1, 2, 3]; [4, 5]});
%! C = configureDictionary ('string', 'double');

%!assert_equal (D(string ('b')), 2)
%!assert_equal (D(string ({'c'; 'a'})), [3; 1])
%!assert_equal (D(string ({'a', 'b'; 'c', 'a'})), [1, 2; 3, 1])
%!assert_equal (D('a'), 1)
%!assert_equal (D({'a'}), 1)
%!assert_equal (D([]), zeros (0, 0))
%!assert_equal (D(string (cell (0, 1))), zeros (0, 1))
%!assert_equal (D(string ('a'))(1), 1)
%!assert_equal (CV{string('a')}, [1, 2, 3])
%!assert_equal (CV{string('a')}(2), 2)
%!test
%! [p, q] = CV{string({'a'; 'b'})};
%! assert_equal (p, [1, 2, 3]);
%! assert_equal (q, [4, 5]);
%!test
%! x = {CV{string({'b'; 'a'})}};
%! assert_equal (x, {[4, 5], [1, 2, 3]});
%!test
%! d = dictionary (string ({'a'; 'b'}), struct ('x', {1; 2}));
%! assert_equal (d(string ('b')).x, 2);
%!assert_equal (D.keys (), string ({'a'; 'b'; 'c'}))
%!assert_equal (D.keys ('cell'), {string('a'); string('b'); string('c')})
%!assert_equal (D.isKey (string ('a')), true)
%!assert_equal (D.numEntries, 3)
%!test
%! [kt, vt] = D.types ();
%! assert_equal (kt, string ('string'));
%! assert_equal (vt, string ('double'));
%!assert_equal (keys (D'), string ({'a'; 'b'; 'c'}))
%!error<dictionary.subsref: key not found.> D(string ('z'))
%!error<dictionary.subsref: key not found.> D(true)
%!error<dictionary.subsref: element 2 of the keys not found.> ...
%! D(string ({'a'; 'z'}))
%!error<dictionary.subsref: index with one array of keys.> D(1, 2)
%!error<dictionary.subsref: ':' is not supported; use 'keys' or 'values'.> D(:)
%!error<dictionary.subsref: D is not configured.> ...
%! d = dictionary (); d(string ('a'))
%!error<dictionary.subsref: unable to use 'cell' as key of a dictionary of 'double' keys.> ...
%! d = dictionary ([1; 2], [3; 4]); d({1})
%!error<dictionary.subsref: cannot join values of type 'function_handle'; look up each key separately.> ...
%! d = dictionary (string ('f'), @sin); d(string ({'f'; 'f'}))
%!error<dictionary.subsref: '{}' indexing needs a dictionary of 'cell' values.> ...
%! D{string('a')}
%!error<dictionary.subsref: key not found.> CV{string('z')}
%!error<dictionary.subsref: no method named 'foo'.> D.foo

%!test
%! d = D;
%! d(string ('z')) = 26;
%! assert_equal (keys (d), string ({'a'; 'b'; 'c'; 'z'}));
%! assert_equal (values (d), [1; 2; 3; 26]);
%!test
%! ## Updating a value keeps the key's position
%! d = D;
%! d(string ('a')) = 11;
%! assert_equal (keys (d), string ({'a'; 'b'; 'c'}));
%! assert_equal (values (d), [11; 2; 3]);
%!test
%! d = D;
%! d(string ({'x', 'y'})) = [7, 8];
%! assert_equal (values (d), [1; 2; 3; 7; 8]);
%!test
%! d = D;
%! d(string ({'x'; 'y'})) = 9;
%! assert_equal (values (d), [1; 2; 3; 9; 9]);
%!test
%! d = D;
%! d(string ('e')) = string ('12');
%! assert_equal (d(string ('e')), 12);
%!test
%! d = D;
%! d(5) = 1;
%! assert_equal (keys (d), string ({'a'; 'b'; 'c'; '5'}));
%!test
%! d = D;
%! d(string (cell (0, 1))) = 5;
%! assert_equal (numEntries (d), 3);
%!test
%! d = D;
%! d(string ({'a'; 'nope'})) = [];
%! assert_equal (keys (d), string ({'b'; 'c'}));
%!test
%! d = D;
%! d({'b'}) = [];
%! assert_equal (keys (d), string ({'a'; 'c'}));
%!test
%! d = D;
%! d([]) = [];
%! assert_equal (numEntries (d), 3);
%!test
%! ## A key removed and added again goes to the end
%! d = D;
%! d(string ('b')) = [];
%! d(string ('b')) = 22;
%! assert_equal (keys (d), string ({'a'; 'c'; 'b'}));
%! assert_equal (values (d), [1; 3; 22]);
%!test
%! d = D;
%! e = d;
%! e(string ('a')) = [];
%! assert_equal (numEntries (d), 3);
%! assert_equal (numEntries (e), 2);
%!test
%! d = dictionary (string ({'a'; 'b'}), string ({'x'; 'y'}));
%! d(string ('a')) = '';
%! assert_equal (values (d), string ({''; 'y'}));
%!test
%! d = dictionary ();
%! d(string (cell (0, 1))) = 5;
%! assert_equal (isConfigured (d), true);
%!test
%! d = dictionary ();
%! d('abc') = 'xyz';
%! assert_equal (types (d), string ('string'));
%! assert_equal (values (d), string ('xyz'));
%!test
%! d = CV;
%! d{string('a')}(2) = 20;
%! assert_equal (d{string('a')}, [1, 20, 3]);
%!test
%! d = CV;
%! d{string('c')} = 7;
%! assert_equal (values (d), {[1, 2, 3]; [4, 5]; 7});
%!test
%! ## '{} = []' stores an empty value, '() = []' deletes
%! d = CV;
%! d{string('b')} = [];
%! assert_equal (values (d), {[1, 2, 3]; []});
%! d(string ('a')) = [];
%! assert_equal (keys (d), string ('b'));
%!test
%! d = dictionary ();
%! d{string('a')} = 1;
%! assert_equal (types (d), string ('string'));
%! assert_equal (values (d), {1});
%!test
%! d = dictionary (string ({'a'; 'b'}), struct ('x', {1; 2}));
%! d(string ('a')).x = 10;
%! assert_equal (d(string ('a')), struct ('x', 10));
%!error<dictionary.subsasgn: KEYS and VALUES must be the same size, or VALUES a scalar.> ...
%! d = D; d(string ({'p', 'q'})) = [7; 8];
%!error<dictionary.subsasgn: KEYS and VALUES must be the same size, or VALUES a scalar.> ...
%! d = D; d(string ('m')) = zeros (0, 0, 'single');
%!error<dictionary.subsasgn: KEYS and VALUES must be the same size, or VALUES a scalar.> ...
%! d = CV; d(string ('a')) = {};
%!error<dictionary.subsasgn: unable to use 'cell' as value of a dictionary of 'double' values.> ...
%! d = D; d(string ('a')) = {1};
%!error<dictionary.subsasgn: index with one array of keys.> ...
%! d = D; d(1, 2) = 3;
%!error<dictionary.subsasgn: D is not configured.> ...
%! d = dictionary (); d(string ('a')) = [];
%!error<dictionary.subsref: D is not configured.> ...
%! d = dictionary (); d(string ('a')).x = 1;
%!error<dictionary.subsasgn: '{}' indexing needs a dictionary of 'cell' values.> ...
%! d = D; d{string('a')} = 1;
%!error<dictionary.subsasgn: '{}' assignment takes a single key.> ...
%! d = CV; d{string({'a'; 'b'})} = 5;
%!error<dictionary.subsasgn: a dictionary has no properties to assign.> ...
%! d = D; d.foo = 1;
%!error<dictionary.subsasgn: unsupported key type 'table'.> ...
%! d = dictionary (); d(table (1)) = 1;

%!error<dictionary.end: 'end' is not supported for a dictionary.> D(end)

## The bracket forms raise core's own 'cat: dictionary/horzcat method failed'
## wrapper, which is not ours to test, so call the methods directly.
%!error<dictionary.horzcat: dictionaries cannot be concatenated.> horzcat (C, C)
%!error<dictionary.horzcat: dictionaries cannot be concatenated.> horzcat (C, 1)
%!error<dictionary.horzcat: dictionaries cannot be concatenated.> horzcat (1, C)
%!error<dictionary.horzcat: dictionaries cannot be concatenated.> horzcat (C)

%!error<dictionary.vertcat: dictionaries cannot be concatenated.> vertcat (C, C)
%!error<dictionary.vertcat: dictionaries cannot be concatenated.> vertcat (C, 1)
%!error<dictionary.vertcat: dictionaries cannot be concatenated.> vertcat (C)

%!error<dictionary.cat: dictionaries cannot be concatenated.> cat (1, C, C)
