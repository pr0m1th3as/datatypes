## Conversion to a value of type 'single', measured on R2024a
%!test
%! d = configureDictionary ('double', 'single');
%! d(1) = 5;
%! assert_equal (values (d, 'cell'), {single(5)});
%!test
%! d = configureDictionary ('double', 'single');
%! d(1) = int8 (5);
%! assert_equal (values (d, 'cell'), {single(5)});
%!test
%! d = configureDictionary ('double', 'single');
%! d(1) = true;
%! assert_equal (values (d, 'cell'), {single(1)});
%!test
%! d = configureDictionary ('double', 'single');
%! d(1) = 'x';
%! assert_equal (values (d, 'cell'), {single(120)});
%!test
%! d = configureDictionary ('double', 'single');
%! d(1) = '5';
%! assert_equal (values (d, 'cell'), {single(53)});
%!error<dictionary.subsasgn: unable to use 'string' as value of a dictionary of 'single' values.> ...
%! d = configureDictionary ('double', 'single');
%! d(1) = string ('x');
%!error<dictionary.subsasgn: unable to use 'string' as value of a dictionary of 'single' values.> ...
%! d = configureDictionary ('double', 'single');
%! d(1) = string ('5');
%!error<dictionary.subsasgn: unable to use 'cell' as value of a dictionary of 'single' values.> ...
%! d = configureDictionary ('double', 'single');
%! d(1) = {'x'};
%!error<dictionary.subsasgn: unable to use 'cell' as value of a dictionary of 'single' values.> ...
%! d = configureDictionary ('double', 'single');
%! d(1) = {5};
%!test
%! d = configureDictionary ('double', 'single');
%! d(1) = categorical ({'x'});
%! assert_equal (values (d, 'cell'), {single(1)});
%!error<dictionary.subsasgn: unable to use 'datetime' as value of a dictionary of 'single' values.> ...
%! d = configureDictionary ('double', 'single');
%! d(1) = datetime (2024, 1, 1);
%!error<dictionary.subsasgn: unable to use 'duration' as value of a dictionary of 'single' values.> ...
%! d = configureDictionary ('double', 'single');
%! d(1) = hours (1);
%!error<dictionary.subsasgn: unable to use 'calendarDuration' as value of a dictionary of 'single' values.> ...
%! d = configureDictionary ('double', 'single');
%! d(1) = calmonths (1);
%!test
%! d = configureDictionary ('double', 'single');
%! d(1) = missing;
%! assert_equal (values (d, 'cell'), {single(NaN)});
%!error<dictionary.subsasgn: unable to use 'struct' as value of a dictionary of 'single' values.> ...
%! d = configureDictionary ('double', 'single');
%! d(1) = struct ('a', 1);
%!error<dictionary.subsasgn: unable to use 'table' as value of a dictionary of 'single' values.> ...
%! d = configureDictionary ('double', 'single');
%! d(1) = table (1);
%!error<dictionary.subsasgn: unable to use 'function_handle' as value of a dictionary of 'single' values.> ...
%! d = configureDictionary ('double', 'single');
%! d(1) = @sin;

