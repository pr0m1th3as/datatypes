## Expected values measured on MATLAB R2024a.

################################################################################
##                  ** Create and describe 'dictionary' **                    ##
################################################################################
##                             Available Methods                              ##
##                                                                            ##
## 'dictionary'       'types'            'isConfigured'     'numEntries'      ##
## 'numel'            'length'           'size'             'ndims'           ##
## 'isempty'          'dispstrings'                                           ##
##                                                                            ##
################################################################################

%!shared U, C
%! U = dictionary ();
%! C = configureDictionary ('string', 'double');

%!assert_equal (class (dictionary ()), 'dictionary')
%!assert_equal (isConfigured (dictionary ()), false)
%!test
%! d = dictionary (string ({'delta'; 'alpha'; 'charlie'; 'bravo'}), ...
%!                 [4; 1; 3; 2]);
%! assert_equal (keys (d), string ({'delta'; 'alpha'; 'charlie'; 'bravo'}));
%! assert_equal (values (d), [4; 1; 3; 2]);
%!test
%! d = dictionary ([5, 3, 9, 1], [50, 30, 90, 10]);
%! assert_equal (keys (d), [5; 3; 9; 1]);
%!test
%! ## A repeated key keeps its first position and takes its last value
%! d = dictionary (string ({'a'; 'b'; 'a'}), [1; 2; 3]);
%! assert_equal (keys (d), string ({'a'; 'b'}));
%! assert_equal (values (d), [3; 2]);
%!test
%! d = dictionary (string ({'a', 'b', 'c'}), [1, 2, 3]);
%! assert_equal (keys (d), string ({'a'; 'b'; 'c'}));
%! assert_equal (values (d), [1; 2; 3]);
%!test
%! d = dictionary (string ({'a', 'b'; 'c', 'd'}), [1, 2; 3, 4]);
%! assert_equal (keys (d), string ({'a'; 'c'; 'b'; 'd'}));
%! assert_equal (values (d), [1; 3; 2; 4]);
%!test
%! d = dictionary (string ({'a'; 'b'}), 1);
%! assert_equal (values (d), [1; 1]);
%!test
%! d = dictionary ('a', 1, 'b', 2);
%! assert_equal (keys (d), string ({'a'; 'b'}));
%! assert_equal (values (d), [1; 2]);
%!test
%! d = dictionary (string ('a'), 1, 'b', int8 (2));
%! [kt, vt] = types (d);
%! assert_equal (kt, string ('string'));
%! assert_equal (vt, string ('double'));
%! assert_equal (values (d), [1; 2]);
%!test
%! d = dictionary (1, 2, string ('a'), 3);
%! assert_equal (keys (d), [1; NaN]);
%!test
%! d = dictionary (string ({'a'; 'b'}), [1; 2], string ({'c'; 'a'}), [3; 4]);
%! assert_equal (keys (d), string ({'a'; 'b'; 'c'}));
%! assert_equal (values (d), [4; 2; 3]);
%!test
%! d = dictionary ('abc', 1);
%! assert_equal (keys (d), string ('abc'));
%!test
%! d = dictionary (['ab'; 'cd'], [1; 2]);
%! assert_equal (keys (d), string ({'ab'; 'cd'}));
%!test
%! d = dictionary ('abc', 'xyz');
%! [kt, vt] = types (d);
%! assert_equal (vt, string ('string'));
%! assert_equal (values (d), string ('xyz'));
%!test
%! d = dictionary (['ab'; 'cd'], ['xy'; 'zw']);
%! assert_equal (values (d), string ({'xy'; 'zw'}));
%!test
%! d = dictionary (string ({'a'; 'b'}), 'xy');
%! assert_equal (values (d), string ({'xy'; 'xy'}));
%!test
%! d = dictionary ('', 1);
%! assert_equal (keys (d), string (''));
%!test
%! d = dictionary ([], 1);
%! [kt, vt] = types (d);
%! assert_equal (kt, string ('double'));
%! assert_equal (vt, string ('double'));
%! assert_equal (numEntries (d), 0);
%!test
%! d = dictionary (string (cell (0, 0)), 5);
%! assert_equal (isConfigured (d), true);
%! assert_equal (numEntries (d), 0);
%!test
%! d = dictionary ({'a'; 'b'}, [1; 2]);
%! assert_equal (types (d), string ('cell'));
%! assert_equal (keys (d), {'a'; 'b'});
%!test
%! d = dictionary (string ({'a'; 'b'}), {1; 2});
%! assert_equal (values (d), {1; 2});
%!test
%! d = dictionary (string ({'a'; 'b'}), {1});
%! assert_equal (values (d), {1; 1});
%!test
%! d = dictionary ([0, -0], [1, 2]);
%! assert_equal (numEntries (d), 1);
%! assert_equal (values (d), 2);
%!test
%! d = dictionary ([1, NaN, 2, NaN], [10, 20, 30, 40]);
%! assert_equal (values (d), [10; 40; 30]);
%!test
%! d = dictionary ([1, 1+2i], [5, 6]);
%! assert_equal (keys (d), [1; 1+2i]);
%!test
%! d = dictionary (sparse ([1, 2]), [5, 6]);
%! assert_equal (issparse (keys (d)), false);
%! assert_equal (keys (d), [1; 2]);
%!test
%! d = dictionary (string ('t'), table (1));
%! assert_equal (types (d), string ('string'));
%! assert_equal (isequal (values (d), table (1)), true);
%!test
%! ## A table of any size is one value, given here to both keys
%! d = dictionary (string ({'a'; 'b'}), table ([1; 2]));
%! v = values (d, 'cell');
%! assert_equal (numEntries (d), 2);
%! assert_equal (isequal (v{2}, table ([1; 2])), true);
%!test
%! d = dictionary (string ('t'), timetable (seconds ([1; 2]), [1; 2]));
%! assert_equal (types (d), string ('string'));
%! assert_equal (numEntries (d), 1);
%!test
%! d = dictionary (@sin, 1);
%! assert_equal (types (d), string ('function_handle'));
%! assert_equal (numEntries (d), 1);
%!test
%! d = dictionary (string ({'a'; 'b'}), struct ('x', {1; 2}));
%! assert_equal (values (d), struct ('x', {1; 2}));
%!test
%! d = dictionary (datetime (2024, 1, [1; 2], 'TimeZone', 'Europe/Athens'), ...
%!                 [1; 2]);
%! k = keys (d);
%! assert_equal (k.TimeZone, 'Europe/Athens');
%!test
%! d = dictionary (categorical ({'a'; 'b'}), [1; 2], ...
%!                 categorical ({'c'}, {'c', 'z'}), 3);
%! assert_equal (categories (keys (d)), {'a'; 'b'; 'c'; 'z'});
%!error<dictionary: each key must be followed by a value.> dictionary (1)
%!error<dictionary: each key must be followed by a value.> dictionary (1, 2, 3)
%!error<dictionary: KEYS and VALUES must be the same size, or VALUES a scalar.> ...
%! dictionary (string ({'a'; 'b'; 'c'}), [1; 2])
%!error<dictionary: KEYS and VALUES must be the same size, or VALUES a scalar.> ...
%! dictionary (string ({'a', 'b'}), [1; 2])
%!error<dictionary: KEYS and VALUES must be the same size, or VALUES a scalar.> ...
%! dictionary (string ('a'), ['xy'; 'zw'])
%!error<dictionary: KEYS and VALUES must be the same size, or VALUES a scalar.> ...
%! dictionary ([], 1:3)
%!error<dictionary: KEYS and VALUES must be the same size, or VALUES a scalar.> ...
%! dictionary (string ('a'), {1, 2})
%!error<dictionary: unsupported key type 'table'.> dictionary (table (1), 1)
%!error<dictionary: unable to use 'cell' as key of a dictionary of 'double' keys.> ...
%! dictionary (1, 2, {3}, 4)
%!error<dictionary: unsupported input type 'table'.> dictionary ({table(1)}, 1)
%!error<dictionary: unable to use 'cell' as value of a dictionary of 'double' values.> ...
%! dictionary (string ('a'), 1, string ('b'), {2})

%!test
%! [kt, vt] = types (U);
%! assert_equal (class (kt), 'string');
%! assert_equal (ismissing (kt), true);
%! assert_equal (class (vt), 'string');
%! assert_equal (ismissing (vt), true);
%!test
%! [kt, vt] = types (C);
%! assert_equal (kt, string ('string'));
%! assert_equal (vt, string ('double'));
%!assert_equal (types (C), string ('string'))

%!assert_equal (isConfigured (U), false)
%!assert_equal (isConfigured (C), true)

%!assert_equal (numEntries (U), 0)
%!assert_equal (numEntries (C), 0)

%!assert_equal (numel (U), 1)
%!assert_equal (numel (C), 1)

%!assert_equal (length (U), 1)
%!assert_equal (length (C), 1)

%!assert_equal (size (U), [1, 1])
%!assert_equal (size (C), [1, 1])
%!assert_equal (size (C, 1), 1)
%!assert_equal (size (C, 2), 1)
%!assert_equal (size (C, 3), 1)
%!assert_equal (size (C, [1, 2]), [1, 1])
%!assert_equal (size (C, 1, 2), [1, 1])
%!test
%! [r, c] = size (C);
%! assert_equal ([r, c], [1, 1]);
%!test
%! [r, c, p] = size (C);
%! assert_equal ([r, c, p], [1, 1, 1]);
%!test
%! [r, c] = size (C, [1, 2]);
%! assert_equal ([r, c], [1, 1]);
%!error<dictionary.size: DIM must be positive integers.> size (C, 0)
%!error<dictionary.size: DIM must be positive integers.> size (C, 1.5)
%!error<dictionary.size: DIM must be positive integers.> size (C, [])
%!error<dictionary.size: DIM must be positive integers.> size (C, 'a')
%!error<dictionary.size: DIM must be positive integers.> size (C, 1, 0)
%!error<dictionary.size: each dimension must be a scalar.> size (C, 1, [1, 2])

%!assert_equal (ndims (U), 2)
%!assert_equal (ndims (C), 2)

%!assert_equal (isempty (U), false)
%!assert_equal (isempty (C), false)

%!assert_equal (dispstrings (U), {'dictionary with unset key and value types'})
%!assert_equal (dispstrings (C), ...
%!              {'dictionary (string ⟼ double) with no entries'})
%!assert_equal (dispstrings (dictionary (1, 2)), ...
%!              {'dictionary (double ⟼ double) with 1 entry'})
%!assert_equal (dispstrings (dictionary ([1, 2], {3, 4})), ...
%!              {'dictionary (double ⟼ cell) with 2 entries'})
%!assert_equal (dispstrings (dictionary (string ('a'), dictionary (1, 2))), ...
%!              {'dictionary (string ⟼ dictionary) with 1 entry'})
%!assert_equal (U.dispstrings (), {'dictionary with unset key and value types'})

%!assert_equal (properties (U), cell (0, 1))
%!assert_equal (properties (C), cell (0, 1))
%!assert_equal (fieldnames (C), cell (0, 1))

%!test
%! s = struct ('d', C);
%! assert_equal (isdictionary (s.d), true);
%!test
%! s = struct ('a', {C, 5});
%! assert_equal (size (s), [1, 2]);
%! assert_equal (isdictionary (s(1).a), true);
%!error<dictionary.struct: cannot convert a dictionary to a structure.> ...
%! struct (C)
%!error<dictionary.jsonencode: cannot encode a dictionary as JSON text.> ...
%! jsonencode (C)
%!error<dictionary.jsonencode: cannot encode a dictionary as JSON text.> ...
%! jsonencode (U, 'PrettyPrint', true)
%!error<dictionary.empty: a dictionary cannot be an empty array.> ...
%! dictionary.empty ()
%!error<dictionary.empty: a dictionary cannot be an empty array.> ...
%! dictionary.empty (0, 0)

## Construction, measured on R2024a
%!test
%! r = dictionary (1, 2);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'double'}));
%! assert_equal (numEntries (r), 1);
%! assert_equal (keys (r, 'cell'), {1});
%! assert_equal (values (r, 'cell'), {2});
%!test
%! r = dictionary ([1, 2, 3], [4, 5, 6]);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'double'}));
%! assert_equal (numEntries (r), 3);
%! assert_equal (keys (r, 'cell'), {1; 2; 3});
%! assert_equal (values (r, 'cell'), {4; 5; 6});
%!error<dictionary: KEYS and VALUES must be the same size, or VALUES a scalar.> ...
%! dictionary ([1; 2; 3], [4, 5, 6]);
%!test
%! r = dictionary ([1, 2; 3, 4], [5, 6; 7, 8]);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'double'}));
%! assert_equal (numEntries (r), 4);
%! assert_equal (keys (r, 'cell'), {1; 3; 2; 4});
%! assert_equal (values (r, 'cell'), {5; 7; 6; 8});
%!error<dictionary: KEYS and VALUES must be the same size, or VALUES a scalar.> ...
%! dictionary ([1, 2; 3, 4], [5, 6, 7, 8]);
%!test
%! r = dictionary ([1, 2, 3], 7);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'double'}));
%! assert_equal (numEntries (r), 3);
%! assert_equal (keys (r, 'cell'), {1; 2; 3});
%! assert_equal (values (r, 'cell'), {7; 7; 7});
%!error<dictionary: KEYS and VALUES must be the same size, or VALUES a scalar.> ...
%! dictionary (7, [1, 2, 3]);
%!error<dictionary: KEYS and VALUES must be the same size, or VALUES a scalar.> ...
%! dictionary ([1, 2], [1, 2, 3]);
%!test
%! r = dictionary ([], []);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'double'}));
%! assert_equal (numEntries (r), 0);
%!test
%! r = dictionary (zeros (1, 0), zeros (1, 0));
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'double'}));
%! assert_equal (numEntries (r), 0);
%!test
%! r = dictionary (zeros (0, 3), zeros (0, 3));
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'double'}));
%! assert_equal (numEntries (r), 0);
%!test
%! r = dictionary ([1, 2, 1], [10, 20, 30]);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'double'}));
%! assert_equal (numEntries (r), 2);
%! assert_equal (keys (r, 'cell'), {1; 2});
%! assert_equal (values (r, 'cell'), {30; 20});
%!test
%! r = dictionary ([NaN, NaN, 1], [1, 2, 3]);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'double'}));
%! assert_equal (numEntries (r), 2);
%! assert_equal (keys (r, 'cell'), {NaN; 1});
%! assert_equal (values (r, 'cell'), {2; 3});
%!test
%! r = dictionary ([0, -0], [1, 2]);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'double'}));
%! assert_equal (numEntries (r), 1);
%! assert_equal (keys (r, 'cell'), {0});
%! assert_equal (values (r, 'cell'), {2});
%!test
%! r = dictionary ([Inf, -Inf], [1, 2]);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'double'}));
%! assert_equal (numEntries (r), 2);
%! assert_equal (keys (r, 'cell'), {Inf; -Inf});
%! assert_equal (values (r, 'cell'), {1; 2});
%!test
%! r = dictionary (single ([1, 2]), [3, 4]);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'single', 'double'}));
%! assert_equal (numEntries (r), 2);
%! assert_equal (keys (r, 'cell'), {single(1); single(2)});
%! assert_equal (values (r, 'cell'), {3; 4});
%!test
%! r = dictionary (int8 ([1, 2]), [3, 4]);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'int8', 'double'}));
%! assert_equal (numEntries (r), 2);
%! assert_equal (keys (r, 'cell'), {int8(1); int8(2)});
%! assert_equal (values (r, 'cell'), {3; 4});
%!test
%! r = dictionary (intmax ('uint64'), 1);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'uint64', 'double'}));
%! assert_equal (numEntries (r), 1);
%! assert_equal (keys (r, 'cell'), {intmax('uint64')});
%! assert_equal (values (r, 'cell'), {1});
%!test
%! r = dictionary ([intmax('uint64') - 1, intmax('uint64')], [1, 2]);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'uint64', 'double'}));
%! assert_equal (numEntries (r), 2);
%! assert_equal (keys (r, 'cell'), {intmax('uint64') - 1; intmax('uint64')});
%! assert_equal (values (r, 'cell'), {1; 2});
%!test
%! r = dictionary ([intmin('int64'), intmin('int64') + 1], [1, 2]);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'int64', 'double'}));
%! assert_equal (numEntries (r), 2);
%! assert_equal (keys (r, 'cell'), {intmin('int64'); intmin('int64') + 1});
%! assert_equal (values (r, 'cell'), {1; 2});
%!test
%! r = dictionary ([true, false, true], [1, 2, 3]);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'logical', 'double'}));
%! assert_equal (numEntries (r), 2);
%! assert_equal (keys (r, 'cell'), {true; false});
%! assert_equal (values (r, 'cell'), {3; 2});
%!test
%! r = dictionary ('a', 1);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'string', 'double'}));
%! assert_equal (numEntries (r), 1);
%! assert_equal (keys (r, 'cell'), {string('a')});
%! assert_equal (values (r, 'cell'), {1});
%!test
%! r = dictionary ('abc', 1);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'string', 'double'}));
%! assert_equal (numEntries (r), 1);
%! assert_equal (keys (r, 'cell'), {string('abc')});
%! assert_equal (values (r, 'cell'), {1});
%!error<dictionary: KEYS and VALUES must be the same size, or VALUES a scalar.> ...
%! dictionary (['ab'; 'cd'], [1, 2]);
%!test
%! r = dictionary (['ab'; 'cd'], [1; 2]);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'string', 'double'}));
%! assert_equal (numEntries (r), 2);
%! assert_equal (keys (r, 'cell'), {string('ab'); string('cd')});
%! assert_equal (values (r, 'cell'), {1; 2});
%!test
%! r = dictionary (['ab'; 'cd'], 1);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'string', 'double'}));
%! assert_equal (numEntries (r), 2);
%! assert_equal (keys (r, 'cell'), {string('ab'); string('cd')});
%! assert_equal (values (r, 'cell'), {1; 1});
%!test
%! r = dictionary ('', 1);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'string', 'double'}));
%! assert_equal (numEntries (r), 1);
%! assert_equal (keys (r, 'cell'), {string('')});
%! assert_equal (values (r, 'cell'), {1});
%!test
%! r = dictionary (string ({'a', 'b'}), [1, 2]);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'string', 'double'}));
%! assert_equal (numEntries (r), 2);
%! assert_equal (keys (r, 'cell'), {string('a'); string('b')});
%! assert_equal (values (r, 'cell'), {1; 2});
%!test
%! r = dictionary (string ({'a', 'b'}), string ({'x', 'y'}));
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'string', 'string'}));
%! assert_equal (numEntries (r), 2);
%! assert_equal (keys (r, 'cell'), {string('a'); string('b')});
%! assert_equal (values (r, 'cell'), {string('x'); string('y')});
%!test
%! r = dictionary (string ({'a', 'b'}), 'xy');
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'string', 'string'}));
%! assert_equal (numEntries (r), 2);
%! assert_equal (keys (r, 'cell'), {string('a'); string('b')});
%! assert_equal (values (r, 'cell'), {string('xy'); string('xy')});
%!error<dictionary: KEYS and VALUES must be the same size, or VALUES a scalar.> ...
%! dictionary (string ({'a', 'b'}), ['xy'; 'zw']);
%!test
%! r = dictionary (string ('a'), '');
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'string', 'string'}));
%! assert_equal (numEntries (r), 1);
%! assert_equal (keys (r, 'cell'), {string('a')});
%! assert_equal (values (r, 'cell'), {string('')});
%!test
%! r = dictionary (string (''), 1);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'string', 'double'}));
%! assert_equal (numEntries (r), 1);
%! assert_equal (keys (r, 'cell'), {string('')});
%! assert_equal (values (r, 'cell'), {1});
%!test
%! r = dictionary (string ({'a', ''}), [1, 2]);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'string', 'double'}));
%! assert_equal (numEntries (r), 2);
%! assert_equal (keys (r, 'cell'), {string('a'); string('')});
%! assert_equal (values (r, 'cell'), {1; 2});
%!test
%! r = dictionary ([string('a'), string(missing)], [1, 2]);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'string', 'double'}));
%! assert_equal (numEntries (r), 2);
%! kc3 = keys (r, 'cell');
%! assert_equal (kc3{1}, string ('a'));
%! assert_equal (class (kc3{2}), 'string');
%! assert_equal (ismissing (kc3{2}), true);
%! assert_equal (values (r, 'cell'), {1; 2});
%!test
%! r = dictionary (string (missing), 1);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'string', 'double'}));
%! assert_equal (numEntries (r), 1);
%! kc3 = keys (r, 'cell');
%! assert_equal (class (kc3{1}), 'string');
%! assert_equal (ismissing (kc3{1}), true);
%! assert_equal (values (r, 'cell'), {1});
%!test
%! r = dictionary ([string(missing), string(missing)], [1, 2]);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'string', 'double'}));
%! assert_equal (numEntries (r), 1);
%! kc3 = keys (r, 'cell');
%! assert_equal (class (kc3{1}), 'string');
%! assert_equal (ismissing (kc3{1}), true);
%! assert_equal (values (r, 'cell'), {2});
%!test
%! r = dictionary ({'a', 'b'}, [1, 2]);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'cell', 'double'}));
%! assert_equal (numEntries (r), 2);
%! assert_equal (keys (r, 'cell'), {{'a'}; {'b'}});
%! assert_equal (values (r, 'cell'), {1; 2});
%!test
%! r = dictionary ({'a', 1}, [1, 2]);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'cell', 'double'}));
%! assert_equal (numEntries (r), 2);
%! assert_equal (keys (r, 'cell'), {{'a'}; {1}});
%! assert_equal (values (r, 'cell'), {1; 2});
%!test
%! r = dictionary ({'a', 'a'}, [1, 2]);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'cell', 'double'}));
%! assert_equal (numEntries (r), 1);
%! assert_equal (keys (r, 'cell'), {{'a'}});
%! assert_equal (values (r, 'cell'), {2});
%!test
%! r = dictionary ({[1, 2], [1, 2]}, [1, 2]);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'cell', 'double'}));
%! assert_equal (numEntries (r), 1);
%! assert_equal (keys (r, 'cell'), {{[1, 2]}});
%! assert_equal (values (r, 'cell'), {2});
%!test
%! r = dictionary ({}, []);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'cell', 'double'}));
%! assert_equal (numEntries (r), 0);
%!test
%! r = dictionary (1, {'x'});
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'cell'}));
%! assert_equal (numEntries (r), 1);
%! assert_equal (keys (r, 'cell'), {1});
%! assert_equal (values (r, 'cell'), {{'x'}});
%!test
%! r = dictionary ([1, 2], {'x', [1, 2, 3]});
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'cell'}));
%! assert_equal (numEntries (r), 2);
%! assert_equal (keys (r, 'cell'), {1; 2});
%! assert_equal (values (r, 'cell'), {{'x'}; {[1, 2, 3]}});
%!test
%! r = dictionary ([1, 2], {'x'});
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'cell'}));
%! assert_equal (numEntries (r), 2);
%! assert_equal (keys (r, 'cell'), {1; 2});
%! assert_equal (values (r, 'cell'), {{'x'}; {'x'}});
%!error<dictionary: KEYS and VALUES must be the same size, or VALUES a scalar.> ...
%! dictionary (1, {});
%!test
%! r = dictionary (1, {{}});
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'cell'}));
%! assert_equal (numEntries (r), 1);
%! assert_equal (keys (r, 'cell'), {1});
%! assert_equal (values (r, 'cell'), {{{}}});
%!test
%! r = dictionary ([1, 2], struct ('a', {1, 2}));
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'struct'}));
%! assert_equal (numEntries (r), 2);
%! assert_equal (keys (r, 'cell'), {1; 2});
%! assert_equal (values (r, 'cell'), {struct('a', 1); struct('a', 2)});
%!test
%! r = dictionary (1, struct ('a', 1));
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'struct'}));
%! assert_equal (numEntries (r), 1);
%! assert_equal (keys (r, 'cell'), {1});
%! assert_equal (values (r, 'cell'), {struct('a', 1)});
%!test
%! r = dictionary (1, struct ());
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'struct'}));
%! assert_equal (numEntries (r), 1);
%! assert_equal (keys (r, 'cell'), {1});
%! assert_equal (values (r, 'cell'), {struct()});
%!test
%! r = dictionary (struct ('a', {1, 2}), [1, 2]);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'struct', 'double'}));
%! assert_equal (numEntries (r), 2);
%! assert_equal (keys (r, 'cell'), {struct('a', 1); struct('a', 2)});
%! assert_equal (values (r, 'cell'), {1; 2});
%!test
%! r = dictionary (struct ('a', 1), 5);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'struct', 'double'}));
%! assert_equal (numEntries (r), 1);
%! assert_equal (keys (r, 'cell'), {struct('a', 1)});
%! assert_equal (values (r, 'cell'), {5});
%!test
%! r = dictionary (@sin, 1);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'function_handle', 'double'}));
%! assert_equal (numEntries (r), 1);
%! assert_equal (keys (r, 'cell'), {@sin});
%! assert_equal (values (r, 'cell'), {1});
%!test
%! r = dictionary (1, @sin);
%! [kt1, vt2] = types (r);
%! assert_equal ([kt1, vt2], string ({'double', 'function_handle'}));
%! assert_equal (numEntries (r), 1);
%! assert_equal (keys (r, 'cell'), {1});
%! assert_equal (values (r, 'cell'), {@sin});
%!test
%! r = dictionary ([1, 2], {@sin, @cos});
%! [kt1, vt2] = types (r);
