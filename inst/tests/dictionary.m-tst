## A fixed sequence of 80 edits, measured on R2024a
%!test
%! t = configureDictionary ('string', 'double');
%! t(string ('d')) = 87;
%! t(string ('h')) = 52;
%! t(string ('a')) = 52;
%! t = insert (t, string ('f'), 44);
%! t(string ('e')) = [];
%! t = insert (t, string ('f'), 7);
%! t(string ('f')) = [];
%! t(string ('h')) = [];
%! t = insert (t, string ('g'), 99, 'Overwrite', false);
%! t = remove (t, string ('d'));
%! t = insert (t, string ('g'), 42, 'Overwrite', false);
%! t = remove (t, string ('b'));
%! t = insert (t, string ('c'), 55);
%! t = insert (t, string ('e'), 75);
%! t(string ({'f', 'f'})) = [60, 61];
%! t(string ('a')) = [];
%! t(string ('c')) = [];
%! t(string ({'d', 'a'})) = [97, 98];
%! t = insert (t, string ('g'), 15, 'Overwrite', false);
%! t = insert (t, string ('e'), 81, 'Overwrite', false);
%! t(string ('d')) = 9;
%! t(string ({'c', 'c'})) = [51, 52];
%! t(string ('e')) = 93;
%! t = remove (t, string ('b'));
%! t(string ('e')) = 38;
%! t(string ({'b', 'b'})) = [53, 54];
%! t = remove (t, string ('a'));
%! t = insert (t, string ('b'), 73);
%! t = remove (t, string ('a'));
%! t(string ('b')) = 46;
%! t(string ('h')) = 46;
%! t = insert (t, string ('h'), 5, 'Overwrite', false);
%! t(string ('b')) = [];
%! t = remove (t, string ('f'));
%! t(string ({'g', 'f'})) = [23, 24];
%! t = remove (t, string ('g'));
%! t = insert (t, string ('g'), 67, 'Overwrite', false);
%! t(string ({'b', 'f'})) = [18, 19];
%! t = insert (t, string ('b'), 88);
%! t(string ('h')) = 99;
%! t = insert (t, string ('f'), 25);
%! t = remove (t, string ('e'));
%! t = remove (t, string ('e'));
%! t = insert (t, string ('f'), 91);
%! t = insert (t, string ('g'), 59, 'Overwrite', false);
%! t(string ('f')) = [];
%! t = insert (t, string ('c'), 86);
%! t = remove (t, string ('h'));
%! t(string ('g')) = [];
%! t = insert (t, string ('g'), 19);
%! t(string ({'e', 'h'})) = [80, 81];
%! t = insert (t, string ('d'), 85);
%! t = insert (t, string ('d'), 25, 'Overwrite', false);
%! t(string ('e')) = 84;
%! t = insert (t, string ('c'), 87);
%! t(string ('f')) = 53;
%! t(string ({'e', 'b'})) = [53, 54];
%! t(string ('e')) = 15;
%! t(string ({'h', 'c'})) = [70, 71];
%! t(string ('g')) = 78;
%! t(string ('b')) = 8;
%! t(string ('h')) = 29;
%! t = insert (t, string ('a'), 28);
%! t = insert (t, string ('e'), 18);
%! t(string ('a')) = 73;
%! t(string ('d')) = [];
%! t(string ('f')) = 99;
%! t(string ({'c', 'b'})) = [10, 11];
%! t = insert (t, string ('g'), 45, 'Overwrite', false);
%! t(string ({'g', 'f'})) = [10, 11];
%! t(string ({'d', 'g'})) = [63, 64];
%! t = insert (t, string ('h'), 11, 'Overwrite', false);
%! t(string ('a')) = 28;
%! t(string ('a')) = 65;
%! t(string ('f')) = 2;
%! t(string ('c')) = 75;
%! t = insert (t, string ('d'), 51, 'Overwrite', false);
%! t(string ('c')) = 90;
%! t = insert (t, string ('e'), 67);
%! t(string ({'b', 'f'})) = [58, 59];
%! assert_equal (keys (t), string ({'c'; 'b'; 'g'; 'e'; 'h'; 'f'; 'a'; 'd'}));
%!test
%! t = configureDictionary ('string', 'double');
%! t(string ('d')) = 87;
%! t(string ('h')) = 52;
%! t(string ('a')) = 52;
%! t = insert (t, string ('f'), 44);
%! t(string ('e')) = [];
