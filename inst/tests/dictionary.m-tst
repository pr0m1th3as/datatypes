%! r = keys (d, 'cell');
%! assert_equal (size (r), [1, 1]);
%! assert_equal (class (r{1}), 'categorical');
%! assert_equal (size (r{1}), [1, 1]);
%! assert_equal (cellstr (r{1}), {'x'});
%! assert_equal (categories (r{1}), {'x'});
%! assert_equal (isordinal (r{1}), false);
%!test
%! d = configureDictionary ('categorical', 'double');
%! d(string ('5')) = 1;
%! r = keys (d, 'cell');
%! assert_equal (size (r), [1, 1]);
%! assert_equal (class (r{1}), 'categorical');
%! assert_equal (size (r{1}), [1, 1]);
%! assert_equal (cellstr (r{1}), {'5'});
%! assert_equal (categories (r{1}), {'5'});
%! assert_equal (isordinal (r{1}), false);
%!test
%! d = configureDictionary ('categorical', 'double');
%! d({'x'}) = 1;
%! r = keys (d, 'cell');
%! assert_equal (size (r), [1, 1]);
%! assert_equal (class (r{1}), 'categorical');
%! assert_equal (size (r{1}), [1, 1]);
%! assert_equal (cellstr (r{1}), {'x'});
%! assert_equal (categories (r{1}), {'x'});
%! assert_equal (isordinal (r{1}), false);
%!error<dictionary.subsasgn: unable to use 'cell' as key of a dictionary of 'categorical' keys.> ...
%! d = configureDictionary ('categorical', 'double');
%! d({5}) = 1;
%!test
%! d = configureDictionary ('categorical', 'double');
%! d(categorical ({'x'})) = 1;
%! r = keys (d, 'cell');
%! assert_equal (size (r), [1, 1]);
%! assert_equal (class (r{1}), 'categorical');
%! assert_equal (size (r{1}), [1, 1]);
%! assert_equal (cellstr (r{1}), {'x'});
%! assert_equal (categories (r{1}), {'x'});
%! assert_equal (isordinal (r{1}), false);
