%! assert_equal ([m2(:), dd3(:), seconds(t4(:))], [1, 0, 0]);
%!test
%! d = configureDictionary ('double', 'table');
%! d(1) = missing;
%! r = values (d, 'cell');
%! assert_equal (size (r), [1, 1]);
%! tb1 = r{1};
%! assert_equal (size (tb1), [1, 1]);
%! assert_equal (tb1.Properties.VariableNames, {'Var1'});
%! assert_equal (class (tb1.Var1), 'missing');
%! assert_equal (size (tb1.Var1), [1, 1]);
%!test
%! d = configureDictionary ('double', 'table');
%! d(1) = struct ('a', 1);
%! r = values (d, 'cell');
%! assert_equal (size (r), [1, 1]);
%! tb1 = r{1};
%! assert_equal (size (tb1), [1, 1]);
%! assert_equal (tb1.Properties.VariableNames, {'Var1'});
%! assert_equal (tb1.Var1, struct ('a', 1));
%!test
%! d = configureDictionary ('double', 'table');
%! d(1) = table (1);
%! r = values (d, 'cell');
%! assert_equal (size (r), [1, 1]);
%! tb1 = r{1};
%! assert_equal (size (tb1), [1, 1]);
%! assert_equal (tb1.Properties.VariableNames, {'Var1'});
%! assert_equal (tb1.Var1, 1);
%!error<dictionary.subsasgn: unable to use 'function_handle' as value of a dictionary of 'table' values.> ...
%! d = configureDictionary ('double', 'table');
%! d(1) = @sin;

