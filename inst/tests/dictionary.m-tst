%! d = configureDictionary ('categorical', 'double');
%! d(datetime (2024, 1, 1)) = 1;
%! r = keys (d, 'cell');
%! assert_equal (size (r), [1, 1]);
%! assert_equal (class (r{1}), 'categorical');
%! assert_equal (size (r{1}), [1, 1]);
%! assert_equal (cellstr (r{1}), {'01-Jan-2024'});
%! assert_equal (categories (r{1}), {'01-Jan-2024'});
%! assert_equal (isordinal (r{1}), false);
%!test
%! d = configureDictionary ('categorical', 'double');
%! d(hours (1)) = 1;
%! r = keys (d, 'cell');
%! assert_equal (size (r), [1, 1]);
%! assert_equal (class (r{1}), 'categorical');
%! assert_equal (size (r{1}), [1, 1]);
%! assert_equal (cellstr (r{1}), {'1 hr'});
%! assert_equal (categories (r{1}), {'1 hr'});
%! assert_equal (isordinal (r{1}), false);

## Our categorical takes no calendarDuration, where MATLAB's makes '1mo'.
%!error<dictionary.subsasgn: unable to use 'calendarDuration' as key of a dictionary of 'categorical' keys.> ...
%! d = configureDictionary ('categorical', 'double');
%! d(calmonths (1)) = 1;
%!test
%! d = configureDictionary ('categorical', 'double');
%! d(missing) = 1;
%! r = keys (d, 'cell');
%! assert_equal (size (r), [1, 1]);
%! assert_equal (class (r{1}), 'categorical');
%! assert_equal (size (r{1}), [1, 1]);
%! assert_equal (isundefined (r{1}), true);
%! assert_equal (categories (r{1}), cell (0, 0));
%! assert_equal (isordinal (r{1}), false);
%!error<dictionary.subsasgn: unable to use 'struct' as key of a dictionary of 'categorical' keys.> ...
%! d = configureDictionary ('categorical', 'double');
%! d(struct ('a', 1)) = 1;
%!error<dictionary.subsasgn: unable to use 'table' as key of a dictionary of 'categorical' keys.> ...
%! d = configureDictionary ('categorical', 'double');
%! d(table (1)) = 1;
%!error<dictionary.subsasgn: unable to use 'function_handle' as key of a dictionary of 'categorical' keys.> ...
%! d = configureDictionary ('categorical', 'double');
%! d(@sin) = 1;

