%! d = D;
%! d = insert (d, {'d'}, 40);
%! assert_equal (values (d), [10; 20; 30; 40]);
%!test
%! d = D;
%! d({'a'}) = 99;
%! assert_equal (values (d), [99; 20; 30]);
%!test
%! d = D;
%! d = insert (d, {'a'}, 99);
%! assert_equal (values (d), [99; 20; 30]);
%!test
%! d = D;
%! d = insert (d, {'a'}, 99, 'Overwrite', false);
%! assert_equal (values (d), [10; 20; 30]);
%!test
%! d = D;
%! d = remove (d, {'a'});
%! assert_equal (keys (d, 'cell'), {{1}; {[1, 2]}});
%!test
%! d = D;
%! d({'a'}) = [];
%! assert_equal (values (d), [20; 30]);
%!test
%! d = D;
%! d = remove (d, {'a'});
%! d({'a'}) = 11;
%! assert_equal (values (d), [20; 30; 11]);
%!test
%! r = entries (D, 'struct');
%! assert_equal (size (r), [3, 1]);
%! assert_equal (fieldnames (r), {'Key'; 'Value'});
%! assert_equal (r(1).Key, {'a'});
%! assert_equal (r(1).Value, 10);
%! assert_equal (r(2).Key, {1});
%! assert_equal (r(2).Value, 20);
%! assert_equal (r(3).Key, {[1, 2]});
%! assert_equal (r(3).Value, 30);
%!assert_equal (entries (D, 'cell'), {{'a'}, 10; {1}, 20; {[1, 2]}, 30})
