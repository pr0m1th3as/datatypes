%! t(string ('f')) = [];
%! t(string ('h')) = [];
%! t = insert (t, string ('g'), 99, 'Overwrite', false);
%! t = remove (t, string ('d'));
%! t = insert (t, string ('g'), 42, 'Overwrite', false);
%! t = remove (t, string ('b'));
%! t = insert (t, string ('c'), 55);
%! t = insert (t, string ('e'), 75);
%! t(string ({'f', 'f'})) = [60, 61];
%! t(string ('a')) = [];
