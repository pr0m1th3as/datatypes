%! d = configureDictionary ('double', 'table');
%! d(1) = int8 (5);
%! r = values (d, 'cell');
%! assert_equal (size (r), [1, 1]);
%! tb1 = r{1};
%! assert_equal (size (tb1), [1, 1]);
%! assert_equal (tb1.Properties.VariableNames, {'Var1'});
