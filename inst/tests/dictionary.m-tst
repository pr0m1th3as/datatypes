%!error<dictionary.subsasgn: unable to use 'char' as value of a dictionary of 'datetime' values.> ...
%! d = configureDictionary ('double', 'datetime');
%! d(1) = '5';
%!error<dictionary.subsasgn: unable to use 'string' as value of a dictionary of 'datetime' values.> ...
%! d = configureDictionary ('double', 'datetime');
%! d(1) = string ('x');
%!error<dictionary.subsasgn: unable to use 'string' as value of a dictionary of 'datetime' values.> ...
%! d = configureDictionary ('double', 'datetime');
%! d(1) = string ('5');
%!error<dictionary.subsasgn: unable to use 'cell' as value of a dictionary of 'datetime' values.> ...
%! d = configureDictionary ('double', 'datetime');
%! d(1) = {'x'};
%!error<dictionary.subsasgn: unable to use 'cell' as value of a dictionary of 'datetime' values.> ...
%! d = configureDictionary ('double', 'datetime');
%! d(1) = {5};
%!error<dictionary.subsasgn: unable to use 'categorical' as value of a dictionary of 'datetime' values.> ...
%! d = configureDictionary ('double', 'datetime');
%! d(1) = categorical ({'x'});
%!test
%! d = configureDictionary ('double', 'datetime');
%! d(1) = datetime (2024, 1, 1);
%! r = values (d, 'cell');
%! assert_equal (size (r), [1, 1]);
%! x1 = r{1};
%! x1.Format = 'yyyy-MM-dd HH:mm:ss.SSS';
%! assert_equal (cellstr (x1), {'2024-01-01 00:00:00.000'});
%! assert_equal (x1.TimeZone, '');
%!error<dictionary.subsasgn: unable to use 'duration' as value of a dictionary of 'datetime' values.> ...
%! d = configureDictionary ('double', 'datetime');
%! d(1) = hours (1);
%!error<dictionary.subsasgn: unable to use 'calendarDuration' as value of a dictionary of 'datetime' values.> ...
%! d = configureDictionary ('double', 'datetime');
%! d(1) = calmonths (1);
%!test
%! d = configureDictionary ('double', 'datetime');
%! d(1) = missing;
%! r = values (d, 'cell');
%! assert_equal (size (r), [1, 1]);
%! x1 = r{1};
%! x1.Format = 'yyyy-MM-dd HH:mm:ss.SSS';
%! assert_equal (cellstr (x1), {'NaT'});
%! assert_equal (x1.TimeZone, '');
%!error<dictionary.subsasgn: unable to use 'struct' as value of a dictionary of 'datetime' values.> ...
%! d = configureDictionary ('double', 'datetime');
%! d(1) = struct ('a', 1);
%!error<dictionary.subsasgn: unable to use 'table' as value of a dictionary of 'datetime' values.> ...
%! d = configureDictionary ('double', 'datetime');
%! d(1) = table (1);
%!error<dictionary.subsasgn: unable to use 'function_handle' as value of a dictionary of 'datetime' values.> ...
%! d = configureDictionary ('double', 'datetime');
%! d(1) = @sin;

