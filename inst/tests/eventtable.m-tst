## Every expected value below was measured against MATLAB R2026a, which is
## where 'eventtable' exists; R2024a has no such class.

################################################################################
##                        **    Construction    **                            ##
################################################################################

## Test the empty constructor
%!test
%! ET = eventtable ();
%! assert_equal (class (ET), 'eventtable');
%! assert_equal (size (ET), [0, 0]);

## Test the empty constructor designates nothing
%!test
%! P = eventtable ().Properties;
%! assert_equal (isempty (P.EventLabelsVariable), true);
%! assert_equal (isempty (P.EventLengthsVariable), true);
%! assert_equal (isempty (P.EventEndsVariable), true);

## Test construction from a datetime vector labels the events itself
%!test
%! ET = eventtable (datetime (2024, 1, 1) + hours ([1 3])');
%! assert_equal (ET.Properties.VariableNames, {'EventLabels'});
%! assert_equal (ET.Properties.EventLabelsVariable, 'EventLabels');
%! assert_equal (cellstr (ET.EventLabels), {'Event 1'; 'Event 2'});

## Test the generated labels are numbered from one for each event table
%!test
%! ET = eventtable (datetime (2024, 1, 1) + hours ((1:4))');
%! assert_equal (cellstr (ET.EventLabels), ...
%!               {'Event 1'; 'Event 2'; 'Event 3'; 'Event 4'});

## Test construction from a duration vector
%!test
%! ET = eventtable (seconds ([1 3])');
%! assert_equal (class (ET), 'eventtable');
%! assert_equal (ET.Properties.RowTimes, seconds ([1; 3]));

## Test construction from a timetable keeps its variables
%!test
%! tv = datetime (2024, 1, 1) + hours ([1 3])';
%! TT = timetable (tv, string ({'a'; 'b'}), [10; 20], ...
%!                 'VariableNames', {'lab', 'val'});
%! ET = eventtable (TT);
%! assert_equal (class (ET), 'eventtable');
%! assert_equal (ET.Properties.VariableNames, {'lab', 'val'});
%! assert_equal (ET.Properties.RowTimes, tv);

## Test construction from a timetable guesses no labels variable
%!test
%! tv = datetime (2024, 1, 1) + hours ([1 3])';
%! TT = timetable (tv, string ({'a'; 'b'}), 'VariableNames', {'lab'});
%! P = eventtable (TT).Properties;
%! assert_equal (isempty (P.EventLabelsVariable), true);

## Test construction from a timetable carries its variable metadata
%!test
%! tv = datetime (2024, 1, 1) + hours ([1 3])';
%! TT = timetable (tv, [10; 20], 'VariableNames', {'val'});
%! TT.Properties.VariableUnits = {'kg'};
%! TT.Properties.Description = 'source';
%! ET = eventtable (TT);
%! assert_equal (ET.Properties.VariableUnits, {'kg'});
%! assert_equal (ET.Properties.Description, 'source');

## Test 'EventLabels' names the events and is added as a variable
%!test
%! ET = eventtable (datetime (2024, 1, 1) + hours ([1 3])', ...
%!                  'EventLabels', string ({'on'; 'off'}));
%! assert_equal (ET.Properties.VariableNames, {'EventLabels'});
%! assert_equal (cellstr (ET.EventLabels), {'on'; 'off'});

## Test a scalar 'EventLabels' labels every event alike
%!test
%! ET = eventtable (datetime (2024, 1, 1) + hours ([1 3])', ...
%!                  'EventLabels', "hit");
%! assert_equal (cellstr (ET.EventLabels), {'hit'; 'hit'});

## Test a character matrix labels one event per row, blanks trimmed as
## 'cellstr' trims them
%!test
%! ET = eventtable (datetime (2024, 1, 1) + hours ([1 3])', ...
%!                  'EventLabels', ['on '; 'off']);
%! assert_equal (ET.EventLabels, {'on'; 'off'});

## Test 'EventLengths' makes the events intervals
%!test
%! ET = eventtable (datetime (2024, 1, 1) + hours ([1 3])', ...
%!                  'EventLengths', hours ([2; 1]));
%! assert_equal (ET.Properties.EventLengthsVariable, 'EventLengths');
%! assert_equal (ET.EventLengths, hours ([2; 1]));

## Test 'EventLengths' takes a calendarDuration against datetime event times
%!test
%! ET = eventtable (datetime (2024, 1, 1) + hours ([1 3])', ...
%!                  'EventLengths', caldays ([1; 1]));
%! assert_equal (class (ET.EventLengths), 'calendarDuration');

## Test 'EventEnds' makes the events intervals
%!test
%! tv = datetime (2024, 1, 1) + hours ([1 3])';
%! ET = eventtable (tv, 'EventEnds', tv + hours (1));
%! assert_equal (ET.Properties.EventEndsVariable, 'EventEnds');
%! assert_equal (isempty (ET.Properties.EventLengthsVariable), true);

## Test 'EventLabelsVariable' points at a variable of the timetable
%!test
%! tv = datetime (2024, 1, 1) + hours ([1 3])';
%! TT = timetable (tv, string ({'a'; 'b'}), 'VariableNames', {'lab'});
%! ET = eventtable (TT, 'EventLabelsVariable', 'lab');
%! assert_equal (ET.Properties.EventLabelsVariable, 'lab');
%! assert_equal (ET.Properties.VariableNames, {'lab'});

## Test 'EventLengthsVariable' points at a variable of the timetable
%!test
%! tv = datetime (2024, 1, 1) + hours ([1 3])';
%! TT = timetable (tv, hours ([2; 1]), 'VariableNames', {'dur'});
%! ET = eventtable (TT, 'EventLengthsVariable', 'dur');
%! assert_equal (ET.Properties.EventLengthsVariable, 'dur');

################################################################################
##                   **    Construction: refusals    **                       ##
################################################################################

## Test a first input that is neither a timetable nor a time vector
%!error <eventtable: first input must be a timetable, or a datetime or duration vector.> ...
%! eventtable (table (1));

## Test the event times are required
%!error <eventtable: the event times or the timetable they come from must be given exactly once.> ...
%! eventtable ('EventLabels', "a");

## Test a length and an end together
%!error <eventtable: specify either the event lengths or the event ends, but not both.> ...
%! eventtable (datetime (2024, 1, 1), 'EventLengths', hours (1), ...
%!             'EventEnds', datetime (2024, 1, 2));

## Test labels given both ways
%!error <eventtable: specify either the event labels or an event labels variable, but not both.> ...
%! eventtable (timetable (datetime (2024, 1, 1), 1, 'VariableNames', {'v'}), ...
%!             'EventLabels', "a", 'EventLabelsVariable', 'v');

## Test a variable-naming option against a vector of times
%!error <eventtable: 'EventLabelsVariable' names a variable of a timetable and cannot be used with a vector of event times.> ...
%! eventtable (datetime (2024, 1, 1), 'EventLabelsVariable', 'v');

## Test labels of a type that describes when rather than what
%!error <eventtable: 'EventLabels' must not be a datetime, a duration, a calendarDuration, a table or a timetable.> ...
%! eventtable (datetime (2024, 1, 1), 'EventLabels', hours (1));

## Test a wrong number of labels
%!error <eventtable: 'EventLabels' must be a scalar or have one element per event; got 3 for 2 events.> ...
%! eventtable (datetime (2024, 1, 1) + hours ([1 3])', ...
%!             'EventLabels', string ({'a'; 'b'; 'c'}));

## Test a calendar length against duration event times
%!error <eventtable: 'EventLengths' must be a duration when the event times are durations.> ...
%! eventtable (seconds ([1 3])', 'EventLengths', calmonths ([1; 1]));

## Test a length that is neither a duration nor a calendarDuration
%!error <eventtable: 'EventLengths' must be a duration or a calendarDuration.> ...
%! eventtable (datetime (2024, 1, 1), 'EventLengths', 5);

## Test an end of a different type from the event times
%!error <eventtable: 'EventEnds' must be a datetime, the same type as the event times.> ...
%! eventtable (datetime (2024, 1, 1), 'EventEnds', hours (1));

## Test an option value colliding with a variable the input already has
%!error <eventtable: the input already has a variable named 'EventLabels'; give the values with 'EventLabelsVariable' instead.> ...
%! eventtable (timetable (datetime (2024, 1, 1), 1, ...
%!                        'VariableNames', {'EventLabels'}), ...
%!             'EventLabels', "a");

################################################################################
##                      **    The three properties    **                      ##
################################################################################

## Test a property may be pointed at another variable
%!test
%! ET = eventtable (datetime (2024, 1, 1) + hours ([1 3])');
%! ET = addvars (ET, [1; 2], 'NewVariableNames', {'val'});
%! ET.Properties.EventLabelsVariable = 'val';
%! assert_equal (ET.Properties.EventLabelsVariable, 'val');

## Test a property is cleared by assigning an empty matrix
%!test
%! ET = eventtable (datetime (2024, 1, 1) + hours ([1 3])');
%! ET.Properties.EventLabelsVariable = [];
%! assert_equal (isempty (ET.Properties.EventLabelsVariable), true);

## Test a property accepts a string scalar as a name
%!test
%! ET = eventtable (datetime (2024, 1, 1) + hours ([1 3])');
%! ET.Properties.EventLabelsVariable = "EventLabels";
%! assert_equal (ET.Properties.EventLabelsVariable, 'EventLabels');

## Test an empty character vector is not a name and does not clear
%!error <eventtable: 'EventLabelsVariable' must be the name of a variable, given as a character vector or a string scalar, or \[\] to clear it.> ...
%! ET = eventtable (datetime (2024, 1, 1));
%! ET.Properties.EventLabelsVariable = '';

## Test a name that no variable answers to
%!error <eventtable: 'EventLabelsVariable' names no variable of this event table: 'nosuch'.> ...
%! ET = eventtable (datetime (2024, 1, 1));
%! ET.Properties.EventLabelsVariable = 'nosuch';

## Test an end variable cannot be set while a length variable is
%!error <eventtable.subsasgn: 'EventEndsVariable' cannot be set while 'EventLengthsVariable' is set; clear that one first.> ...
%! ET = eventtable (datetime (2024, 1, 1), 'EventLengths', hours (1));
%! ET.Properties.EventEndsVariable = 'EventLengths';

## Test a length variable cannot be set while an end variable is
%!error <eventtable.subsasgn: 'EventLengthsVariable' cannot be set while 'EventEndsVariable' is set; clear that one first.> ...
%! ET = eventtable (datetime (2024, 1, 1), 'EventEnds', datetime (2024, 1, 2));
%! ET.Properties.EventLengthsVariable = 'EventEnds';

################################################################################
##                    **    The properties object    **                       ##
################################################################################

## Test 'Properties' returns an EventtableProperties object
%!assert (class (eventtable (datetime (2024, 1, 1)).Properties), ...
%!        'datatypes.tabular.EventtableProperties')

## Test the three event properties are listed first, ahead of 'Description'
%!test
%! names = properties (eventtable (datetime (2024, 1, 1)).Properties);
%! assert_equal (names(1:3)', {'EventLabelsVariable', ...
%!                             'EventLengthsVariable', 'EventEndsVariable'});

## Test the whole published order
%!test
%! names = properties (eventtable (datetime (2024, 1, 1)).Properties);
%! assert_equal (names', {'EventLabelsVariable', 'EventLengthsVariable', ...
%!                        'EventEndsVariable', 'Description', 'UserData', ...
%!                        'DimensionNames', 'VariableNames', ...
%!                        'VariableTypes', 'VariableDescriptions', ...
%!                        'VariableUnits', 'VariableContinuity', ...
%!                        'RowTimes', 'StartTime', 'SampleRate', ...
%!                        'TimeStep', 'CustomProperties'});

################################################################################
##                  **    An event table is a timetable    **                 ##
################################################################################

## Test the class hierarchy
%!test
%! ET = eventtable (datetime (2024, 1, 1));
%! assert_equal (isa (ET, 'timetable'), true);
%! assert_equal (isa (ET, 'tabular'), true);
%! assert_equal (isa (ET, 'table'), false);

## Test the type predicates single it out as a timetable
%!test
%! ET = eventtable (datetime (2024, 1, 1));
%! assert_equal (istimetable (ET), true);
%! assert_equal (istabular (ET), true);
%! assert_equal (istable (ET), false);

## Test a row subset is still an event table
%!test
%! ET = eventtable (datetime (2024, 1, 1) + hours ([1 3 5])');
%! assert_equal (class (ET(1:2,:)), 'eventtable');
%! assert_equal (ET(1:2,:).Properties.EventLabelsVariable, 'EventLabels');

## Test 'sortrows' returns an event table
%!test
%! ET = eventtable (datetime (2024, 1, 1) + hours ([3 1])');
%! assert_equal (class (sortrows (ET)), 'eventtable');

## Test 'head' returns an event table
%!test
%! ET = eventtable (datetime (2024, 1, 1) + hours ([1 3])');
%! assert_equal (class (head (ET, 1)), 'eventtable');

## Test 'addvars' returns an event table
%!assert (class (addvars (eventtable (datetime (2024, 1, 1)), 1)), 'eventtable')

## Test 'removevars' returns an event table
%!test
%! ET = eventtable (datetime (2024, 1, 1));
%! ET = addvars (ET, 1, 'NewVariableNames', {'val'});
%! assert_equal (class (removevars (ET, 'val')), 'eventtable');

################################################################################
##                     **    The 'Events' property    **                      ##
################################################################################

## Test an unattached timetable reports empty, of class double
%!test
%! TT = timetable (datetime (2024, 1, 1) + hours ((0:3))', (1:4)');
%! assert_equal (class (TT.Properties.Events), 'double');
%! assert_equal (isempty (TT.Properties.Events), true);

## Test an event table is attached and read back
%!test
%! t = datetime (2024, 1, 1) + hours ((0:3))';
%! TT = timetable (t, (1:4)');
%! TT.Properties.Events = eventtable (t([2 4]));
%! assert_equal (class (TT.Properties.Events), 'eventtable');
%! assert_equal (height (TT.Properties.Events), 2);

## Test a plain timetable is converted on assignment
%!test
%! t = datetime (2024, 1, 1) + hours ((0:3))';
%! TT = timetable (t, (1:4)');
%! TT.Properties.Events = timetable (t([2 4]), string ({'a'; 'b'}));
%! assert_equal (class (TT.Properties.Events), 'eventtable');

## Test the conversion guesses no labels variable
%!test
%! t = datetime (2024, 1, 1) + hours ((0:3))';
%! TT = timetable (t, (1:4)');
%! TT.Properties.Events = timetable (t([2 4]), string ({'a'; 'b'}));
%! P = TT.Properties.Events.Properties;
%! assert_equal (isempty (P.EventLabelsVariable), true);

## Test assigning an empty matrix detaches the event table
%!test
%! t = datetime (2024, 1, 1) + hours ((0:3))';
%! TT = timetable (t, (1:4)');
%! TT.Properties.Events = eventtable (t([2 4]));
%! TT.Properties.Events = [];
%! assert_equal (isempty (TT.Properties.Events), true);

## Test events lying entirely outside the row times are accepted
%!test
%! t = datetime (2024, 1, 1) + hours ((0:3))';
%! TT = timetable (t, (1:4)');
%! TT.Properties.Events = eventtable (t([2 4]) + years (5));
%! assert_equal (height (TT.Properties.Events), 2);

## Test a duration-keyed timetable takes a duration-keyed event table
%!test
%! TT = timetable (seconds ((0:3))', (1:4)');
%! TT.Properties.Events = eventtable (seconds ([1 2])');
%! assert_equal (class (TT.Properties.Events), 'eventtable');

## Test 'Events' is published between 'TimeStep' and 'CustomProperties'
%!test
%! names = properties (timetable ((1:3)', 'TimeStep', hours (1)).Properties);
%! assert_equal (names(end-1:end)', {'Events', 'CustomProperties'});

## Test a value that is neither a timetable nor empty
%!error <timetable.subsasgn: 'Events' must be an eventtable, a timetable to convert into one, or \[\] to detach the one attached.> ...
%! TT = timetable ((1:3)', 'TimeStep', hours (1));
%! TT.Properties.Events = table (1);

## Test event times of a different type from the row times
%!error <timetable.subsasgn: the attached event table's row times must be of the same type as this timetable's row times: got duration against datetime.> ...
%! TT = timetable (datetime (2024, 1, 1) + hours ((0:3))', (1:4)');
%! TT.Properties.Events = eventtable (seconds ([1 2])');

################################################################################
##          **    An event table carries no event table    **                 ##
################################################################################

## Test reading 'Events' off an event table
%!error <eventtable: 'Events' is not a property of an event table; an event table cannot carry an event table.> ...
%! eventtable (datetime (2024, 1, 1)).Properties.Events;

## Test assigning 'Events' to an event table
%!error <eventtable.subsasgn: 'Events' is not a property of an event table; an event table cannot carry an event table.> ...
%! ET = eventtable (datetime (2024, 1, 1));
%! ET.Properties.Events = eventtable (datetime (2024, 1, 1));

## Test 'Events' is not among the properties of an event table
%!assert (any (strcmp (properties ('eventtable'), 'Events')), false)

## Test 'Events' is among the properties of a timetable
%!assert (any (strcmp (properties ('timetable'), 'Events')), true)

## Test 'Events' is not published by the properties object of an event table
%!test
%! names = properties (eventtable (datetime (2024, 1, 1)).Properties);
%! assert_equal (any (strcmp (names, 'Events')), false);

################################################################################
##             **    A row-preserving operation carries it    **              ##
################################################################################

## Test a row subset carries the event table through unchanged
%!test
%! t = datetime (2024, 1, 1) + hours ((0:3))';
%! TT = timetable (t, (1:4)');
%! TT.Properties.Events = eventtable (t([2 4]));
%! assert_equal (height (TT(1:2,:).Properties.Events), 2);

## Test 'sortrows' carries the event table through unchanged
%!test
%! t = datetime (2024, 1, 1) + hours ((0:3))';
%! TT = timetable (t, (1:4)');
%! TT.Properties.Events = eventtable (t([2 4]));
%! assert_equal (height (sortrows (TT).Properties.Events), 2);

## Test 'head' carries the event table through unchanged
%!test
%! t = datetime (2024, 1, 1) + hours ((0:3))';
%! TT = timetable (t, (1:4)');
%! TT.Properties.Events = eventtable (t([2 4]));
%! assert_equal (height (head (TT, 2).Properties.Events), 2);

## Test 'addvars' carries the event table through unchanged
%!test
%! t = datetime (2024, 1, 1) + hours ((0:3))';
%! TT = timetable (t, (1:4)');
%! TT.Properties.Events = eventtable (t([2 4]));
%! TT = addvars (TT, (5:8)', 'NewVariableNames', {'z'});
%! assert_equal (height (TT.Properties.Events), 2);

## Test 'retime' carries the event table through unchanged
%!test
%! t = datetime (2024, 1, 1) + hours ((0:3))';
%! TT = timetable (t, (1:4)');
%! TT.Properties.Events = eventtable (t([2 4]));
%! assert_equal (height (retime (TT, t, 'previous').Properties.Events), 2);

## Test the table round trip drops the event table
%!test
%! t = datetime (2024, 1, 1) + hours ((0:3))';
%! TT = timetable (t, (1:4)');
%! TT.Properties.Events = eventtable (t([2 4]));
%! TT2 = table2timetable (timetable2table (TT));
%! assert_equal (isempty (TT2.Properties.Events), true);

## Test 'isequal' sees an attached event table
%!test
%! t = datetime (2024, 1, 1) + hours ((0:3))';
%! TT = timetable (t, (1:4)');
%! TTe = TT;
%! TTe.Properties.Events = eventtable (t([2 4]));
%! assert_equal (isequal (TT, TTe), false);
%! assert_equal (isequal (TTe, TTe), true);

## Test 'isequal' distinguishes two different event tables
%!test
%! t = datetime (2024, 1, 1) + hours ((0:3))';
%! A = timetable (t, (1:4)');
%! B = A;
%! A.Properties.Events = eventtable (t([2 4]));
%! B.Properties.Events = eventtable (t([1 3]));
%! assert_equal (isequal (A, B), false);

################################################################################
##            **    A binary operation merges the event tables    **          ##
################################################################################

## Test only the left operand carrying events hands them over
%!test
%! t = datetime (2024, 1, 1) + hours ((0:3))';
%! A = timetable (t, (1:4)', 'VariableNames', {'A'});
%! B = timetable (t, (5:8)', 'VariableNames', {'B'});
%! A.Properties.Events = eventtable (t([2 4]), 'EventLabels', ...
%!                                   string ({'on'; 'off'}));
%! E = [A B].Properties.Events;
%! assert_equal (height (E), 2);
%! assert_equal (cellstr (E.EventLabels), {'on'; 'off'});

## Test only the right operand carrying events hands them over
%!test
%! t = datetime (2024, 1, 1) + hours ((0:3))';
%! A = timetable (t, (1:4)', 'VariableNames', {'A'});
%! B = timetable (t, (5:8)', 'VariableNames', {'B'});
%! B.Properties.Events = eventtable (t([2 4]));
%! assert_equal (height ([A B].Properties.Events), 2);

## Test neither operand carrying events leaves the result with none
%!test
%! t = datetime (2024, 1, 1) + hours ((0:3))';
%! A = timetable (t, (1:4)', 'VariableNames', {'A'});
%! B = timetable (t, (5:8)', 'VariableNames', {'B'});
%! assert_equal (isempty ([A B].Properties.Events), true);

## Test a key on both sides collapses to one row
%!test
%! t = datetime (2024, 1, 1) + hours ((0:5))';
%! A = timetable (t, (1:6)', 'VariableNames', {'A'});
%! B = timetable (t, (7:12)', 'VariableNames', {'B'});
%! A.Properties.Events = eventtable (t([2 4]), 'EventLabels', ...
%!                                   string ({'on'; 'off'}));
%! B.Properties.Events = eventtable (t([4 6]), 'EventLabels', ...
%!                                   string ({'off'; 'down'}));
%! E = [A B].Properties.Events;
%! assert_equal (height (E), 3);
%! assert_equal (cellstr (E.EventLabels), {'on'; 'off'; 'down'});

## Test a shared event time with differing labels keeps both rows
%!test
%! t = datetime (2024, 1, 1) + hours ((0:5))';
%! A = timetable (t, (1:6)', 'VariableNames', {'A'});
%! B = timetable (t, (7:12)', 'VariableNames', {'B'});
%! A.Properties.Events = eventtable (t([2 4]), 'EventLabels', ...
%!                                   string ({'on'; 'off'}));
%! B.Properties.Events = eventtable (t([4 6]), 'EventLabels', ...
%!                                   string ({'mid'; 'down'}));
%! E = [A B].Properties.Events;
%! assert_equal (height (E), 4);
%! assert_equal (cellstr (E.EventLabels), {'on'; 'mid'; 'off'; 'down'});

## Test the merge is ordered by the keys and not by operand order
%!test
%! t = datetime (2024, 1, 1) + hours ((0:5))';
%! A = timetable (t, (1:6)', 'VariableNames', {'A'});
%! B = timetable (t, (7:12)', 'VariableNames', {'B'});
%! A.Properties.Events = eventtable (t([2 4]), 'EventLabels', ...
%!                                   string ({'on'; 'off'}));
%! B.Properties.Events = eventtable (t([4 6]), 'EventLabels', ...
%!                                   string ({'mid'; 'down'}));
%! assert_equal (isequal ([A B].Properties.Events, ...
%!                        [B A].Properties.Events), true);

## Test a variable only one side has is filled with missing on the other
%!test
%! t = datetime (2024, 1, 1) + hours ((0:5))';
%! A = timetable (t, (1:6)', 'VariableNames', {'A'});
%! B = timetable (t, (7:12)', 'VariableNames', {'B'});
%! EA = eventtable (t([2 4]), 'EventLabels', string ({'on'; 'off'}));
%! EA = addvars (EA, [10; 20], 'NewVariableNames', {'val'});
%! A.Properties.Events = EA;
%! B.Properties.Events = eventtable (t([4 6]), 'EventLabels', ...
%!                                   string ({'mid'; 'down'}));
%! E = [A B].Properties.Events;
%! assert_equal (E.Properties.VariableNames, {'EventLabels', 'val'});
%! assert_equal (E.val, [10; NaN; 20; NaN]);

## Test a key differing only in a further event variable keeps both rows
%!test
%! t = datetime (2024, 1, 1) + hours ((0:5))';
%! A = timetable (t, (1:6)', 'VariableNames', {'A'});
%! B = timetable (t, (7:12)', 'VariableNames', {'B'});
%! EA = addvars (eventtable (t([2 4]), 'EventLabels', ...
%!                           string ({'on'; 'off'})), [10; 20], ...
%!               'NewVariableNames', {'val'});
%! EB = addvars (eventtable (t([4 6]), 'EventLabels', ...
%!                           string ({'off'; 'down'})), [99; 30], ...
%!               'NewVariableNames', {'val'});
%! A.Properties.Events = EA;
%! B.Properties.Events = EB;
%! E = [A B].Properties.Events;
%! assert_equal (height (E), 4);
%! assert_equal (E.val, [10; 20; 99; 30]);

## Test 'vertcat' merges the event tables
%!test
%! t = datetime (2024, 1, 1) + hours ((0:3))';
%! t2 = datetime (2024, 1, 1) + hours ((4:7))';
%! A = timetable (t, (1:4)', 'VariableNames', {'A'});
%! C = timetable (t2, (9:12)', 'VariableNames', {'A'});
%! A.Properties.Events = eventtable (t([2 4]), 'EventLabels', ...
%!                                   string ({'on'; 'off'}));
%! C.Properties.Events = eventtable (t2([1 3]), 'EventLabels', ...
%!                                   string ({'mid'; 'down'}));
%! assert_equal (height ([A; C].Properties.Events), 4);

## Test 'synchronize' merges the event tables
%!test
%! t = datetime (2024, 1, 1) + hours ((0:3))';
%! t2 = datetime (2024, 1, 1) + hours ((4:7))';
%! A = timetable (t, (1:4)', 'VariableNames', {'A'});
%! C = timetable (t2, (9:12)', 'VariableNames', {'C'});
%! A.Properties.Events = eventtable (t([2 4]), 'EventLabels', ...
%!                                   string ({'on'; 'off'}));
%! C.Properties.Events = eventtable (t2([1 3]), 'EventLabels', ...
%!                                   string ({'mid'; 'down'}));
%! assert_equal (height (synchronize (A, C).Properties.Events), 4);

## Test 'innerjoin' merges the event tables
%!test
%! t = datetime (2024, 1, 1) + hours ((0:3))';
%! A = timetable (t, (1:4)', 'VariableNames', {'A'});
%! B = timetable (t, (5:8)', 'VariableNames', {'B'});
%! A.Properties.Events = eventtable (t([2 4]), 'EventLabels', ...
%!                                   string ({'on'; 'off'}));
%! B.Properties.Events = eventtable (t([1 3]), 'EventLabels', ...
%!                                   string ({'mid'; 'down'}));
%! assert_equal (height (innerjoin (A, B).Properties.Events), 4);

## Test 'outerjoin' merges the event tables
%!test
%! t = datetime (2024, 1, 1) + hours ((0:3))';
%! A = timetable (t, (1:4)', 'VariableNames', {'A'});
%! B = timetable (t, (5:8)', 'VariableNames', {'B'});
%! A.Properties.Events = eventtable (t([2 4]), 'EventLabels', ...
%!                                   string ({'on'; 'off'}));
%! B.Properties.Events = eventtable (t([1 3]), 'EventLabels', ...
%!                                   string ({'mid'; 'down'}));
%! assert_equal (height (outerjoin (A, B).Properties.Events), 4);

## Test two event tables carrying identical events collapse to one
%!test
%! t = datetime (2024, 1, 1) + hours ((0:3))';
%! A = timetable (t, (1:4)', 'VariableNames', {'A'});
%! B = timetable (t, (5:8)', 'VariableNames', {'B'});
%! ET = eventtable (t([2 4]), 'EventLabels', string ({'on'; 'off'}));
%! A.Properties.Events = ET;
%! B.Properties.Events = ET;
%! assert_equal (height ([A B].Properties.Events), 2);

## Test the merged event table keeps the event properties
%!test
%! t = datetime (2024, 1, 1) + hours ((0:5))';
%! A = timetable (t, (1:6)', 'VariableNames', {'A'});
%! B = timetable (t, (7:12)', 'VariableNames', {'B'});
%! A.Properties.Events = eventtable (t([2 4]), 'EventLabels', ...
%!                                   string ({'on'; 'off'}), ...
%!                                   'EventLengths', hours ([1; 1]));
%! B.Properties.Events = eventtable (t([4 6]), 'EventLabels', ...
%!                                   string ({'mid'; 'down'}), ...
%!                                   'EventLengths', hours ([1; 1]));
%! P = [A B].Properties.Events.Properties;
%! assert_equal (P.EventLabelsVariable, 'EventLabels');
%! assert_equal (P.EventLengthsVariable, 'EventLengths');

################################################################################
##                  **    The merge refuses a mismatch    **                  ##
################################################################################

## Test an interval event table against an instantaneous one
%!error <timetable.horzcat: the event tables attached to the inputs cannot be merged: their 'EventLengthsVariable' differ \('EventLengths' and unset\).> ...
%! t = datetime (2024, 1, 1) + hours ((0:3))';
%! A = timetable (t, (1:4)', 'VariableNames', {'A'});
%! B = timetable (t, (5:8)', 'VariableNames', {'B'});
%! A.Properties.Events = eventtable (t([2 4]), 'EventLengths', hours ([1; 1]));
%! B.Properties.Events = eventtable (t([1 3]));
%! horzcat (A, B);

## Test two event tables whose label variables are named differently
%!error <timetable.horzcat: the event tables attached to the inputs cannot be merged: their 'EventLabelsVariable' differ \('EventLabels' and 'Tag'\).> ...
%! t = datetime (2024, 1, 1) + hours ((0:3))';
%! A = timetable (t, (1:4)', 'VariableNames', {'A'});
%! B = timetable (t, (5:8)', 'VariableNames', {'B'});
%! A.Properties.Events = eventtable (t([2 4]));
%! ET = eventtable (t([1 3]));
%! ET = renamevars (ET, 'EventLabels', 'Tag');
%! ET.Properties.EventLabelsVariable = 'Tag';
%! B.Properties.Events = ET;
%! horzcat (A, B);

## Test a length against an end
%!error <timetable.horzcat: the event tables attached to the inputs cannot be merged: their 'EventLengthsVariable' differ \('EventLengths' and unset\).> ...
%! t = datetime (2024, 1, 1) + hours ((0:3))';
%! A = timetable (t, (1:4)', 'VariableNames', {'A'});
%! B = timetable (t, (5:8)', 'VariableNames', {'B'});
%! A.Properties.Events = eventtable (t([2 4]), 'EventLengths', hours ([1; 1]));
%! B.Properties.Events = eventtable (t([1 3]), 'EventEnds', t([2 4]));
%! horzcat (A, B);

## Test 'synchronize' refuses under its own name
%!error <timetable.synchronize: the event tables attached to the inputs cannot be merged: their 'EventLengthsVariable' differ \('EventLengths' and unset\).> ...
%! t = datetime (2024, 1, 1) + hours ((0:3))';
%! t2 = datetime (2024, 1, 1) + hours ((4:7))';
%! A = timetable (t, (1:4)', 'VariableNames', {'A'});
%! C = timetable (t2, (9:12)', 'VariableNames', {'C'});
%! A.Properties.Events = eventtable (t([2 4]), 'EventLengths', hours ([1; 1]));
%! C.Properties.Events = eventtable (t2([1 3]));
%! synchronize (A, C);

## Test 'outerjoin' refuses under its own name
%!error <timetable.outerjoin: the event tables attached to the inputs cannot be merged: their 'EventLengthsVariable' differ \('EventLengths' and unset\).> ...
%! t = datetime (2024, 1, 1) + hours ((0:3))';
%! A = timetable (t, (1:4)', 'VariableNames', {'A'});
%! B = timetable (t, (5:8)', 'VariableNames', {'B'});
%! A.Properties.Events = eventtable (t([2 4]), 'EventLengths', hours ([1; 1]));
%! B.Properties.Events = eventtable (t([1 3]));
%! outerjoin (A, B);

## Test two unset label variables agree and merge
%!test
%! t = datetime (2024, 1, 1) + hours ((0:5))';
%! A = timetable (t, (1:6)', 'VariableNames', {'A'});
%! B = timetable (t, (7:12)', 'VariableNames', {'B'});
%! EA = eventtable (t([2 4]));
%! EA.Properties.EventLabelsVariable = [];
%! EB = eventtable (t([4 6]));
%! EB.Properties.EventLabelsVariable = [];
%! A.Properties.Events = EA;
%! B.Properties.Events = EB;
%! assert_equal (height ([A B].Properties.Events), 4);

################################################################################
##            **    The result takes the more derived class    **             ##
################################################################################

## Test 'horzcat' with the event table first
%!test
%! t = datetime (2024, 1, 1) + hours ([1 3])';
%! ET = eventtable (t, 'EventLabels', string ({'on'; 'off'}));
%! TT = timetable (t, [7; 8], 'VariableNames', {'V'});
%! out = horzcat (ET, TT);
%! assert_equal (class (out), 'eventtable');
%! assert_equal (out.Properties.VariableNames, {'EventLabels', 'V'});
%! assert_equal (out.Properties.EventLabelsVariable, 'EventLabels');

## Test 'horzcat' with the plain timetable first
%!test
%! t = datetime (2024, 1, 1) + hours ([1 3])';
%! ET = eventtable (t, 'EventLabels', string ({'on'; 'off'}));
%! TT = timetable (t, [7; 8], 'VariableNames', {'V'});
%! out = horzcat (TT, ET);
%! assert_equal (class (out), 'eventtable');
%! assert_equal (out.Properties.VariableNames, {'V', 'EventLabels'});
%! assert_equal (out.Properties.EventLabelsVariable, 'EventLabels');

## Test 'vertcat' with the event table first
%!test
%! t = datetime (2024, 1, 1) + hours ([1 3])';
%! ET = eventtable (t, 'EventLabels', string ({'on'; 'off'}));
%! TT = timetable (t, string ({'p'; 'q'}), 'VariableNames', {'EventLabels'});
%! out = vertcat (ET, TT);
%! assert_equal (class (out), 'eventtable');
%! assert_equal (height (out), 4);
%! assert_equal (out.Properties.EventLabelsVariable, 'EventLabels');

## Test 'vertcat' with the plain timetable first
%!test
%! t = datetime (2024, 1, 1) + hours ([1 3])';
%! ET = eventtable (t, 'EventLabels', string ({'on'; 'off'}));
%! TT = timetable (t, string ({'p'; 'q'}), 'VariableNames', {'EventLabels'});
%! out = vertcat (TT, ET);
%! assert_equal (class (out), 'eventtable');
%! assert_equal (height (out), 4);
%! assert_equal (out.Properties.EventLabelsVariable, 'EventLabels');

## Test a promoted result drops a designation naming no variable of its own
%!test
%! t = datetime (2024, 1, 1) + hours ([1 3])';
%! ET = eventtable (t, 'EventLabels', string ({'on'; 'off'}));
%! ET = removevars (ET, 'EventLabels');
%! ET.Properties.EventLabelsVariable = [];
%! TT = timetable (t, [7; 8], 'VariableNames', {'V'});
%! out = horzcat (TT, ET);
%! assert_equal (class (out), 'eventtable');
%! assert_equal (isempty (out.Properties.EventLabelsVariable), true);

## Test two plain timetables are not promoted
%!test
%! t = datetime (2024, 1, 1) + hours ([1 3])';
%! A = timetable (t, [1; 2], 'VariableNames', {'A'});
%! B = timetable (t, [3; 4], 'VariableNames', {'B'});
%! assert_equal (class (horzcat (A, B)), 'timetable');

## Test 'cat' promotes along both dimensions
%!test
%! t = datetime (2024, 1, 1) + hours ([1 3])';
%! ET = eventtable (t, 'EventLabels', string ({'on'; 'off'}));
%! TT = timetable (t, [7; 8], 'VariableNames', {'V'});
%! TT2 = timetable (t, string ({'p'; 'q'}), 'VariableNames', {'EventLabels'});
%! assert_equal (class (cat (2, TT, ET)), 'eventtable');
%! assert_equal (class (cat (1, TT2, ET)), 'eventtable');

################################################################################
##                       **    'eventtable.empty'    **                       ##
################################################################################

## Test the no-argument form
%!test
%! ET = eventtable.empty ();
%! assert_equal (class (ET), 'eventtable');
%! assert_equal (size (ET), [0, 0]);

## Test the two-argument form
%!test
%! ET = eventtable.empty (0, 3);
%! assert_equal (class (ET), 'eventtable');
%! assert_equal (size (ET), [0, 3]);
%! assert_equal (ET.Properties.VariableNames, {'Var1', 'Var2', 'Var3'});

## Test the size-vector form
%!assert (size (eventtable.empty ([0, 2])), [0, 2])

## Test an empty event table designates nothing
%!test
%! P = eventtable.empty (0, 3).Properties;
%! assert_equal (isempty (P.EventLabelsVariable), true);
%! assert_equal (isempty (P.EventLengthsVariable), true);
%! assert_equal (isempty (P.EventEndsVariable), true);

## Test neither dimension being zero
%!error <eventtable.empty: at least one dimension must be zero.> ...
%! eventtable.empty (2, 3);

################################################################################
##          **    The designations follow the variables they name    **       ##
################################################################################

## Test removing the labels variable clears the designation
%!test
%! ET = eventtable (datetime (2024, 1, 1) + hours ([1 3])');
%! ET = addvars (ET, [10; 20], 'NewVariableNames', {'val'});
%! P = removevars (ET, 'EventLabels').Properties;
%! assert_equal (isempty (P.EventLabelsVariable), true);

## Test removing another variable leaves the designation alone
%!test
%! ET = eventtable (datetime (2024, 1, 1) + hours ([1 3])');
%! ET = addvars (ET, [10; 20], 'NewVariableNames', {'val'});
%! P = removevars (ET, 'val').Properties;
%! assert_equal (P.EventLabelsVariable, 'EventLabels');

## Test deleting the labels variable by empty assignment clears it
%!test
%! ET = eventtable (datetime (2024, 1, 1) + hours ([1 3])');
%! ET = addvars (ET, [10; 20], 'NewVariableNames', {'val'});
%! ET(:,'EventLabels') = [];
%! assert_equal (isempty (ET.Properties.EventLabelsVariable), true);

## Test removing the lengths variable clears only that designation
%!test
%! ET = eventtable (datetime (2024, 1, 1) + hours ([1 3])', ...
%!                  'EventLengths', hours ([1; 1]));
%! P = removevars (ET, 'EventLengths').Properties;
%! assert_equal (isempty (P.EventLengthsVariable), true);
%! assert_equal (P.EventLabelsVariable, 'EventLabels');

## Test moving a variable leaves the designation alone
%!test
%! ET = eventtable (datetime (2024, 1, 1) + hours ([1 3])');
%! ET = addvars (ET, [10; 20], 'NewVariableNames', {'val'});
%! P = movevars (ET, 'EventLabels', 'After', 'val').Properties;
%! assert_equal (P.EventLabelsVariable, 'EventLabels');

## Test converting a variable's type leaves the designation alone
%!test
%! ET = eventtable (datetime (2024, 1, 1) + hours ([1 3])');
%! P = convertvars (ET, 'EventLabels', 'categorical').Properties;
%! assert_equal (P.EventLabelsVariable, 'EventLabels');

## Test renaming the labels variable carries the designation with it
%!test
%! ET = eventtable (datetime (2024, 1, 1) + hours ([1 3])');
%! P = renamevars (ET, 'EventLabels', 'Tag').Properties;
%! assert_equal (P.EventLabelsVariable, 'Tag');
%! assert_equal (P.VariableNames, {'Tag'});

## Test renaming the lengths variable carries its designation with it
%!test
%! ET = eventtable (datetime (2024, 1, 1) + hours ([1 3])', ...
%!                  'EventLengths', hours ([1; 1]));
%! P = renamevars (ET, 'EventLengths', 'Dur').Properties;
%! assert_equal (P.EventLengthsVariable, 'Dur');
%! assert_equal (P.EventLabelsVariable, 'EventLabels');

## Test renaming another variable leaves the designation alone
%!test
%! ET = eventtable (datetime (2024, 1, 1) + hours ([1 3])');
%! ET = addvars (ET, [10; 20], 'NewVariableNames', {'val'});
%! P = renamevars (ET, 'val', 'other').Properties;
%! assert_equal (P.EventLabelsVariable, 'EventLabels');

## Test renaming there and back restores the designation
%!test
%! ET = eventtable (datetime (2024, 1, 1) + hours ([1 3])');
%! ET = renamevars (ET, 'EventLabels', 'Tag');
%! ET = renamevars (ET, 'Tag', 'EventLabels');
%! assert_equal (ET.Properties.EventLabelsVariable, 'EventLabels');

## Test assigning the whole variable name list carries the designation
%!test
%! ET = eventtable (datetime (2024, 1, 1) + hours ([1 3])');
%! ET = addvars (ET, [10; 20], 'NewVariableNames', {'val'});
%! ET.Properties.VariableNames = {'Tag', 'val'};
%! assert_equal (ET.Properties.EventLabelsVariable, 'Tag');

## Test assigning one indexed variable name carries the designation
%!test
%! ET = eventtable (datetime (2024, 1, 1) + hours ([1 3])');
%! ET = addvars (ET, [10; 20], 'NewVariableNames', {'val'});
%! ET.Properties.VariableNames{1} = 'Tag';
%! assert_equal (ET.Properties.EventLabelsVariable, 'Tag');

## Test a stripped event table no longer merges with a labelled one
%!error <timetable.horzcat: the event tables attached to the inputs cannot be merged: their 'EventLabelsVariable' differ \(unset and 'EventLabels'\).> ...
%! t = datetime (2024, 1, 1) + hours ((0:3))';
%! A = timetable (t, (1:4)', 'VariableNames', {'A'});
%! B = timetable (t, (5:8)', 'VariableNames', {'B'});
%! EA = addvars (eventtable (t([2 4])), [10; 20], 'NewVariableNames', {'val'});
%! A.Properties.Events = removevars (EA, 'EventLabels');
%! B.Properties.Events = addvars (eventtable (t([1 3])), [10; 20], ...
%!                                'NewVariableNames', {'val'});
%! horzcat (A, B);

## Test a renamed event table no longer merges with an unrenamed one
%!error <timetable.horzcat: the event tables attached to the inputs cannot be merged: their 'EventLabelsVariable' differ \('Tag' and 'EventLabels'\).> ...
%! t = datetime (2024, 1, 1) + hours ((0:3))';
%! A = timetable (t, (1:4)', 'VariableNames', {'A'});
%! B = timetable (t, (5:8)', 'VariableNames', {'B'});
%! A.Properties.Events = renamevars (eventtable (t([2 4])), ...
%!                                   'EventLabels', 'Tag');
%! B.Properties.Events = eventtable (t([1 3]));
%! horzcat (A, B);

## Test a plain timetable is unaffected by either hook
%!test
%! t = datetime (2024, 1, 1) + hours ([1 3])';
%! TT = timetable (t, [1; 2], [3; 4], 'VariableNames', {'a', 'b'});
%! TT = renamevars (TT, 'a', 'z');
%! TT = removevars (TT, 'b');
%! assert_equal (TT.Properties.VariableNames, {'z'});
